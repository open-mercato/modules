---
// Design gallery (dev only, WP11): every component of spec 7.6 that is not a page, rendered from test/fixtures.
// The route exists only in `astro dev` or with OM_DEV_GALLERY=1 (astro.config.ts injects it); the theme switch in
// the header toggles light and dark.
import Base from '../../layouts/Base.astro'
import AnatomyFilm from '../../components/AnatomyFilm.astro'
import Banner from '../../components/Banner.astro'
import BuiltInGrid from '../../components/BuiltInGrid.astro'
import CommandChip from '../../components/CommandChip.astro'
import CompatMatrix from '../../components/CompatMatrix.astro'
import DataStamp from '../../components/DataStamp.astro'
import EmptyState from '../../components/EmptyState.astro'
import GradientRule from '../../components/GradientRule.astro'
import Hive from '../../components/Hive.astro'
import InstallPlan from '../../components/InstallPlan.astro'
import LicenseChip from '../../components/LicenseChip.astro'
import Nameplate from '../../components/Nameplate.astro'
import PlugDiagram from '../../components/PlugDiagram.astro'
import RadarTables from '../../components/RadarTables.astro'
import Receipt from '../../components/Receipt.astro'
import Seal from '../../components/Seal.astro'
import Sigil from '../../components/Sigil.astro'
import SignalStripDetailed from '../../components/SignalStripDetailed.astro'
import TypeChip from '../../components/TypeChip.astro'
import YMarks from '../../components/YMarks.astro'
import Icon from '../../components/icons/Icon.astro'
import { ICONS } from '../../components/icons/paths.ts'
import type { IconName } from '../../components/icons/paths.ts'
import ModuleRow, { ModuleRowHead } from '../../islands/ModuleRow.tsx'
import { proseHtml, wbrHtml } from '../../lib/wrap.ts'
import SignalStrip from '../../islands/SignalStrip.tsx'
import { galleryData } from '../../lib/dev/fixtures.ts'
import { firstError, lastReceipt } from '../../lib/receipts.ts'
import { orderLines } from '../../lib/status.ts'
import { shortIntegrity, day, timeUtc } from '../../lib/format.ts'
import { glyphFromCounts, sigilPhase } from '../../../../lib/sigil/sigil.ts'
import { badgeSvg } from '../../../../lib/emit/badges.ts'
import type { SigilCounts } from '../../../../lib/sigil/sigil.ts'
import type { CellStatus, IndexEntry } from '../../../../lib/schema/index.ts'
import sigilCases from '../../../../test/design/fixtures/sigil-cases.json'

const g = galleryData()
/** Receipts, verdicts and the receipt-driven components: the fixture until the first nightly run. */
const fx = g.receiptsOf('npm:@fastwhitecat/integration-ksef-direct').length ? g : g.fixture
const real = g.source === 'real'
const byPath = (p: string, from = g): IndexEntry => (from.entries.find((e) => e.path === p) ?? from.entries[0]) as IndexEntry
const ksef = byPath('@fastwhitecat/integration-ksef-direct')
const enterprise = byPath('@open-mercato/enterprise')
const stripe = byPath('@open-mercato/gateway-stripe')
const cpq = byPath('@dainamite/cpq')
const fxKsef = byPath('@fastwhitecat/integration-ksef-direct', fx)
const fxConsents = byPath('@piotrkarwatka/marketing-consents', fx)
const fxDurableSync = byPath('@fullstackhouse/open-mercato-data-sync-durable', fx)
const lines = orderLines(g.lines)
const latest = lines.find((l) => l.source === 'latest')!
const factsOf = (e: IndexEntry) => g.factsOf(e)
const end = (fx.dataAsOf.nightly ?? '2026-10-23').slice(0, 10)
const sourceNote = real
  ? 'Numbers come from the data branch through the emitter. Receipt sections use test fixtures until the first nightly run.'
  : 'Numbers on this page are fixture data from test/fixtures, not live data.'
const peers = g.compat.peersRejectFitting
const peersSentence = `Peer ranges reject ${peers.rejected} of ${peers.fitting} combinations that fit statically.`
/** A registry slice: the eight entries of the fixture set plus a few that stress the layout (long names, providers). */
const rowPaths = [
  '@fastwhitecat/integration-ksef-direct',
  '@fullstackhouse/open-mercato-data-sync-durable',
  '@fullstackhouse/open-mercato-durable-work',
  '@open-mercato/enterprise',
  '@open-mercato/gateway-stripe',
  '@open-mercato/gateway-tpay',
  '@piotrkarwatka/marketing-consents',
  'github/chmarusso/open-mercato-enrichment-treg',
  '@dainamite/cpq-billing-connector',
  '@open-mercato/web-research-exa',
  '@freighttech/shipment-tracking',
  'mercato-readiness-scanner',
]
const rowEntries = real ? rowPaths.map((p) => g.entries.find((e) => e.path === p)).filter((e): e is IndexEntry => !!e) : g.entries
/** Anatomy hits for the demo rows: real identifiers from each entry's anatomy lists. */
const hitOf = (e: IndexEntry, i: number): string | null => {
  if (i === 0) {
    const ev = e.anatomy?.lists.eventsEmitted.find((x) => x.endsWith('.sent')) ?? e.anatomy?.lists.eventsEmitted[0]
    return ev ? `event ${ev}` : null
  }
  if (i === 8) {
    const p = e.anatomy?.lists.aclFeatures[0]
    return p ? `permission ${p}` : null
  }
  return null
}
const verifiedText = (e: IndexEntry): string =>
  e.compat.verifiedOn.length ? `Verified on ${e.compat.verifiedOn.join(', ')}` : 'No receipt yet'
/** `Built for 0.7 (peers >=0.7.0 <0.8.0)`: the site lines the peers accept, else the minor the range starts at. */
const builtForText = (e: IndexEntry): string => {
  const r = e.compat.builtFor.range
  if (!r) return 'Built for: no peer range'
  const minor = /(\d+\.\d+)\.\d+/.exec(r)?.[1]
  return `Built for ${e.compat.builtFor.lines.join(', ') || minor || r} (peers ${r})`
}
const today = (g.dataAsOf.npm ?? '2026-10-23').slice(0, 10)
const sigils = Object.fromEntries(
  g.entries.map((e) => [
    e.locator,
    { glyph: e.sigil.glyph, phase: e.sigil.phase, kind: e.kind, enterprise: e.enterprise, publicRoutes: e.sigil.publicRoutes },
  ]),
)
const errors: Record<string, string> = {}
for (const e of g.entries)
  for (const r of g.receiptsOf(e.locator)) {
    const fe = firstError(r)
    if (fe) errors[r.id] = fe
  }
/** The fixture matrix (receipt states in the 28 px cell) until real receipts exist. */
const fxSigils = Object.fromEntries(
  fx.entries.map((e) => [
    e.locator,
    { glyph: e.sigil.glyph, phase: e.sigil.phase, kind: e.kind, enterprise: e.enterprise, publicRoutes: e.sigil.publicRoutes },
  ]),
)
const fxErrors: Record<string, string> = {}
for (const e of fx.entries)
  for (const r of fx.receiptsOf(e.locator)) {
    const fe = firstError(r)
    if (fe) fxErrors[r.id] = fe
  }
/** Day 0: how many real entries print the collapsed `Queued` strip (every line untested). */
const queuedN = g.entries.filter((e) => lines.every((l) => (e.compat.lines[l.key]?.status ?? 'untested') === 'untested')).length
const statuses: CellStatus[] = ['verified', 'broken', 'quarantine', 'harness-red', 'infra-error', 'untested', 'skipped']
const ksefFacts = factsOf(ksef)
const ksefReceipt = lastReceipt(fx.receiptsOf(fxKsef.locator), '0.9')!
const consentsReceipt = lastReceipt(fx.receiptsOf(fxConsents.locator), '0.9')!
const baseline = lastReceipt(fx.baseline, '0.9')!
const rec = ksef.version.recommended[latest.key] ?? null
const builtForLines = ksef.compat.builtFor.lines
const forOutsideVerified = ksef.compat.verifiedOn.length > 0 && !ksef.compat.verifiedOn.every((l) => builtForLines.includes(l))
const nameplate = [
  { label: 'Module ID', value: ksef.moduleIds.join(', '), mono: true },
  { label: 'Package', value: ksef.npm ?? '', mono: true, copy: ksef.npm ?? undefined },
  {
    label: 'Recommended',
    value: rec ?? 'none yet',
    mono: true,
    muted: !rec,
    note: rec ? verifiedText(ksef) : `Needs a verified receipt on ${latest.key}`,
  },
  {
    label: 'Latest',
    value: `${ksef.version.latest ?? ksef.version.preview}${ksef.version.publishedAt ? ` · ${day(ksef.version.publishedAt)}` : ''}`,
    mono: true,
  },
  { label: 'Tarball', value: shortIntegrity(ksef.version.integrity), mono: true, copy: ksef.version.integrity ?? undefined },
  { label: 'Built from', value: g.builtFrom(ksef) ?? 'unknown', mono: true, muted: !g.builtFrom(ksef) },
  { label: 'License', value: ksef.license.spdx ?? 'unknown', mono: true },
  {
    label: 'Built for',
    value: ksef.compat.builtFor.range ?? 'no peer range',
    mono: true,
    mismatch: forOutsideVerified
      ? `Peers accept ${builtForLines.join(', ') || 'no listed line'}, receipts verify ${ksef.compat.verifiedOn.join(', ')}.`
      : undefined,
  },
  {
    label: 'Verified on',
    value: ksef.compat.verifiedOn.join(', ') || 'not yet',
    mono: true,
    muted: !ksef.compat.verifiedOn.length,
  },
  { label: 'Requires', value: ksef.requires.map((r) => r.raw).join(', ') || 'nothing', mono: true },
  { label: 'Replaces', value: ksef.replaces.join(', ') || 'nothing', mono: true, muted: !ksef.replaces.length },
  {
    label: 'Installable from',
    value:
      ksef.version.installableFrom && ksef.version.installableFrom > today
        ? day(ksef.version.installableFrom)
        : `now${ksef.version.installableFrom ? ` (since ${day(ksef.version.installableFrom)})` : ''}`,
    mono: true,
    muted: !ksef.version.installableFrom || ksef.version.installableFrom <= today,
  },
  ...(ksef.renamedFrom.length
    ? [{ label: 'Renamed from', value: ksef.renamedFrom.map((l) => l.replace(/^npm:/, '')).join(', '), mono: true, wide: true }]
    : []),
]
const golden = (sigilCases as { cases: { name: string; locator: string; kind: string; enterprise?: boolean; counts: SigilCounts | null }[] }).cases
const icons = Object.keys(ICONS) as IconName[]
const tokens = [
  ['--bg', '--bg-2', '--bg-3', '--ink', '--ink-2', '--ink-3', '--line', '--line-strong'],
  ['--film', '--film-2', '--film-line', '--film-ink', '--film-ink-2', '--paper', '--paper-ink', '--paper-ink-2'],
  ['--ok-fill', '--ok-ink', '--ok-text', '--wait-fill', '--wait-ink', '--id-fill', '--id-ink', '--bad-fill', '--bad-ink'],
]
const sections = [
  'Tokens',
  'Type',
  'Header and stamp',
  'Hero film and Hive',
  'Chips and seals',
  'Commands and icons',
  'Sigil',
  'Signal strip',
  'Module row',
  'Nameplate',
  'Detailed strip',
  'Anatomy film',
  'Plug diagram',
  'Install plan',
  'Banners',
  'Receipt',
  'Compatibility matrix',
  'Radar tables',
  'Built-in grid',
  'Empty states',
]
/** Tonight's run per line (spec 7.7 A.2): verdict counts of the listed entries and the baseline time. */
const runLines = lines.map((l) => {
  const n = (st: CellStatus): number => g.entries.filter((e) => e.compat.lines[l.key]?.status === st).length
  const b = l.baseline
  return {
    key: l.key,
    name: l.key === 'next' ? 'next' : l.version,
    source: l.source,
    status: (b?.status ?? 'untested') as CellStatus,
    baseline: b ? `baseline ${b.status === 'verified' ? 'pass' : b.status}${b.patches.length ? ` · ${b.patches.length} patch` : ''}` : 'baseline not run',
    counts: b ? `${n('verified')} V · ${n('broken')} X · ${n('quarantine')} Q` : '',
    at: b?.at ? `${timeUtc(b.at)}` : '',
  }
})
/** Day 0: no line has a baseline yet (spec 7.8 `The first nightly run is tonight. Anatomy and fit are already here.`). */
const firstNight = !lines.some((l) => l.baseline)
const verifiedN = g.entries.filter((e) => e.tier === 'verified').length
/** Hero counter (spec 7.7 A.2): before the first night the verified segment gives way to the time of the run. */
const heroCount = [
  `${g.hive.filter((c) => c.group !== 'core').length} modules`,
  firstNight ? null : `${verifiedN} verified on ${latest.key}`,
  `${g.hive.filter((c) => c.group === 'core').length} built-in`,
  firstNight ? 'first run tonight 02:17 UTC' : null,
].filter((x): x is string => !!x)
/** README badges: the real state of ksef, plus the verified and failing states from the receipt fixtures. */
const badges = [
  { svg: badgeSvg(ksef, g.lines), note: real ? 'ksef' : 'ksef · fixture' },
  { svg: badgeSvg(fxKsef, fx.lines), note: 'ksef · fixture receipts' },
  { svg: badgeSvg(fxConsents, fx.lines), note: 'consents · fixture receipts' },
]
const sid = (s: string): string => s.toLowerCase().replace(/[^a-z]+/g, '-')
---

<Base
  title="Design gallery · Open Mercato Modules"
  description="Every component of the catalog rendered from test fixtures, in both themes."
  path="/_dev/gallery"
  dataAsOf={g.dataAsOf}
  noindex
  skip={{ href: '#main', label: 'Skip to the gallery' }}
>
  <div class="band">
    <div class="sheet section gal-intro">
      <p class="t-tagline">// Design system · dev only</p>
      <h1 class="t-display">Instruments, not decorations.</h1>
      <p class="gal-lead">
        Every component of spec 7.6 that is not a page. Use the theme switch in the header for dark. {sourceNote}
      </p>
      <nav class="gal-toc" aria-label="Sections">
        {sections.map((s, i) => <a href={`#${sid(s)}`}><span>{String(i + 1).padStart(2, '0')}</span>{s}</a>)}
      </nav>
    </div>
  </div>

  <!-- 01 tokens -->
  <section class="band" id={sid('Tokens')}>
    <div class="sheet section">
      <p class="t-tagline">// 01 · Tokens · site/src/styles/tokens.css</p>
      <div class="swatches">
        {
          tokens.map((row) => (
            <div class="swatch-row">
              {row.map((t) => (
                <div class="swatch">
                  <span class="swatch__chip" style={`background:var(${t})`} />
                  <code>{t}</code>
                </div>
              ))}
            </div>
          ))
        }
        <div class="swatch-row">
          <div class="swatch swatch--wide"><span class="swatch__chip" style="background:var(--grad)"></span><code>--grad</code></div>
          <div class="swatch swatch--wide"><span class="swatch__chip" style="background:var(--grad-rule)"></span><code>--grad-rule</code></div>
          <div class="swatch"><span class="swatch__chip" style="background:var(--lime)"></span><code>--lime</code></div>
          <div class="swatch"><span class="swatch__chip" style="background:var(--yellow)"></span><code>--yellow</code></div>
          <div class="swatch"><span class="swatch__chip" style="background:var(--violet)"></span><code>--violet</code></div>
        </div>
      </div>
    </div>
  </section>

  <!-- 02 type -->
  <section class="band" id={sid('Type')}>
    <div class="sheet section type-specimen">
      <p class="t-tagline">// 02 · Type · Geist 400, Geist Mono</p>
      <p class="t-display">Extend everything.</p>
      <p class="t-h1">Integration KSeF Direct</p>
      <p class="t-h2">{peersSentence}</p>
      <p class="t-h3">Read statically from the published tarball.</p>
      <p class="t-body">
        Start with 80% done. Every module here is read from its published code and installed in a fresh Open Mercato app,
        night after night.
      </p>
      <p class="t-small t-muted">Small, UI: 14/1.5. Buttons use weight 500.</p>
      <p class="t-tagline">// Proof, not promises</p>
      <p class="t-data">{ksef.install.cli} · {shortIntegrity(ksef.version.integrity)}</p>
      <p class="t-label t-muted">0.8 0.9 next</p>
    </div>
  </section>

  <!-- 03 header and stamp -->
  <section class="band" id={sid('Header and stamp')}>
    <div class="sheet section">
      <p class="t-tagline">// 03 · Header, DataStamp · components/Header.astro, DataStamp.astro</p>
      <p class="gal-note">The header at the top of this page is the real component. DataStamp states:</p>
      <div class="row wrap gap-24 gal-demo">
        <DataStamp dataAsOf={g.dataAsOf} now={g.dataAsOf.nightly ?? undefined} variant="inline" />
        <DataStamp dataAsOf={{ nightly: '2026-10-20T03:12:00Z', npm: null }} now="2026-10-23T09:00:00Z" variant="inline" />
        <DataStamp dataAsOf={{ nightly: null, npm: '2026-10-23T00:17:00Z' }} variant="inline" />
      </div>
    </div>
  </section>

  <!-- 04 hero film and hive -->
  <section class="band band--film" id={sid('Hero film and Hive')}>
    <div class="sheet section hero-demo">
      <YMarks tone="film" inset={8} />
      <div class="hero-demo__left">
        <p class="t-tagline">// Open Mercato Modules</p>
        <h2 class="t-display">Extend everything.</h2>
        <p class="hero-demo__sub">
          Start with 80% done. Every module here is read from its published code and installed in a fresh Open Mercato
          app, night after night.
        </p>
        <div class="hero-demo__ask">
          <span class="hero-demo__prefix">/ search modules</span>
          <span class="hero-demo__ph">name, event or table</span>
          <Icon name="search" size={18} />
        </div>
        <ul class="hero-demo__chips" role="list" aria-label="Examples">
          {['ksef', 'shopify', 'exchange rates', 'when a deal is won'].map((q) => <li><span class="chip chip--film">{q}</span></li>)}
        </ul>
        <ul class="hero-demo__count dotlist" role="list">
          {heroCount.map((c) => <li>{c}</li>)}
        </ul>
        {
          firstNight ? (
            <div class="hero-demo__run">
              <p class="t-tagline">Tonight's run</p>
              <p class="hero-demo__first">The first nightly run is tonight. Anatomy and fit are already here.</p>
              <p class="hero-demo__queue">
                <span>{runLines.map((l) => l.name).join(' · ')}</span>
                <span class="strip-queued">Queued</span>
              </p>
              <a class="hero-demo__all" href="#compatibility-matrix">All receipts</a>
            </div>
          ) : (
            <div class="hero-demo__run">
              <p class="t-tagline">Tonight's run</p>
              {runLines.map((l) => (
                <p class="hero-demo__line">
                  <span class="hero-demo__lk">{l.name}<span class="hero-demo__ls">{l.source}</span></span>
                  <SignalStrip cells={[{ key: l.key, status: l.status, label: `${l.key} baseline`, step: null, receipt: null }]} labels={false} />
                  <span class="hero-demo__lb">{l.baseline}</span>
                  <span class="hero-demo__lc">
                    {l.counts && <span>{l.counts}</span>}
                    {l.at && <span class="hero-demo__lt">{l.at}</span>}
                  </span>
                </p>
              ))}
              <a class="hero-demo__all" href="#compatibility-matrix">All receipts</a>
            </div>
          )
        }
      </div>
      <div class="hero-demo__right">
        <Hive cells={g.hive} always />
      </div>
    </div>
  </section>
  <div class="band">
    <div class="sheet section section--tight"><GradientRule /></div>
  </div>

  <!-- 05 chips and seals -->
  <section class="band" id={sid('Chips and seals')}>
    <div class="sheet section">
      <p class="t-tagline">// 05 · TypeChip, LicenseChip, Seal</p>
      <div class="gal-grid">
        <div class="gal-cell">
          <p class="gal-cap">TypeChip</p>
          <div class="row wrap gap-8">
            <TypeChip type="official" /><TypeChip type="community" /><TypeChip type="3rd-party" /><TypeChip type="built-in" />
          </div>
        </div>
        <div class="gal-cell">
          <p class="gal-cap">LicenseChip</p>
          <div class="row wrap gap-8">
            <LicenseChip license={{ spdx: 'MIT', kind: 'osi', mismatch: false }} />
            <LicenseChip license={{ spdx: 'UNLICENSED', kind: 'proprietary', mismatch: false }} />
            <LicenseChip license={{ spdx: null, kind: 'unknown', mismatch: false }} />
            <LicenseChip license={{ spdx: 'MIT', kind: 'osi', mismatch: true }} />
            <LicenseChip license={{ spdx: null, kind: 'enterprise', mismatch: false }} />
          </div>
        </div>
        <div class="gal-cell">
          <p class="gal-cap">Seal</p>
          <div class="row wrap gap-12 gal-seals">
            <span class="gal-spec"><Seal entry={ksef} latestKey={latest.key} /><code>ksef</code></span>
            <span class="gal-spec"><Seal seal={{ kind: 'verified', line: latest.key, title: 'Verified' }} /><code>fixture</code></span>
            <span class="gal-spec"><Seal seal={{ kind: 'quality', version: '1.4.2', until: '2027-10', title: 'OM Quality' }} /><code>fixture</code></span>
            <span class="gal-spec"><Seal seal={{ kind: 'revoked', version: '1.4.2', at: '2026-11-02', title: 'Revoked' }} /><code>fixture</code></span>
          </div>
        </div>
        <div class="gal-cell">
          <p class="gal-cap">Buttons</p>
          <div class="row wrap gap-8">
            <a class="btn btn--primary" href="#chips-and-seals">Submit a module</a>
            <a class="btn btn--secondary" href="#chips-and-seals">Browse built-in</a>
            <a class="btn btn--tertiary" href="#chips-and-seals">Open in Claude Code</a>
            <a class="btn btn--green" href="#chips-and-seals">Try in Cloud</a>
          </div>
        </div>
        <div class="gal-cell gal-cell--full">
          <p class="gal-cap">README badge · lib/emit/badges.ts · /badge/&lt;path&gt;.svg</p>
          <div class="row wrap gap-16">
            {
              badges.map((b) => (
                <span class="gal-spec gal-badge">
                  <span set:html={b.svg} />
                  <code>{b.note}</code>
                </span>
              ))
            }
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 06 commands and icons -->
  <section class="band" id={sid('Commands and icons')}>
    <div class="sheet section">
      <p class="t-tagline">// 06 · CommandChip, icons (Heroicons outline, MIT)</p>
      <div class="gal-grid">
        <div class="gal-cell gal-cell--wide">
          <p class="gal-cap">CommandChip</p>
          <CommandChip command={ksef.install.cli} />
        </div>
        <div class="gal-cell gal-cell--wide band--film gal-film-cell">
          <p class="gal-cap">CommandChip on film</p>
          <CommandChip command="claude mcp add --transport http om-modules https://om-modules.workers.dev/mcp" />
        </div>
        <div class="gal-cell gal-cell--full">
          <p class="gal-cap">Icons</p>
          <div class="row wrap gap-16 gal-icons">
            {icons.map((n) => <span class="gal-icon"><Icon name={n} size={24} /><code>{n}</code></span>)}
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 07 sigil -->
  <section class="band" id={sid('Sigil')}>
    <div class="sheet section">
      <p class="t-tagline">// 07 · Sigil · lib/sigil/sigil.ts · golden cases</p>
      <div class="sigil-row">
        {
          golden.map((c) => (
            <figure class="sigil-card">
              <Sigil
                glyph={c.enterprise ? '0000000' : glyphFromCounts(c.counts!)}
                phase={sigilPhase(c.locator)}
                kind={c.kind as 'module'}
                enterprise={c.enterprise}
                counts={c.counts}
                size={96}
              />
              <figcaption>
                <span>{c.name}</span>
                <code>{c.enterprise ? 'hidden' : glyphFromCounts(c.counts!)}</code>
              </figcaption>
            </figure>
          ))
        }
      </div>

---
// /radar (spec 7.7 E, D14, D33): what the next Open Mercato snapshot changes for the modules outside the
// @open-mercato scope, from radar/next.json and surface.json. No island; copy goes through [data-copy].
import { existsSync, readFileSync } from 'node:fs'
import { join } from 'node:path'
import Base from '../layouts/Base.astro'
import RadarTables from '../components/RadarTables.astro'
import RadarText from './_radar-tables.astro'
import EmptyState from '../components/EmptyState.astro'
import Icon from '../components/icons/Icon.astro'
import { loadSiteData } from '../../../lib/emit/site-data.ts'
import { day, shortVersion } from '../lib/format.ts'
import { href } from '../lib/url.ts'
import { isPreviewData } from '../lib/freshness.ts'
import { PREVIEW_CHIP } from '../../../lib/core/source.ts'

const data = loadSiteData()
const { radar, surface, meta } = data
const mdFile = join(data.root, 'public', 'radar', 'next.md')
const markdown = existsSync(mdFile) ? readFileSync(mdFile, 'utf8') : null
const nextLine = data.modules.lines.find((l) => l.source === 'develop') ?? null
const description = radar
  ? radar.summary
  : 'What the next Open Mercato snapshot changes for the modules in the catalog, read statically from their code.'
// The summary is prose with versions in it. Its first sentence is the lead; the counts it repeats (static breaks,
// receipts on next) become a mono stat strip from the same fields, so no sentence starts with a digit on the page.
const sentences = radar ? radar.summary.split(/(?<=\.)\s+(?=\S)/) : []
const lead = sentences[0] ?? ''
const rest = sentences.slice(1).filter((x) => !/break statically\.$|^Receipts on next:/.test(x))
// One population on the page: the radar counts every module outside the scope (npm and GitHub-only); surface.json
// counts npm packages. The difference is named, never left as two denominators.
const top = radar ? ([...radar.loadBearing].sort((a, b) => b.modules - a.modules)[0] ?? null) : null
const population = top?.of ?? null
/**
 * `7 verified · 8 broken · 1 queued of 16`: every module of the population in one state, so the parts sum up (review
 * r9: `7 verified · 8 broken of 16` left the sixteenth unnamed). Zero parts other than verified and broken are left out.
 */
function tileText(): string {
  const t = meta.radarNext
  if (!radar) return ''
  if (!t) return `${radar.receiptsOnNext.verified} verified · ${radar.receiptsOnNext.broken} broken`
  const parts = [
    `${t.verified} verified`,
    `${t.broken} broken`,
    ...(t.quarantine ? [`${t.quarantine} not judged (age gate)`] : []),
    ...(t.notJudged ? [`${t.notJudged} not judged`] : []),
    ...(t.queued ? [`${t.queued} queued`] : []),
    ...(t.skipped ? [`${t.skipped} skipped`] : []),
  ]
  return `${parts.join(' · ')} of ${t.population}`
}
const stats = radar
  ? [
      { k: 'Static breaks', v: String(radar.staticBreaks.length) },
      { k: 'Same failure in several modules', v: String(radar.sameFailure.length) },
      {
        // receipts from a preview run say so here too (round 5), with the one chip (review r6); counted over the
        // modules of the lead sentence (lib/emit/radar.ts radarRows), not over the official ones too
        // the scope in the label (review r8: `7 verified · 8 broken` beside the hero's `27 verified · 10 broken` on next
        // read as a contradiction): the radar counts the modules outside @open-mercato only
        k: `Receipts on next · outside @open-mercato${isPreviewData(meta.dataAsOf) ? ` · ${PREVIEW_CHIP}` : ''}`,
        // before any receipt on next the tile says when they come, not two zeros that read like a result
        v:
          radar.receiptsOnNext.verified + radar.receiptsOnNext.broken === 0
            ? meta.firstNight
              ? 'after the first night'
              : 'queued'
            : tileText(),
      },
    ]
  : []
const changedSymbols = new Map((radar?.changedApis ?? []).map((c) => [c.symbol, c.change]))
// "@open-mercato" never breaks at its hyphen
const nwHtml = (s: string): string =>
  s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/@open-mercato/g, '<span class="nw">@open-mercato</span>')
const githubOnly = population !== null && surface ? Math.max(0, population - surface.externalPackages) : 0
const symbolName = (s: string): string => s.slice(s.lastIndexOf('#') + 1)
const symbolPkg = (s: string): string => s.slice(0, s.lastIndexOf('#'))
// an empty table is said once, in the stat strip; only Changed APIs has no number there
const noChanges = radar !== null && radar.changedApis.length === 0
// The plain summary of the first screen (review of 26 Oct: the charts covered the page): three sentences from the
// same fields as the summary and the tables below, no sentence starting with a digit.
const pop = meta.radarNext?.population ?? population
const touched = radar ? new Set(radar.changedApis.flatMap((c) => c.modules)).size : 0
const ofPop = (n: number): string => (pop !== null ? `${n} of ${pop}` : String(n))
function receiptsPlain(): string {
  if (!radar) return ''
  const v = radar.receiptsOnNext.verified
  const b = radar.receiptsOnNext.broken
  if (v + b === 0)
    return meta.firstNight
      ? 'Test installs on the next version start after the first nightly run.'
      : 'Test installs on the next version are queued.'
  const t = meta.radarNext
  const rest = t ? t.quarantine + t.notJudged + t.queued + t.skipped : 0
  const parts = [
    t ? `${t.verified} of ${t.population} worked` : `${v} worked`,
    `${t ? t.broken : b} failed`,
    ...(rest > 0 ? [`${rest} ${rest === 1 ? 'was' : 'were'} not checked`] : []),
  ]
  const said = `${parts.slice(0, -1).join(', ')} and ${parts[parts.length - 1]}`
  return `In a test install on the development build of the next version, ${said}. A failure there can come from the module or from Open Mercato.${isPreviewData(meta.dataAsOf) ? ` ${PREVIEW_CHIP}.` : ''}`
}
// one verdict first (review of 26 Oct: `community` meant two things, and nothing said whom to ask): the parts that
// change, the modules that use them by name, linked; `not by Open Mercato` is the population of the radar
const byLoc = new Map(data.modules.entries.map((e) => [e.locator, e]))
const touchedEntries = radar
  ? [...new Set(radar.changedApis.flatMap((c) => c.modules))]
      .map((l) => byLoc.get(l))
      .filter((e): e is NonNullable<typeof e> => !!e)
      .sort((a, b) => a.title.localeCompare(b.title))
  : []
// a symbol re-exported from a second path is one part, as the table below counts it
const changedCount = radar ? new Set(radar.changedApis.map((c) => symbolName(c.symbol))).size : 0
const plain: string[] = radar
  ? [
      // the verdict above names the modules; this line gives the share of the radar's population
      touched === 0
        ? 'No module from outside Open Mercato uses a part of Open Mercato that changes in the next version.'
        : `That is ${ofPop(touched)} modules from outside Open Mercato that the radar reads.`,
      radar.staticBreaks.length === 0
        ? 'No module imports something the next version removes.'
        : `The next version removes something that ${radar.staticBreaks.length} ${radar.staticBreaks.length === 1 ? 'module imports, so it' : 'modules import, so they'} will not build.`,
      receiptsPlain(),
    ]
  : []
---

<Base title="Radar · Open Mercato Modules" description={description} path="/radar" dataAsOf={meta.dataAsOf}>
  <section class="band">
    <div class="sheet section rd-head">
      <p class="t-tagline">
        // Release radar
        {
          radar ? (
            <>
              {' '}· next version <code class="nw" title={radar.next}>{shortVersion(radar.next)}</code> · computed{' '}
              {day(radar.generatedAt)}
            </>
          ) : null
        }
      </p>
      <h1 class="rd-title">What the next Open Mercato version may break.</h1>
      <p class="rd-intro">
        This page shows which modules may stop working when the next Open Mercato version comes out. It is for module
        authors and Open Mercato maintainers. Just looking for a module? <a href={href('/')}>Browse modules.</a>
      </p>
      {
        radar && (
          <p class="rd-verdict">
            {changedCount === 0 ? (
              'The next version changes no part of Open Mercato that a listed module uses.'
            ) : (
              <>
                The next version changes {changedCount} {changedCount === 1 ? 'part' : 'parts'} of Open Mercato that{' '}
                {touchedEntries.length} {touchedEntries.length === 1 ? 'module uses' : 'modules use'}. Their authors should
                check:{' '}
                {touchedEntries.map((e, i) => (
                  <>
                    {i > 0 && (i === touchedEntries.length - 1 ? ' and ' : ', ')}
                    <a href={href(`/m/${e.path}`)}>{e.title}</a>
                  </>
                ))}
                .
              </>
            )}
          </p>
        )
      }
      {
        radar ? (
          <ul class="rd-plain" role="list" aria-label="In short">
            {plain.map((x) => (
              <li set:html={nwHtml(x)} />
            ))}
          </ul>
        ) : (
          <p class="rd-plain-empty">The radar appears after the first static fit against the next snapshot.</p>
        )
      }
      {
        radar && (
          <div class="rd-actions">
            {markdown && (
              <button type="button" class="btn btn--secondary" data-copy={markdown} data-copied="Radar copied as markdown">
                <Icon name="copy" size={16} /> Copy as markdown
              </button>
            )}
            <a class="btn btn--ghost" href={href('/radar/next.md')}>
              radar/next.md
            </a>
            <a class="btn btn--ghost" href={href('/surface.json')}>
              surface.json
            </a>
          </div>
        )
      }
      {/* the computed summary, its counts, the method and the gauge, folded (review of 26 Oct) */}
      <details class="rd-how">
        <summary>How to read this</summary>
        <div class="rd-howbody">
          {
            radar && (
              <div class="rd-summary">
                <p class="rd-sent rd-sent--lead" set:html={nwHtml(lead)} />
                {rest.map((x) => <p class="rd-sent" set:html={nwHtml(x)} />)}
                <dl class="rd-stats">
                  {stats.map((x) => (
                    <div>
                      <dt>{x.k}</dt>
                      <dd class="num">{x.v}</dd>
                    </div>
                  ))}
                </dl>
              </div>
            )
          }
          <p class="rd-lede">
            Every import of every module outside the <code class="nw">@open-mercato</code> scope, checked against the
            published Open Mercato {radar?.base ?? meta.coreVersion} packages and against next
            {nextLine ? <> (<code class="nw" title={nextLine.version}>{shortVersion(nextLine.version)}</code>)</> : null}.
            Static: no module code runs here. A changed signature can still compile; {isPreviewData(meta.dataAsOf)
              ? 'the receipts on next tell. Until nightly CI starts, they come from a preview run.'
              : 'the nightly receipts on next tell.'}
          </p>
          {
            top && (
              <figure class="rd-gauge" aria-label={`${symbolName(top.symbol)} is imported by ${top.modules} of ${top.of} modules`}>
                <p class="rd-gauge__num">
                  <span class="num">{top.modules}</span>
                  <span class="rd-gauge__of">of {top.of}</span>
                </p>
                <span class="rd-gauge__bar" style={`--v:${top.of ? top.modules / top.of : 0}`} aria-hidden="true"><i /></span>
                <figcaption>
                  modules import <code>{symbolName(top.symbol)}</code>
                  <span class="rd-gauge__pkg">{symbolPkg(top.symbol)}</span>
                </figcaption>
              </figure>
            )
          }
        </div>
      </details>
    </div>
  </section>

  {
    radar ? (
      <section class="band" aria-labelledby="rd-tables">
        <div class="sheet section rd-body">
          {/* the tables' own headings are h3: a heading of this section keeps the outline h1, h2, h3 (review r4) */}
          <h2 class="sr-only" id="rd-tables">
            Radar tables
          </h2>
          {noChanges && <p class="rd-status">No API used by a listed module changed since {radar.base}.</p>}
          <div class="rd-tables">
            <RadarText changed={changedSymbols}>
              <RadarTables radar={radar} />
            </RadarText>
          </div>
        </div>
      </section>
    ) : (
      <section class="band">
        <div class="sheet section">
          <EmptyState title="No radar yet." text="It is computed by the watch run from the static fit on next." />
        </div>
      </section>
    )
  }

  {
    surface && (
      <section class="band" aria-labelledby="rd-surface">
        <div class="sheet section rd-surface">
          <p class="t-tagline">// Surface</p>
          <h2 id="rd-surface">The parts of Open Mercato that modules from outside Open Mercato import.</h2>
          <p class="rd-lede">
            <span class="num">{surface.symbols.length}</span> symbols of Open Mercato {surface.base} are imported by the{' '}
            <span class="num">{surface.externalPackages}</span> npm packages outside the <code class="nw">@open-mercato</code> scope.
            {
              githubOnly > 0 && (
                <>
                  {' '}The radar above also reads {githubOnly} {githubOnly === 1 ? 'module' : 'modules'} published only on
                  GitHub, so its counts are out of {population}.
                </>
              )
            }{' '}
            The full list per symbol is in <a href={href('/surface.json')}>surface.json</a>, for backward compatibility
            reviews of the core.
          </p>
        </div>
      </section>
    )
  }
</Base>

<style>
  .rd-verdict {
    max-width: 64ch;
    font-size: 20px;
    line-height: 1.45;
    text-wrap: pretty;
  }
  .rd-verdict a {
    color: var(--ink);
    text-decoration-color: var(--line-strong);
  }
  .rd-head {
    display: grid;
    gap: 16px;
    padding-bottom: 40px;
  }
  .rd-surface,
  .rd-body {
    display: grid;
    gap: 16px;
  }
  /* the plain three sentences under the H1 (review of 26 Oct): what the page is, for whom, and the way back */
  .rd-intro {
    max-width: 64ch;
    padding: 14px 16px;
    border: 1px solid var(--line);
    border-radius: var(--radius-m);
    background: var(--bg-2);
    font-size: 16px;
    line-height: 1.5;
    color: var(--ink-2);
  }
  .rd-intro a {
    color: var(--ink);
    font-weight: 500;
    text-underline-offset: 3px;
  }
  /* the first screen: three plain bullets before any chart or table */
  .rd-plain {
    display: grid;
    gap: 10px;
    max-width: 64ch;
    margin: 4px 0 0;
    padding: 0;
    list-style: none;
  }
  .rd-plain li {
    position: relative;
    padding-left: 22px;
    font-size: 18px;
    line-height: 1.45;
    letter-spacing: -0.01em;
    text-wrap: pretty;
  }
  .rd-plain li::before {
    content: '';
    position: absolute;
    left: 4px;
    top: 0.62em;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--ink-2);
  }
  .rd-plain-empty {
    max-width: 64ch;
    color: var(--ink-2);
  }
  .rd-how {
    max-width: 880px;
    border: 1px solid var(--line);
    border-radius: var(--radius-m);
  }
  .rd-how > summary {
    display: flex;
    align-items: center;
    gap: 8px;
    min-height: 40px;
    padding: 0 14px;
    font-size: 14px;
    font-weight: 500;
    cursor: pointer;
    list-style: none;
  }
  .rd-how > summary::-webkit-details-marker {
    display: none;
  }
  .rd-how > summary::before {
    content: '+';
    display: inline-grid;
    place-items: center;
    width: 16px;
    font-family: var(--font-mono);
    color: var(--ink-2);
  }
  .rd-how[open] > summary::before {
    content: '\2212';
  }
  .rd-howbody {
    display: grid;
    gap: 16px;
    padding: 4px 14px 16px;
  }
  .rd-body {
    padding-top: 48px;
  }
  .rd-title {
    max-width: 22ch;
    text-wrap: balance;
  }
  .rd-summary {
    display: grid;
    gap: 12px;
    max-width: 60ch;
  }
  /* the counts of the summary as a mono stat strip under the lead */
  .rd-stats {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 28px;
    margin: 0;
  }
  .rd-stats div {
    display: grid;
    gap: 2px;
  }
  .rd-stats dt {
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--ink-2);
  }
  .rd-stats dd {
    margin: 0;
    font-family: var(--font-mono);
    font-size: 15px;
  }
  .rd-sent {
    font-size: 16px;
    line-height: 1.45;
    color: var(--ink-2);
  }
  .rd-sent--lead {
    font-size: 20px;
    line-height: 1.3;
    letter-spacing: -0.02em;
    color: var(--ink);
    text-wrap: pretty;
  }
  .rd-lede {
    max-width: 72ch;
    color: var(--ink-2);
  }
  .rd-lede code {
    font-size: 0.92em;
    color: var(--ink);
  }
  .rd-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  .rd-actions .btn--ghost {
    font-family: var(--font-mono);
    font-weight: 400;
    font-size: 13px;
  }
  /* the instrument of the header: the most load-bearing symbol, out of the same population as the tables */
  .rd-gauge {
    max-width: 360px;
    display: grid;
    gap: 10px;
    margin: 0;
    padding: 20px;
    border: 1px solid var(--line);
    border-radius: var(--radius-m);
    background: var(--bg-2);
  }
  .rd-gauge__num {
    display: flex;
    align-items: baseline;
    gap: 10px;
  }
  .rd-gauge__num .num {
    font-size: 64px;
    line-height: 1;
    letter-spacing: -0.04em;
  }
  .rd-gauge__of {
    font-family: var(--font-mono);
    font-size: 16px;
    color: var(--ink-2);
  }
  .rd-gauge__bar {
    height: 4px;
    background: var(--bg-3);
    overflow: hidden;
  }
  .rd-gauge__bar i {
    display: block;
    height: 100%;
    width: calc(var(--v) * 100%);
    background: var(--ink);
  }
  .rd-gauge figcaption {
    display: grid;
    gap: 2px;
    font-size: 14px;
    color: var(--ink-2);
  }
  .rd-gauge figcaption code {
    color: var(--ink);
  }
  .rd-gauge__pkg {
    font-family: var(--font-mono);
    font-size: 11px;
    overflow-wrap: anywhere;
  }
  .rd-status {
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 0.02em;
    color: var(--ink-2);
  }
  /* RadarTables (WP11): empty tables are said once in the status line; the rest run the full width */
  .rd-tables :global(.radar) {
    grid-template-columns: minmax(0, 1fr);
  }
  .rd-tables :global(.radar__block:has(> .radar__empty)) {
    display: none;
  }
  /* two symbols of the same name in different files: the path comes first, so the rows tell them apart */
  .rd-tables :global(.radar__sym .radar__pkg) {
    order: -1;
  }
  /* a load-bearing API that changed carries the change chip next to its name */
  .rd-tables :global(.rd-chg) {
    justify-self: start;
    align-self: start;
    margin-top: 4px;
    padding: 1px 6px;
    border: 1px solid currentColor;
    border-radius: var(--radius-s);
    font-family: var(--font-mono);
    font-size: 10px;
    line-height: 16px;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--wait-ink);
  }
  .rd-tables :global(.rd-meter--changed .radar__name) {
    font-weight: 600;
  }
  .rd-tables :global(.rd-n--changed) {
    color: var(--wait-ink);
    text-transform: uppercase;
    font-size: 11px;
    letter-spacing: 0.04em;
  }
  /* the meter sits next to its symbol, not across the full width of the block */
  @media (min-width: 768px) {
    .rd-tables :global(.radar__meter) {
      grid-template-columns: minmax(0, 520px) 160px 64px;
      justify-content: start;
    }
  }
  /* "Used by": quiet mono links, underlined on hover only */
  .rd-tables :global(.radar__mods a) {
    font-family: var(--font-mono);
    text-decoration: none;
  }
  .rd-tables :global(.radar__mods a:hover) {
    text-decoration: underline;
  }
  @media (max-width: 767px) {
    .rd-head {
      padding-bottom: 32px;
    }
    .rd-body {
      padding-top: 32px;
    }
    .rd-actions .btn,
    .rd-how > summary {
      min-height: 44px;
    }
    .rd-plain li {
      font-size: 16px;
    }
  }
  @media (max-width: 479px) {
    .rd-sent--lead {
      font-size: 18px;
    }
    .rd-gauge__num .num {
      font-size: 48px;
    }
    /* phones: the table cells turn into blocks; the module list keeps its own wrapping row with gaps */
    .rd-tables :global(.radar__table td.radar__mods) {
      display: flex;
      flex-wrap: wrap;
      gap: 4px 12px;
    }
  }
</style>

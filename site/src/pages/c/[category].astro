---
// Category page (redesign of 26 Oct): the home page's module browser with this category selected, H1 = the category,
// one sentence computed from the data, and the built-in modules of the category in one quiet line, because the best
// module is often the one Open Mercato already has.
import { readFileSync } from 'node:fs'
import { parse } from 'yaml'
import Base from '../../layouts/Base.astro'
import SearchBox from '../../components/catalog/SearchBox.astro'
import ModuleBrowser from '../../components/catalog/ModuleBrowser.astro'
import HowToAdd from '../../components/catalog/HowToAdd.astro'
import {
  cardsOf,
  installExample,
  isDefaultCard,
  madeByCounts,
  needsThirdPartyFlag,
  sideCategories,
} from '../../components/catalog/cards.ts'
import { loadSiteData } from '../../../../lib/emit/site-data.ts'
import { orderLines } from '../../lib/status.ts'
import { builtInPage, categoryPage, href } from '../../lib/url.ts'
import { categoryInSentence } from './_data.ts'
import './_registry.css'

export function getStaticPaths() {
  return loadSiteData().modules.categories.map((c) => ({ params: { category: c.id } }))
}

const data = loadSiteData()
const { modules, builtIn, meta, plans } = data
const id = Astro.params.category as string
const cat = modules.categories.find((c) => c.id === id)!
const lines = orderLines(modules.lines)
const latest = lines.find((l) => l.source === 'latest') ?? lines[0] ?? null

const inCategory = modules.entries.filter((e) => e.category === id)
const opts = { categories: modules.categories, builtIn: builtIn.modules }
// the sidebar counts every category over the cards of the home page, so both pages say the same numbers
const allCards = cardsOf(modules.entries, latest, opts)
const cards = cardsOf(inCategory, latest, opts)
const n = cards.filter(isDefaultCard).length
const t = cards.filter((c) => c.tool && !c.sub && !c.extra).length
// a category of tools only (devtools) opens on its tools instead of an empty grid
const toolsOn = n === 0 && t > 0
const core = builtIn.modules.filter((m) => m.category === id).sort((a, b) => a.title.localeCompare(b.title))
const total = { modules: allCards.filter(isDefaultCard).length, all: allCards.filter((c) => !c.sub && !c.extra).length }
const example = installExample(inCategory, latest, plans) ?? installExample(modules.entries, latest, plans)

// acronyms stay (live review of 30 Oct: `1 module for crm & sales`)
const titleLower = categoryInSentence(cat.title)
const lead =
  n > 0
    ? `${n} ${n === 1 ? 'module' : 'modules'} for ${titleLower}.`
    : t > 0
      ? `${t} ${t === 1 ? 'tool or library' : 'tools and libraries'} for ${titleLower}.`
      : `No module for ${titleLower} yet.`

/** `seo` from policy/categories.yml when the curator wrote one (spec 4.4); otherwise the lead and the built-in count. */
function description(): string {
  try {
    const file = parse(readFileSync('policy/categories.yml', 'utf8')) as { categories?: { id: string; seo?: string }[] }
    const seo = file.categories?.find((c) => c.id === id)?.seo
    if (seo) return seo
  } catch {
    // fall through
  }
  return core.length
    ? `${lead} ${core.length} more ${core.length === 1 ? 'is' : 'are'} built into Open Mercato.`
    : lead
}
---

<Base
  title={`${cat.title} modules for Open Mercato`}
  description={description()}
  path={categoryPage(id)}
  dataAsOf={meta.dataAsOf}
  skip={{ href: '#registry', label: 'Skip to modules' }}
>
  <section class="band" aria-labelledby="hero-title">
    <div class="sheet section mhero mhero--cat">
      <nav class="mhero__crumbs" aria-label="Breadcrumb">
        <a href={href('/')}>Modules</a>
        <span aria-hidden="true">/</span>
        <span aria-current="page">{cat.title}</span>
      </nav>
      <h1 class="mhero__h1" id="hero-title">{cat.title}</h1>
      <p class="mhero__lead">{lead}</p>
      {
        core.length > 0 && (
          <p class="mhero__core">
            Already built into Open Mercato:{' '}
            {core.map((m, i) => (
              <>
                {i > 0 && ', '}
                <a href={href(builtInPage(m.id))}>{m.title}</a>{i === core.length - 1 && '.'}
              </>
            ))}
          </p>
        )
      }
      {cards.length > 1 && <SearchBox placeholder={`Search ${titleLower}`} />}
    </div>
  </section>

  <section class="band" id="registry" aria-label={`Modules for ${cat.title}`} tabindex="-1">
    <div class="sheet section mods-section">
      <ModuleBrowser
        cards={cards}
        categories={sideCategories(modules.categories, allCards, id)}
        total={total}
        madeBy={madeByCounts(cards)}
        current={id}
        toolsOn={toolsOn}
        toolsToggle={t > 0}
        core={builtIn.modules}
      />
    </div>
  </section>

  <HowToAdd example={example} thirdParty={needsThirdPartyFlag(modules.entries)} />
</Base>

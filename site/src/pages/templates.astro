---
// /templates (docs/specs/2026-10-29-templates.md, UI/UX): the Templates section. While `/templates.json` has no
// `active` entry it keeps the coming-soon state of Phase 0 (components/templates/ComingSoon.astro); from the first
// active entry it is the gallery. The switch is computed from data (SiteMeta.templates counts templates.json), never a
// flag. templates.openmercato.com/ leads here (functions/_middleware.ts, lib/core/templates-host.ts).
import Base from '../layouts/Base.astro'
import ComingSoon from '../components/templates/ComingSoon.astro'
import TemplateGallery from '../components/templates/TemplateGallery.astro'
import { loadSiteData } from '../../../lib/emit/site-data.ts'

const { meta } = loadSiteData()
const gallery = (meta.templates?.active ?? 0) > 0
---

<Base
  title="Templates · Open Mercato Modules"
  description={gallery
    ? 'App templates: complete Open Mercato apps in GitHub repositories to start a new app from.'
    : 'App templates: complete Open Mercato apps in GitHub repositories to start a new app from. Coming soon.'}
  path="/templates"
  dataAsOf={meta.dataAsOf}
>
  {gallery ? <TemplateGallery /> : <ComingSoon />}
</Base>

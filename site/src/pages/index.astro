---
// Home (redesign of 26 Oct, nuxt.com/modules style): a calm hero (title, one sentence, the search field and one
// computed line), the module browser (categories, Made by, sort, the modules to add, then the ones new apps already
// have) and how to add a module. Who made what is said by the chip on each card and on /quality, not in a legend. The detail (receipts per line,
// anatomy, levels) lives on the module pages, /compat, /radar, /quality, the JSON, the Markdown twins and the tools.
import Base from '../layouts/Base.astro'
import SearchBox from '../components/catalog/SearchBox.astro'
import ModuleBrowser from '../components/catalog/ModuleBrowser.astro'
import HowToAdd from '../components/catalog/HowToAdd.astro'
import {
  cardsOf,
  installExample,
  isDefaultCard,
  madeByCounts,
  needsThirdPartyFlag,
  sideCategories,
} from '../components/catalog/cards.ts'
import { loadSiteData } from '../../../lib/emit/site-data.ts'
import { orderLines } from '../lib/status.ts'
import { absoluteUrl, modulePage } from '../lib/url.ts'
import './c/_registry.css'

const data = loadSiteData()
const { meta, modules, builtIn, plans } = data
const lines = orderLines(modules.lines)
const latest = lines.find((l) => l.source === 'latest') ?? lines[0] ?? null

const cards = cardsOf(modules.entries, latest, { categories: modules.categories, builtIn: builtIn.modules })
const categories = sideCategories(modules.categories, cards)
// one count for every page for people (review of 26 Oct): the cards shown by default
const defaultCards = cards.filter(isDefaultCard)
const moduleCount = defaultCards.length
const categoryCount = categories.filter((c) => c.modules > 0).length
const total = { modules: moduleCount, all: cards.filter((c) => !c.sub && !c.extra).length }

// one real install line for step 2 of How to add a module (an official module a new app does not have yet)
const example = installExample(modules.entries, latest, plans)

// review of 26 Oct: the hero promised `one command`, the module page then listed five steps. The install command of a
// module page now runs the command, yarn generate and yarn db:migrate in one go; the restart is the other step.
const lead = 'Ready-made modules that add features to your Open Mercato app. Find one, run its install command, restart the app.'

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: 'Open Mercato Modules',
  numberOfItems: defaultCards.length,
  itemListElement: defaultCards.map((c, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    url: absoluteUrl(meta.site, modulePage(c.path)),
    name: c.title,
  })),
}
---

<Base
  title="Open Mercato Modules"
  description={lead}
  path="/"
  dataAsOf={meta.dataAsOf}
  webmcp
  jsonLd={jsonLd}
  skip={{ href: '#registry', label: 'Skip to modules' }}
>
  <section class="band" aria-labelledby="hero-title">
    <div class="sheet section mhero">
      <h1 class="mhero__h1" id="hero-title">Open Mercato Modules</h1>
      <p class="mhero__lead">{lead}</p>
      <SearchBox placeholder="Search, e.g. invoices or email" />
      <p class="mhero__meta">
        {moduleCount} modules in {categoryCount} categories. <a href="#howto">How to add a module</a>
      </p>
    </div>
  </section>

  <section class="band" id="registry" aria-label="Modules" tabindex="-1">
    <div class="sheet section mods-section">
      <ModuleBrowser
        cards={cards}
        categories={categories}
        total={total}
        madeBy={madeByCounts(cards)}
        current=""
        toolsOn={false}
        toolsToggle
        core={builtIn.modules}
      />
    </div>
  </section>

  <HowToAdd example={example} thirdParty={needsThirdPartyFlag(modules.entries)} />
</Base>

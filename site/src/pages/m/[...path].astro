                        <ul class="ent__list" role="list">
                          {entry.moduleIds.map((id) => {
                            const core = builtInById.get(id)
                            return (
                              <li class="ent__item">
                                {core ? <Sigil builtIn={core} size={24} /> : <Sigil kind="built-in" glyph="0000000" size={24} />}

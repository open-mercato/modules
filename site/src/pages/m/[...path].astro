    .replace(/^1 of (\d+) routes have no /, '1 of $1 routes has no ')
    // facts read before 25 Oct end `peer-exact-pin` with advice the publish of create-mercato-module undoes
    .replace(/\)\. Use a range\.$/, '), so an app on any other release of Open Mercato gets a Yarn peer warning.')
// lint `backend-route-collision` (round 14): computed against a new app of each line, not stored in the facts
const collideLines = new Map<string, { c: NonNullable<IndexEntry['compat']['collisions']>[string][number]; keys: string[] }>()
for (const l of lines)
  for (const c of raw.compat.collisions?.[l.key] ?? []) {

            />
            {compactStrip ? (
              <a class="ssq" href="#panel-receipts" data-receipts-open aria-label={`Receipts. ${drawerLines.map((l) => `${l.key}: ${l.sentence}`).join(' ')}${stripWarn.length ? ` ${stripWarn.join(' ')}` : ''}`}>
                <span class="ssq__cells" aria-hidden="true">
                  {drawerLines.map((l) => (
                    <span class="ssq__cell">
                      <span class="ssq__k">{l.key}</span>
                      <Square status={l.status} step={l.step ?? null} iso={l.isolation?.dot ?? null} />
                    </span>
                  ))}
                </span>
                <span class="ssq__text">
                  <span class="ssq__main">{compactSentence}</span>
                  {/* the static check before the first night (round 14): a prediction from the facts, said as one */}
                  {stripWarn.map((w) => <span class="ssq__warn" set:html={nbspDates(whyHtml(w))} />)}
                </span>
                <span class="ssq__btn">
                  Receipts <Icon name="chevron-down" size={14} class="icon ssq__chev" />
                </span>
              </a>
            ) : (
              <SignalStripDetailed
                entry={entry}
                lines={modules.lines}
                receipts={stripReceipts}
                end={today}
                href="#panel-receipts"
                sentence={{ queued: compactSentence, ageGateDays: sched.ageGateDays, installableFrom: quarantineUntil, unconfirmed, others }}
                note={previewReceipts ? PREVIEW_CHIP : null}
                noteTitle={previewReceipts ? PREVIEW_SENTENCE : null}
                why={stripWhy}
                warn={stripWarn}
                isolation={stripIso}
                versions={requiresNotes}
              />
            )}
          </div>
        )
      }
          </section>

          <section class="tech__sec" aria-labelledby="tech-install-h">
            <h2 class="tech__h" id="tech-install-h">Install per version and agent rules</h2>
            <div class="tech__ib">
            <InstallBox
              client:painted="visible"
              lines={installLines}
              initial={latest.key}
              warning={warning}
              cloudUrl="https://app.openmercatocloud.com/dashboard?create=1"
              blocked={blocked}
              hideLines={allSkipped}
              reasonLabels={REASON_LABELS}
            >
              {
                lines.map((l) =>
                  plans[l.key] ? (
                    <div data-plan-line={l.key} hidden={l.key !== latest.key}>
                      <InstallPlan
                        plan={plans[l.key]!}
                        omVersion={l.version}
                        preset={preset.has(l.key)}
                        title={(() => {
                          // the module of the page, not the first item of the order (round 14: `events@0.9.0`
                          // headed the plan of shipment-tracking, whose requires come first)
                          // a plan with nothing of this module to install (a GitHub repository with no tag) is still
                          // its plan: its name, never the `empty` that read like the empty preset (finding of 25 Oct)
                          const own = plans[l.key]!.order.find((o) => o.locator === entry.locator)
                          return own ? `${name}@${own.version}` : name
                        })()}
                      />
                    </div>
                  ) : null,
                )
              }
            </InstallBox>
            </div>
          </section>

          <section class="tech__sec" aria-labelledby="tech-plate-h">

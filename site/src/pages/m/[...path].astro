    .replace(/[&<>"']/g, (ch) => `&#${ch.charCodeAt(0)};`)
    .replace(/(?<=\()@[a-z0-9][a-z0-9-]*\/[a-z0-9][a-z0-9._-]*[a-z0-9](?=\))/g, (m) => `<span class="nw">${m}</span>`)
// lint `host-dependency-duplication` (D34): read by Fit against a new app of each line, not stored in the facts
const dupLint = dupFindings.map((f) => ({
  code: HOST_DEPENDENCY_DUPLICATION.code,
  severity: HOST_DEPENDENCY_DUPLICATION.severity,
  message: f.message,
  anchor: null,

---
// Module page (redesign of 26 Oct, in the style of nuxt.com/modules): breadcrumbs, a calm header (category icon,
// title, author, package, summary, one compatibility pill), the Install card, screenshots, when to use, the README and
// a sidebar of links, stats and details. Everything the page showed before (the per-line strip, the install box with
// the agent policy, the nameplate, Anatomy, Versions, Receipts, Quality, the agent view) is still on the page, inside
// one closed `Technical details` disclosure, with its element ids. Every value comes from the emitted data.
import { existsSync, readdirSync } from 'node:fs'
import { join } from 'node:path'
import Base from '../../layouts/Base.astro'
import Sigil from '../../components/Sigil.astro'
import Seal from '../../components/Seal.astro'
import Banner from '../../components/Banner.astro'
import Nameplate from '../../components/Nameplate.astro'
import type { NameplateRow } from '../../components/Nameplate.astro'
import SignalStripDetailed from '../../components/SignalStripDetailed.astro'
import AnatomyFilm from '../../components/AnatomyFilm.astro'
import PlugDiagram from '../../components/PlugDiagram.astro'
import InstallPlan from '../../components/InstallPlan.astro'
import Receipt from '../../components/Receipt.astro'
import CommandChip from '../../components/CommandChip.astro'
import Icon from '../../components/icons/Icon.astro'
import CategoryIcon from '../../components/module/CategoryIcon.astro'
import InstallCard from '../../components/module/InstallCard.astro'
import type { InstallStep, InstallVariant, OtherLine } from '../../components/module/InstallCard.astro'
import Screenshots from '../../components/module/Screenshots.astro'
import InstallBox from '../../islands/InstallBox.tsx'
import type { InstallLine } from '../../islands/InstallBox.tsx'
import ViewToggle from '../../islands/ViewToggle.tsx'
import ReceiptDrawer from '../../islands/ReceiptDrawer.tsx'
import type { DrawerLine } from '../../islands/ReceiptDrawer.tsx'
import { GENERATED_DIR, loadSiteData } from '../../../../lib/emit/site-data.ts'
import { enterpriseNotes, installInfo, isEnterprisePackage, peerLibrarySpecs } from '../../../../lib/core/plan.ts'
import { promptOffered, promptParts } from '../../../../lib/core/prompt.ts'
import { compareVersions } from '../../../../lib/core/semver.ts'
import { VER5_NOT_READ } from '../../../../lib/core/tier.ts'
import { README_CUT_TEXT, readmeBlocks, readmeFold, readmeWasCut, readmeWholeLines } from '../../../../lib/core/text.ts'
import type { IndexEntry, Receipt as ReceiptT } from '../../../../lib/schema/index.ts'
import { orderLines, STATUS } from '../../lib/status.ts'
import type { Others } from '../../lib/status.ts'
import {
  PREVIEW_CHIP,
  errorLine,
  explainReceipt,
  isPreview,
  appModules,
  lastReceipt,
  routesOf,
  transitionRows,
  whyHtml,
} from '../../lib/receipts.ts'
import {
  PREVIEW_ONLY_TEXT,
  REASON_LABELS,
  brokenText,
  builtForText as coreBuiltForText,
  emptyPresetOn,
  isolationLineText,
  isolationText,
  lineVersion,
  notJudgedText,
  heldBack,
  notTestedText,
  emptyPresetVersion,
  emptyCommandCaution,
  installVersion,
  otherVersionCells,
  otherVersionText,
  pinnedText,
  presetInstallText,
  presetText,
  untestedText,
  withJudgedLines,
  claimLabel,
  collisionNote,
  collisionStatic,
  EMPTY_PRESET_LEAD,
} from '../../../../lib/core/policy.ts'
import { isolationReceipts, mainReceipts } from '../../../../lib/core/lines.ts'
import {
  BACKEND_ROUTE_COLLISION,
  HOST_DEPENDENCY_DUPLICATION,
  collisionFix,
  collisionLintText,
  duplicateTypeError,
  hostDuplicateFix,
} from '../../../../lib/core/finding.ts'
import { isolationDot } from '../../lib/status.ts'
import { PREVIEW_QUEUED, PREVIEW_SENTENCE } from '../../../../lib/core/source.ts'
import { isPreviewData } from '../../lib/freshness.ts'
import { day, dayYear, duration, nbspDates, plural, shortIntegrity, shortVersion, timeUtc } from '../../lib/format.ts'
import { absoluteUrl, builtInPage, categoryPage, href, modulePage, moduleMd, receiptPage } from '../../lib/url.ts'
import { wbrHtml } from '../../lib/wrap.ts'
import { transitionNames } from '../../lib/vt.ts'
import { CATALOG_REPO_URL } from '../../../../lib/core/home.ts'
import {
  installWords,
  manualStepText,
  planInstallLine,
  readmeInstallFine,
} from '../../components/catalog/cards.ts'
import { iconSvg } from '../../components/icons/paths.ts'
import { levelNote, licenseChip, rulesHeading, verifiedTestNote } from '../../lib/chips.ts'
import { cannotInstall, catalogSkip, madeByHint, popularity, providerParents, uniqueReceipts, withSkipped } from '../c/_data.ts'
import { headerResults, listAnd, noRecommendedNote } from '../../lib/status.ts'
import { queuedCellSentence, queuedCellsSentence, queuedSentence, schedule } from '../../lib/schedule.ts'
import { Square } from '../../lib/ui.tsx'
import './_module.css'

export function getStaticPaths() {
  return loadSiteData().modules.entries.map((e) => ({ params: { path: e.path } }))
}

const path = Astro.params.path as string
const data = loadSiteData()
const { modules, meta } = data
const lines = orderLines(modules.lines)
// entries the nightly run never installs (enterprise, provider, library, tool) carry `skipped` on every line (5.3)
const raw = withSkipped(modules.entries.find((e) => e.path === path) as IndexEntry, lines)
// every line reads as a verdict on the version a fresh app installs there (review r6, spec 6.5): a receipt of another
// version leaves the line's cells and squares, and comes back only as the one sentence that names both versions
const others: Others = otherVersionCells(raw)
const entry = withJudgedLines(raw)
// lines whose new app (the classic preset) already registers the package: nothing to install there; the line keeps its
// verdict, the receipt of the version a new app ships (decision of 24 Oct)
const preset = new Set(raw.compat.inPresets ?? [])
const otherText = (k: string): string | null => {
  const o = others[k]
  return o ? otherVersionText(k, o.installs, o.other) : null
}
const detail = data.detail(path)
const facts = detail?.facts ?? null
const latest = lines.find((l) => l.source === 'latest') ?? lines[0]!
// one record per receipt id: a retry confirms the first record under the same id (last one wins)
// the main verdict reads receipts of a new app (classic) only; those of an app from the empty preset are the signal `in
// isolation` (`compat.isolation`), shown beside it and never as the line's state (decision of 24 Oct)
const allReceipts: ReceiptT[] = uniqueReceipts(data.receipts.filter((r) => r.module?.locator === entry.locator))
const receipts: ReceiptT[] = mainReceipts(allReceipts)
const isoReceipts: ReceiptT[] = isolationReceipts(allReceipts)
const plans = data.plans[entry.locator] ?? {}
const catTitle = (id: string): string => modules.categories.find((c) => c.id === id)?.title ?? id
const byLocator = new Map(modules.entries.map((e) => [e.locator, e]))
const builtInById = new Map(data.builtIn.modules.map((b) => [b.id, b]))
// the strip's axis ends on the day of the data, never the build day (review r12: `24 OCT` under `DATA 23 OCT`)
const today = (meta.dataAsOf.nightly ?? meta.dataAsOf.npm ?? meta.generatedAt).slice(0, 10)
const name = entry.npm ?? entry.github ?? entry.locator
const vt = transitionNames(entry.locator)
const reason = (code: string): string | null =>
  Object.values(entry.agentPolicy)
    .flatMap((p) => p.reasons)
    .find((r) => r.code === code)?.text ?? null

// ---------- state ----------
const held = entry.status === 'hold' || entry.status === 'delisted'
const notListed = !entry.listed && !held
const github = entry.identity.source === 'github'
const preview = entry.version.latest === null && entry.version.preview !== null
const baselineLatest = latest.baseline
const harnessRed = baselineLatest?.status === 'harness-red'
const quarantineUntil =
  entry.version.installableFrom && entry.version.installableFrom > today ? entry.version.installableFrom : null
const skipText = catalogSkip(entry)
const noInstall = cannotInstall(entry)
const holdText = `${reason('HOLD') ?? `On hold: ${entry.status}.`} Do not install.`
const sched = schedule()
const notListedText = reason('NOT_INSTALLABLE')
  ? 'The package has no src/modules and dist/modules pair, so it cannot be installed.'
  : reason('UNPINNED_GIT')
    ? 'The GitHub source has no pinned tag, so it cannot be installed.'
    : 'The listing checks did not pass.'
const blocked = held ? holdText : notListed ? notListedText : null

// ---------- header facts ----------
// one line, results first (review r1): what the receipts say, then the declaration, then the static fit of the lines
// without a receipt (drift counts as a fit here, D14: the radar names the drift), then the lines still queued
// one sentence for the page, the agent card and check_compat (lib/core/policy.ts builtForText, review r9)
const builtForText = (): string => coreBuiltForText(entry)
// "Verified on" promises a test only where the nightly run will install the entry (5.3)
const notTested = skipText
  ? skipText.replace(/\.$/, '').replace(': ', ' (') + ').'
  : noInstall
    ? 'Not installable by the catalog.'
    : null
const stripOrder = lines // previous, latest, next (orderLines)
const noReceipt = (k: string): boolean => (entry.compat.lines[k]?.status ?? 'untested') === 'untested' && !others[k]
const fitOf = (k: string) => entry.signals.fit[k] ?? 'unknown'
const fits = (k: string): boolean => fitOf(k) === 'ok' || fitOf(k) === 'drift'
const fitOk = stripOrder.filter((l) => noReceipt(l.key) && fits(l.key)).map((l) => l.key)
const fitNo = stripOrder.filter((l) => noReceipt(l.key) && fitOf(l.key) === 'no-fit').map((l) => l.key)
const queuedLines = stripOrder.filter((l) => noReceipt(l.key)).map((l) => l.key)
const anyReceipt = stripOrder.some((l) => !noReceipt(l.key) && entry.compat.lines[l.key]?.status !== 'skipped')
const showFit = !notTested && (fitOk.length > 0 || fitNo.length > 0)
const fitParts: string[] = showFit
  ? [
      ...(fitOk.length ? [`Fits statically on ${listAnd(fitOk)}`] : []),
      ...(fitNo.length ? [`Does not fit statically on ${listAnd(fitNo)}`] : []),
    ]
  : []
/** 6.8 `Fits statically` tooltip per line, or the plain no-fit sentence; null without a static result. */
const fitSentence = (l: (typeof lines)[number]): string | null => {
  const v = l.key === 'next' ? shortVersion(l.version) : l.version
  if (notTested || !noReceipt(l.key)) return null
  // a line whose new app already registers the package (round 14: `Not installed yet` under `already registers`)
  if (fits(l.key))
    return `Every import resolves against the published ${v} packages. ${preset.has(l.key) ? 'Not tested by the catalog yet.' : 'Not installed yet.'}`
  if (fitOf(l.key) === 'no-fit') return `Does not fit statically: an import is missing from the published ${v} packages.`
  return null
}
// one phrase per state, the lines of each state together (review r4: a module broken on three lines said it three
// times here and three times under the strip); steps and dates are in the sentence under the strip
const resultParts = headerResults(entry, stripOrder, others)
// a backend route a new app already has, on the lines without a verdict (round 15: `Fits statically on 0.8, 0.9 and
// next` stood alone over `Static check: ... collides`; the fit reads imports, the collision routes)
const collideKeys = stripOrder.filter((l) => !!collisionStatic(raw, l.key)).map((l) => l.key)
const headerParts: string[] = [
  ...resultParts,
  builtForText(),
  ...(notTested ? [notTested.replace(/\.$/, '')] : fitParts),
  ...(!notTested && collideKeys.length ? [`Route collision on ${listAnd(collideKeys)}`] : []),
  ...(!notTested && anyReceipt && queuedLines.length ? [`Queued on ${listAnd(queuedLines)}`] : []),
]
const builtForLines = entry.compat.builtFor.lines
// peers that cover none of the verified lines disagree with the receipts too (`>=0.7.0 <0.8.0`, verified on 0.9)
const declaredMismatch =
  entry.compat.verifiedOn.length > 0 &&
  !!entry.compat.builtFor.range &&
  entry.compat.builtFor.kind !== 'star' &&
  entry.compat.verifiedOn.some((l) => !builtForLines.includes(l))

// ---------- nameplate (7.7 B.3) ----------
/** A zero-width space after each dot: a long version (`0.0.0-canary.20260603190311.74d2590`) wraps at its dots. */
const softDots = (v: string): string => (v.length > 18 ? v.replace(/\.(?=.)/g, '.\u200B') : v)
const recommendedLatest = entry.version.recommended[latest.key] ?? null
const builtFrom =
  entry.identity.builtFrom === 'verified'
    ? `${entry.github ?? entry.links.repo?.replace('https://github.com/', '') ?? 'Public CI build'}${entry.version.gitRef ? ` @ ${entry.version.gitRef.slice(0, 7)}` : ''}`
    : entry.identity.builtFrom === 'lost'
      ? 'Provenance lost on this release'
      : 'No provenance'
const lic = licenseChip(entry.license)
const licenseValue =
  entry.license.kind === 'proprietary' && entry.license.spdx
    ? `${lic.label} (${entry.license.spdx})`
    : lic.label
// compact plate (review r1): one row of the facts people compare, empty values left out; the rest under All facts
const latestValue = entry.version.latest
  ? `${entry.version.latest}${entry.version.publishedAt ? ` · ${day(entry.version.publishedAt)}` : ''}`
  : entry.version.preview
    ? `${softDots(entry.version.preview)} (preview)`
    : github && entry.version.gitRef
      ? softDots(entry.version.gitRef)
      : null
const rows: NameplateRow[] = [
  entry.npm
    ? { label: 'Package', value: entry.npm, mono: true, copy: entry.npm }
    : { label: 'Repository', value: entry.github ?? '', mono: true, copy: entry.github ?? undefined },
  ...(latestValue
    ? [
        {
          label: 'Latest',
          value: latestValue,
          mono: true,
          note:
            quarantineUntil && entry.version.latest
              ? `Installable from ${day(quarantineUntil)}${entry.compat.lines[latest.key]?.precheck === 'pass' ? ', pre-check passed' : ''}`
              : undefined,
        },
      ]
    : []),
  {
    // the same label as the chip (lib/chips.ts), with the SPDX id when the chip does not show it
    label: 'License',
    value: licenseValue,
    mono: entry.license.kind === 'osi',
    muted: entry.license.kind === 'unknown',
    mismatch: entry.license.mismatch ? 'License sources disagree (package.json, LICENSE, module info).' : undefined,
  },
  ...(entry.compat.builtFor.range
    ? [
        {
          label: 'Built for',
          value: entry.compat.builtFor.range,
          mono: true,
          title: "From the module's peer dependencies. A declaration, not a test.",
          mismatch: declaredMismatch
            ? `Peers and receipts disagree: peers ${entry.compat.builtFor.range}, verified on ${listAnd(entry.compat.verifiedOn)}.`
            : undefined,
        },
      ]
    : []),
  ...(entry.requires.length && !noInstall
    ? [{ label: 'Requires', value: entry.requires.map((r) => r.raw).join(', '), mono: true }]
    : []),
]
// ---------- receipts ----------
// the receipt behind each line's cell (review r7): the last receipt of the version a fresh app installs there, not a
// newer receipt of another version (webhooks 0.9.0 broke on 0.8 after 0.8.0 was verified there)
const byId = new Map(receipts.map((r) => [r.id, r]))
const lastByLine = Object.fromEntries(
  lines.map((l) => {
    const id = entry.compat.lines[l.key]?.receipt
    return [l.key, (id ? byId.get(id) : undefined) ?? lastReceipt(receipts, l.key)]
  }),
)
// the signal `in isolation` per line: the receipt behind `compat.isolation[line]` and its one sentence
const isoById = new Map(isoReceipts.map((r) => [r.id, r]))
const isoOf = (k: string) => raw.compat.isolation?.[k] ?? null
const isoSentence = (k: string): string | null => {
  const c = isoOf(k)
  return c ? isolationText(c, lineVersion(raw, k)) : null
}
// beside a verdict, only when it says something else than the verdict (lib/core/policy.ts isolationLineText)
const isoBeside = (k: string): string | null => (entry.compat.lines[k] || others[k] ? isolationLineText(raw, k) : null)
// a newer break of another version on a line whose install version has its own verdict: said once, as the reason
// the line's command pins that version, with the receipt one click away; the emitter's `compat.newerBreaks`, the same
// condition `check_compat` and the card read (lib/core/lines.ts newerBreak, review r8)
const pinned: Record<string, { text: string; receipt: ReceiptT }> = {}
for (const l of lines) {
  const c = entry.compat.lines[l.key]
  const nb = raw.compat.newerBreaks?.[l.key]
  const last = nb ? byId.get(nb.receipt) : undefined
  if (!c?.moduleVersion || !nb || !last || others[l.key]) continue
  pinned[l.key] = { text: pinnedText(l.key, c.moduleVersion, nb), receipt: last }
}
const routes = routesOf(facts)
// a break with one red night only: the same words as the agent policy and VER-1, `since` only once a second night
// confirmed it (review r4)
const unconfirmed: Record<string, string> = {}
for (const l of lines) {
  const c = entry.compat.lines[l.key]
  if (c?.status !== 'broken') continue
  const streak = receipts.filter(
    (r) =>
      r.om.line === l.key &&
      r.result.status === 'broken' &&
      (c.moduleVersion === null || r.module?.version === c.moduleVersion),
  )
  if (streak.length > 0 && !streak.some((r) => r.transition.confirmed))
    unconfirmed[l.key] = (lastByLine[l.key]?.run.at ?? c.at ?? today).slice(0, 10)
}
// receipts of the local preview runner say so wherever a receipt is shown (round 5), with the one chip (review r6)
const previewReceipts = allReceipts.some(isPreview)
const previewData = isPreviewData(meta.dataAsOf)
// why a line broke, when its receipt says it plainly (lib/receipts/classify.ts), once per sentence with its lines;
// a receipt of another version explains nothing about the version a fresh app installs (review r6)
const whyByText = new Map<string, string[]>()
for (const l of lines) {
  if (others[l.key]) continue
  // the cell's `finding` (round 14): the sentence the card, raw/modules.md and check_compat print, from the same
  // receipt; a cell emitted before the field explains its receipt here, with the same function
  const c = entry.compat.lines[l.key]
  const w = (c?.status === 'broken' ? c.finding : null) ?? explainReceipt(lastByLine[l.key] ?? null, appModules(data), routes)
  if (w) whyByText.set(w, [...(whyByText.get(w) ?? []), l.key])
}
// the likely cause of a typecheck break when the package bundles host packages a new app has in another version (D34,
// D-OPEN-4: the page helps the author, round 17: TS2321 stood alone while the data knew the duplicate @tanstack)
const dupFindings = detail?.hostDuplicates ?? []
const dupFixOn = (key: string): string | null => {
  const fs = dupFindings.filter((f) => f.lines.includes(key))
  const c = entry.compat.lines[key]
  const failed = lastByLine[key]?.steps.find((s) => s.status === 'fail')
  if (others[key] || c?.status !== 'broken' || c.step !== 'typecheck') return null
  return duplicateTypeError(failed?.excerpt, fs.map((f) => f.name)) ? hostDuplicateFix(fs) : null
}
/** `add` broke on a backend route a new app already has (lint `backend-route-collision`): the route to move (25 Oct). */
const collisionFixOn = (key: string): string | null => {
  const c = entry.compat.lines[key]
  if (others[key] || c?.status !== 'broken' || c.step !== 'add') return null
  return collisionFix(raw.compat.collisions?.[key] ?? [])
}
for (const l of lines) {
  const fix = dupFixOn(l.key)
  if (!fix) continue
  const w = `Likely cause: ${fix.charAt(0).toLowerCase()}${fix.slice(1)}.`
  whyByText.set(w, [...(whyByText.get(w) ?? []), l.key])
}
const stripWhy = [...whyByText].map(([w, keys]) => `${listAnd(keys)}: ${w}`)
// a backend route a new app already has, on a line without a verdict (round 14, lint `backend-route-collision`): the
// static check and what the same version did on the other lines, the words of the box, the card and check_compat
const warnByText = new Map<string, string[]>()
for (const l of lines) {
  const w = collisionNote(raw, l.key)
  if (w) warnByText.set(w, [...(warnByText.get(w) ?? []), l.key])
}
const stripWarn = [...warnByText].map(([w, keys]) => `${listAnd(keys)}: ${w}`)
// the signal `in isolation` next to a verdict, one sentence with its lines (round 13: events said the same sentence
// three times, one per line; with no verdict yet the strip's sentence says it)
const isoByText = new Map<string, string[]>()
for (const l of lines) {
  const t = isoBeside(l.key)
  if (t) isoByText.set(t, [...(isoByText.get(t) ?? []), l.key])
}
const stripIso = [...isoByText].map(([t, keys]) => `${listAnd(keys)}: ${t}`)
// the strip's ladder and nights show the receipts of the install version only: another version's red never stands
// next to a line that has no receipt for its own version (review r6)
const stripReceipts = receipts.filter((r) => {
  const o = others[r.om.line]
  if (o) return r.module?.version === o.installs
  // a line judged on its install version shows that version's nights only (review r7)
  const v = entry.compat.lines[r.om.line]?.moduleVersion
  return !v || v !== lineVersion(entry, r.om.line) || r.module?.version === v
})
// a receipt that installed a catalog replacement in place of a core module the entry requires (the preview receipts
// of Shopify and Sheets got the third-party durable data_sync before the harness fix, review r6): said under the
// strip from the receipt's own `requiresInstalled`, until the next run installs core
const replacedBy = new Map<string, string>()
for (const e of modules.entries) for (const r of e.replaces) if (e.npm) replacedBy.set(`${r}|${e.npm}`, e.npm)
const requiresNotes: string[] = []
{
  const subs = new Map<string, { keys: string[]; verified: boolean }>()
  for (const l of lines) {
    if (others[l.key]) continue
    const r = lastByLine[l.key]
    if (!r) continue
    for (const req of entry.requires) {
      const core = req.resolvesTo
      if (!core?.startsWith('core:') || r.requiresInstalled.includes(core)) continue
      const pkg = r.requiresInstalled
        .map((x) => x.replace(/@[^@/]+$/, ''))
        .find((name) => replacedBy.has(`${core}|${name}`))
      if (!pkg) continue
      const k = `${pkg}|${core.slice(5)}`
      const g = subs.get(k) ?? { keys: [], verified: true }
      g.keys.push(l.key)
      g.verified &&= r.result.status === 'verified'
      subs.set(k, g)
    }
  }
  for (const [k, g] of subs) {
    const [pkg, id] = k.split('|') as [string, string]
    requiresNotes.push(
      g.verified
        ? `Verified with ${pkg} installed in place of core ${id}.`
        : `The receipts on ${listAnd(g.keys)} installed ${pkg} in place of core ${id}.`,
    )
  }
}
// no nightly CI run exists while the receipts come from a preview run: nothing is promised for tonight (review r6); a
// package a new app on next already has runs on the weekly night only (lib/core/lines.ts `cellCadence`, the predicate
// the nightly plan runs by, review of 24 Oct)
const queued = (l: (typeof lines)[number]): string => queuedCellSentence(l, preset.has(l.key), previewData, sched)
/**
 * The state of one line in one sentence, the words of the strip (drawer, install box, Receipts tab). `withIso: false`
 * leaves the signal `in isolation` out, for the install box, which says it under the empty preset's command.
 */
function lineSentence(l: (typeof lines)[number], r: ReceiptT | null, status: string, withIso = true): string {
  const other = otherText(l.key)
  if (other) return other
  const c = entry.compat.lines[l.key]
  // no receipt from a new app yet, one from an app from the empty preset: the one sentence of lib/core/policy.ts
  const iso = withIso ? isoOf(l.key) : null
  if (!r && iso && status === 'untested')
    return [untestedText(l.key, iso, lineVersion(raw, l.key)), queued(l)].join(' ')
  if (!r && !withIso && isoOf(l.key) && status === 'untested') return [notTestedText(l.key), queued(l)].join(' ')
  if (!r)
    return status === 'skipped'
      ? (skipText ?? (preview ? PREVIEW_ONLY_TEXT : 'Not installed by the catalog.'))
      : noInstall
        ? 'Not installable by the catalog.'
        : [fitSentence(l), queued(l)].filter(Boolean).join(' ')
  // the shape of the break sentence (review r8: `Verified on 0.8 on 23 Oct.` beside `Broken at typecheck on 0.8 since
  // 23 Oct.`): the first verified night of the run, as the cell's `since`
  if (r.result.status === 'verified') return `Verified on ${l.key} since ${day(c?.since ?? r.run.at)}.`
  if (r.result.status === 'broken')

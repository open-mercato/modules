          <section class="tech__sec tech__tabs" aria-label="Anatomy, versions, receipts and quality">
          <div class="tabs" data-tabs>
            <div class="tabs__list" role="tablist" aria-label="Module details" hidden>
              {
                tabs.map((t, i) => (

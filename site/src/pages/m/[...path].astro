                <a href={href('/quality')}>How levels work</a>
              </p>
              <div class="omq">
                <div>
                  <h3 class="t-tagline">OM Quality</h3>
                  <p class="omq__state">{entry.quality ? `Reviewed on ${entry.quality.version}, valid until ${entry.quality.until}.` : 'Not reviewed.'}</p>
                  <p class="mod__fine">Review time can be paid for. The result cannot.</p>
                </div>
                <div class="omq__acts">
                  <a class="btn btn--secondary btn--sm" href={issueUrl('om-quality-request.yml')} rel="noopener noreferrer">Request review</a>
                  <a class="btn btn--ghost btn--sm" href={issueUrl('report-module.yml')} rel="noopener noreferrer">Report this module</a>
                </div>
              </div>
              <div class="maint">
                <h3 class="t-tagline">For maintainers</h3>
                <p class="mod__fine">Add the badge to your README. It follows the module's level and receipts.</p>
                <img class="maint__badge" src={href(`/badge/${entry.path}.svg`)} alt={`Open Mercato Modules badge for ${name}`} height="20" loading="lazy" />
                <CommandChip command={badge} prompt="" label="Copy badge markdown" />
              </div>
            </section>
          </div>
          </section>

          <section class="tech__sec" aria-labelledby="tech-agent-h">
            <h2 class="tech__h" id="tech-agent-h">For agents</h2>
            <p class="mod__fine">Every fact on this page is also in the agent card and the JSON document. The MCP tools and WebMCP return the same data.</p>
            <ul class="tech__links" role="list">
              <li><a href={href(moduleMd(entry.path))}><span>Agent card <code>.md</code></span></a></li>
              <li><a href={href(`/m/${entry.path}.json`)}><span>Detail <code>JSON</code></span></a></li>
              {/* a site path like the two above (finding of 25 Oct: the absolute link left a preview for a host that 404s) */}
              {entry.links.facts && <li><a href={sitePath(entry.links.facts)}><span>Anatomy facts <code>facts.json</code></span></a></li>}
            </ul>
            <div class="tech__vt">
              <span class="mod__fine">Show what an agent reads:</span>
              <ViewToggle client:painted="idle" md={href(moduleMd(entry.path))} json={href(`/m/${entry.path}.json`)} target="agent-view" />
              {/* a click on Human or Agent before the island hydrates: shown at once, replayed by the island (25 Oct) */}
              <script is:inline set:html={EARLY_VIEW_JS} />
            </div>
            <div id="agent-view" class="mod__agent"></div>
          </section>
        </div>
      </details>
    </div>
  </div>
</Base>

<script>
  // Technical details (26 Oct): a link or an address that points inside the closed disclosure (#receipts,
  // #panel-anatomy, #hygiene, #agent-view) opens it and scrolls to the target, so the old deep links still work.
  const tech = document.getElementById('technical') as HTMLDetailsElement | null
  const targetOf = (hash: string): HTMLElement | null => {
    if (hash.length < 2) return null
    let id = hash.slice(1)
    try {
      id = decodeURIComponent(id)
    } catch {
      // keep the raw id
    }
    return document.getElementById(id) ?? document.getElementById(`panel-${id}`)
  }
  const reveal = (hash: string, scroll: boolean): void => {
    const el = targetOf(hash)
    // `#readme` of the old tab row: the README is the body of the page now, outside the disclosure
    if (el && scroll && !tech?.contains(el) && el.id !== hash.slice(1)) el.scrollIntoView({ block: 'start' })
    if (!tech || !el || !tech.contains(el) || el === tech) return
    tech.open = true
    // a target inside a tab panel shows its tab (the tab script listens for this event)
    el.dispatchEvent(new CustomEvent('om:reveal', { bubbles: true }))
    if (scroll) requestAnimationFrame(() => el.scrollIntoView({ block: 'start' }))
  }
  reveal(location.hash, true)
  window.addEventListener('hashchange', () => reveal(location.hash, true))
  // a click on an in-page link opens the disclosure before the browser scrolls to the target
  document.addEventListener(
    'click',
    (ev) => {
      const a = (ev.target as Element | null)?.closest<HTMLAnchorElement>('a[href^="#"]')
      const h = a?.getAttribute('href')
      if (h) reveal(h, false)
    },
    true,
  )

  // ARIA tabs (spec 7.9): without JavaScript every panel stays visible, one under another.
  for (const root of Array.from(document.querySelectorAll<HTMLElement>('[data-tabs]'))) {
    const list = root.querySelector<HTMLElement>('[role="tablist"]')
    const tabs = Array.from(root.querySelectorAll<HTMLButtonElement>('[role="tab"]'))
    const panels = tabs.map((t) => document.getElementById(t.getAttribute('aria-controls') ?? ''))
    if (!list || tabs.length === 0) continue
    root.classList.add('is-tabs')
    list.hidden = false
    // the hash changes only when someone picks a tab, never on load
    const select = (i: number, focus: boolean, writeHash = true): void => {
      tabs.forEach((t, j) => {
        const on = i === j
        t.setAttribute('aria-selected', String(on))
        t.tabIndex = on ? 0 : -1
        if (panels[j]) panels[j]!.hidden = !on
      })
      if (focus) tabs[i]?.focus()
      if (!writeHash) return
      try {
        history.replaceState(history.state, '', `#${tabs[i]?.id.replace(/^tab-/, '') ?? ''}`)
      } catch {
        // ignore
      }
    }
    /** The tab whose panel holds the element of a hash (`#receipts`, `#panel-quality`, `#hygiene`), or -1. */
    const tabOf = (hash: string): number => {
      const byName = tabs.findIndex((t) => `#${t.id.replace(/^tab-/, '')}` === hash)
      if (byName >= 0) return byName
      const panel = targetOf(hash)?.closest('[role="tabpanel"]')
      return panel ? panels.indexOf(panel as HTMLElement) : -1
    }
    const fromHash = tabOf(location.hash)
    select(fromHash >= 0 ? fromHash : 0, false, false)
    tabs.forEach((t, i) => {
      t.addEventListener('click', () => select(i, false))
      t.addEventListener('keydown', (ev) => {
        const k = ev.key
        const n = tabs.length
        const next = k === 'ArrowRight' ? (i + 1) % n : k === 'ArrowLeft' ? (i - 1 + n) % n : k === 'Home' ? 0 : k === 'End' ? n - 1 : -1
        if (next >= 0) {
          ev.preventDefault()
          select(next, true)
        }
      })
    })
    // links into a panel (#hygiene, #panel-receipts) switch to its tab
    document.addEventListener('click', (ev) => {
      const a = (ev.target as Element | null)?.closest<HTMLAnchorElement>('a[href^="#"]')
      const i = tabOf(a?.getAttribute('href') ?? '')
      if (i >= 0) select(i, false, false)
    })
    // an address change into a panel (the back button, a pasted link) switches too
    root.addEventListener('om:reveal', (ev) => {
      const panel = (ev.target as Element).closest('[role="tabpanel"]')
      const i = panel ? panels.indexOf(panel as HTMLElement) : -1
      if (i >= 0) select(i, false, false)
    })
  }
</script>

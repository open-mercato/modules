const readmeCut = !!facts?.readmeExcerpt && readmeWasCut(facts.readmeExcerpt)
const readme = facts?.readmeExcerpt
  ? readmeWholeLines(
      facts.readmeExcerpt
        .replace(/<br\s*\/?>/gi, '\n')
        .replace(README_TAG, '')
        .replace(/[ \t]+\n/g, '\n')
        .replace(/\n{3,}/g, '\n\n')

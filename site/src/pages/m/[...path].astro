      .trim() || null
  : null
const title = `${entry.title} · ${name} · Open Mercato Modules`
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareSourceCode',
  name: entry.title,
  description: entry.summary,
  ...(entry.links.repo ? { codeRepository: entry.links.repo } : {}),
  programmingLanguage: 'TypeScript',
  ...(entry.license.spdx ? { license: entry.license.spdx } : {}),
  ...(entry.version.latest ? { version: entry.version.latest } : {}),
  url: absoluteUrl(meta.site, modulePage(entry.path)),
}
const tabsOrder = [
  { id: 'anatomy', label: 'Anatomy' },
  { id: 'versions', label: 'Versions' },
  { id: 'receipts', label: 'Receipts' },
  { id: 'readme', label: 'Readme' },
  { id: 'quality', label: 'Quality' },
]
// a tool or library ships no module, so its anatomy is empty: the page opens on how to use it, its README (finding of 25
// Oct: create-mercato-module, the first stop of a new author, opened on a black panel of zeros)
const readmeFirst = entry.moduleIds.length === 0 && (entry.kind === 'tool' || entry.kind === 'library') && !!readme
const tabs = readmeFirst
  ? [tabsOrder[3]!, ...tabsOrder.filter((t) => t.id !== 'readme')]
  : tabsOrder
---

<Base
  title={title}
  description={entry.summary}
  path={modulePage(entry.path)}
  dataAsOf={meta.dataAsOf}
  mdAlternate={moduleMd(entry.path)}
  webmcp
  jsonLd={jsonLd}
  skip={{ href: '#module-body', label: 'Skip to module details' }}
>
  <div class="band">
    <div class="sheet mod">
      <nav class="crumbs" aria-label="Breadcrumb">
        <ol role="list">
          <li><a href={href('/')}>Modules</a></li>
          <li><a href={href(categoryPage(entry.category))}>{catTitle(entry.category)}</a></li>
          <li aria-current="page"><code translate="no" set:html={wbrHtml(name)} /></li>
        </ol>
      </nav>

      <header class="mhd">
        <YMarks inset={8} />
        <div class="mhd__sig"><Sigil entry={entry} size={96} transition /></div>
        <div class="mhd__main">
          <h1 class="t-h1 mhd__title" style={`view-transition-name:${vt.title}`}>{entry.title}</h1>
          <p class="mhd__loc">
            <code translate="no" set:html={wbrHtml(entry.locator)} />
            <button type="button" class="mhd__copy" data-copy={entry.locator} aria-label={`Copy locator ${entry.locator}`}>
              <Icon name="copy" size={14} />
            </button>
          </p>
          <p class="mhd__sum">{entry.summary}</p>
          <ul class="mhd__chips" role="list">
            <li class="mhd__level">
              {
                entry.enterprise ? (
                  <span class="chip chip--enterprise" title="Commercial license. Anatomy not published.">
                    Enterprise license
                  </span>
                ) : (
                  <Seal entry={{ ...entry, levelNote: note }} latestKey={latest.key} preview={previewData} />
                )
              }
            </li>
            <li><TypeChip type={entry.type} /></li>
            <li><span class="chip chip--line">{entry.kind}</span></li>
            {!entry.enterprise && <li><LicenseChip license={entry.license} /></li>}
            <li><a class="chip chip--line chip--link" href={href(categoryPage(entry.category))}>{catTitle(entry.category)}</a></li>
            {
              /* claims are for authors outside the org: an @open-mercato package is never "unclaimed" (lib/core claimLabel,
                 the card's Trust line reads the same) */
              claimLabel(entry) && (
                <li>
                  {claimLabel(entry) === 'Claimed' ? (
                    <span class="chip chip--line" title="The author confirmed this listing.">Claimed</span>
                  ) : (
                    <a
                      class="chip chip--line chip--link"
                      href={`${repoUrl}/blob/main/CONTRIBUTING.md`}
                      title="Not claimed by its author yet. CONTRIBUTING.md says how to claim a listing."
                    >
                      Unclaimed
                    </a>
                  )}
                </li>
              )
            }
          </ul>
          <ul class="mhd__built dotlist" role="list">
            {headerParts.map((t) => <li class:list={{ mhd__verified: t.startsWith('Verified on ') }}>{t}</li>)}
          </ul>
        </div>
        <div class="mhd__side">
          <ViewToggle client:painted="idle" md={href(moduleMd(entry.path))} json={href(`/m/${entry.path}.json`)} target="agent-view" />
          {/* a click on Human or Agent before the island hydrates: shown at once, replayed by the island (25 Oct) */}
          <script is:inline set:html={EARLY_VIEW_JS} />
        </div>
      </header>

      <div class="mod__banners" data-human>
        {held && (
          <Banner variant="hold" link={entry.supersededBy ? { href: entry.supersededBy.startsWith('core:') ? href(builtInPage(entry.supersededBy.slice(5))) : href(modulePage(byLocator.get(entry.supersededBy)?.path ?? '')), label: entry.supersededBy.startsWith('core:') ? `Built-in ${entry.supersededBy.slice(5)}` : 'Use instead' } : undefined}>
            {/* the banner label already says ON HOLD (6.8 text stays in the install box, cards and JSON) */}
            {holdText.replace(/^On hold:\s*/, '')}
          </Banner>
        )}
        {notListed && <Banner variant="hold" tag="Not listed">{blocked}</Banner>}
        {entry.status === 'unmaintained' && (
          <Banner variant="hold" tag="Unmaintained">
            Not maintained.{entry.alternatives.length > 0 && ` Alternatives: ${entry.alternatives.map((a) => a.replace(/^npm:|^github:/, '')).join(', ')}.`}
          </Banner>
        )}
        {reason('ADVISORY') && <Banner variant="advisory">{reason('ADVISORY')} Do not install until fixed.</Banner>}
        {entry.replaces.length > 0 && (
          <Banner variant="replaces">
            Replaces the built-in {entry.replaces.map((r) => r.replace(/^core:/, '')).join(', ')} module. You cannot enable both.
          </Banner>
        )}
        {entry.enterprise && (
          <Banner variant="enterprise" link={entry.links.docs ? { href: entry.links.docs, label: 'See the offer' } : undefined}>
            Anatomy not published. Commercial license.
          </Banner>
        )}
        {github && (
          <Banner variant="github-only">
            {entry.version.gitRef
              ? noInstall
                ? `No npm package. The source is on GitHub at tag ${entry.version.gitRef}.`
                : `No npm package. Receipts install from GitHub at tag ${entry.version.gitRef}.`
              : 'No npm package and no pinned tag. The catalog cannot install it until a tag is pushed.'}
          </Banner>
        )}
        {preview && !held && <Banner variant="preview">No stable release yet. Only preview builds are published.</Banner>}
        {quarantineUntil && !held && (
          <Banner variant="quarantine">
            New release. A fresh app installs it from {day(quarantineUntil)} (Yarn {sched.ageGateDays}-day age gate).
          </Banner>
        )}
        {harnessRed && (
          <Banner variant="harness-red">
            A new Open Mercato {latest.version} app failed tonight. Module results on this line are withheld.
          </Banner>
        )}
      </div>

      <div id="agent-view" class="mod__agent"></div>



      {
        /* entries the catalog never installs: no strip; the header line and the plate already say why */
        noStrip ? null : (
          <div class="mod__strip" data-human>
            {/* the island's marker covers the strip (_module.css), so the drawer hydrates as soon as any of it shows */}
            <ReceiptDrawer
              client:painted="visible"
              title={entry.title}
              previewSentence={previewReceipts ? PREVIEW_SENTENCE : null}
              lines={drawerLines}
              compatHref={href('/compat')}
              compatLabel={meta.dataAsOf.nightly === null ? 'Compatibility matrix' : 'All receipts'}
            />
            {compactStrip ? (
              <a class="ssq" href="#panel-receipts" data-receipts-open aria-label={`Receipts. ${drawerLines.map((l) => `${l.key}: ${l.sentence}`).join(' ')}${stripWarn.length ? ` ${stripWarn.join(' ')}` : ''}`}>
                <span class="ssq__cells" aria-hidden="true">
                  {drawerLines.map((l) => (
                    <span class="ssq__cell">
                      <span class="ssq__k">{l.key}</span>
                      <Square status={l.status} step={l.step ?? null} iso={l.isolation?.dot ?? null} />
                    </span>
                  ))}
                </span>
                <span class="ssq__text">
                  <span class="ssq__main">{compactSentence}</span>
                  {/* the static check before the first night (round 14): a prediction from the facts, said as one */}
                  {stripWarn.map((w) => <span class="ssq__warn" set:html={nbspDates(whyHtml(w))} />)}
                </span>
                <span class="ssq__btn">
                  Receipts <Icon name="chevron-down" size={14} class="icon ssq__chev" />
                </span>
              </a>
            ) : (
              <SignalStripDetailed
                entry={entry}
                lines={modules.lines}
                receipts={stripReceipts}
                end={today}
                href="#panel-receipts"
                sentence={{ queued: compactSentence, ageGateDays: sched.ageGateDays, installableFrom: quarantineUntil, unconfirmed, others }}
                note={previewReceipts ? PREVIEW_CHIP : null}
                noteTitle={previewReceipts ? PREVIEW_SENTENCE : null}
                why={stripWhy}
                warn={stripWarn}
                isolation={stripIso}
                versions={requiresNotes}
              />
            )}
          </div>
        )
      }

      <div class="mod__grid" id="module-body" data-human>
        <div class="mod__main">
          <div class="tabs" data-tabs>
            <div class="tabs__list" role="tablist" aria-label="Module details" hidden>
              {
                tabs.map((t, i) => (
                  <button
                    type="button"
                    role="tab"
                    id={`tab-${t.id}`}
                    aria-controls={`panel-${t.id}`}
                    aria-selected={i === 0 ? 'true' : 'false'}
                    tabindex={i === 0 ? 0 : -1}
                  >
                    {t.label}
                  </button>
                ))
              }
            </div>

            <!-- Anatomy -->
            <section class="tabs__panel" id="panel-anatomy" role="tabpanel" aria-labelledby="tab-anatomy" tabindex="0">
              <h2 class="tabs__h">Anatomy</h2>
              {
                anatomyState === 'hidden' ? (
                  <div class="ent">
                    {/* the banner says the anatomy is not published; the tab lists what the package contains */}
                    {entry.moduleIds.length === 0 && <p class="mod__empty">Anatomy not published. Commercial license.</p>}
                    {entry.moduleIds.length > 0 && (
                      <>
                        <h3 class="t-tagline ent__h">Includes {plural(entry.moduleIds.length, 'module')}</h3>
                        <p class="mod__fine">Module IDs from the package. Their contracts are not published.</p>
                        <ul class="ent__list" role="list">
                          {entry.moduleIds.map((id) => {
                            const core = builtInById.get(id)
                            return (
                              <li class="ent__item">
                                {core ? <Sigil builtIn={core} size={24} /> : <Sigil kind="built-in" glyph="0000000" size={24} />}
                                {core ? (
                                  <a href={href(builtInPage(id))}><code translate="no">{id}</code></a>
                                ) : (
                                  <code translate="no">{id}</code>
                                )}
                              </li>
                            )
                          })}
                        </ul>
                      </>
                    )}
                  </div>
                ) : !entry.anatomy || !facts ? (
                  <p class="mod__empty">
                    {github && !entry.version.gitRef
                      ? 'Not read yet: the repository has no tag to read the code from.'
                      : 'Not read yet. The catalog reads the published code within minutes of a release.'}
                  </p>
                ) : (
                  <>
                    {/* AnatomyFilm titles its nine sections with h4: this keeps the outline h2 > h3 > h4 (7.9) */}
                    <h3 class="sr-only">What it adds, section by section</h3>
                    <div class="anat">
                      <AnatomyFilm entry={entry} facts={facts} />
                    </div>
                    {(plugRequires.length > 0 || plugExtends.length > 0) && (
                      <div class="anat__plug">
                        <h3 class="t-tagline">Plugs into</h3>
                        <PlugDiagram title={entry.moduleIds[0] ?? entry.title} requires={plugRequires} extends={plugExtends} />
                      </div>
                    )}
                  </>
                )
              }
              {
                lintSorted.length > 0 && (
                  <div class="hyg" id="hygiene">
                    <h3 class="hyg__h">
                      <span class="t-tagline">Hygiene</span>
                      <span class:list={['hyg__status', `hyg__status--${sig.hygiene.status}`]}>{sig.hygiene.status}</span>
                    </h3>
                    <ul class="hyg__list" role="list">
                      {lintSorted.map((l) => {
                        const doc = anchorUrl(l.anchor)
                        const src = l.src ? srcUrl(l.src.file, l.src.line) : null
                        return (
                          <li class:list={['hyg__item', `hyg__item--${l.severity}`]}>
                            <span class="hyg__sev">{l.severity}</span>
                            <code class="hyg__code">{l.code}</code>
                            {/* one sentence: the lint text of the data branch has a stray period before its example */}
                            {/* an npm package never breaks at its hyphen (round 14) */}
                            <span class="hyg__msg" set:html={nwPackages(lintMessage(l.message))} />
                            <span class="hyg__links">
                              {src && l.src && (
                                <a href={src} rel="noopener noreferrer" set:html={`${wbrHtml(`${l.src.file}:${l.src.line}`)}`} />
                              )}
                              {doc && (
                                <a href={doc} rel="noopener noreferrer">
                                  rule
                                </a>
                              )}
                            </span>
                          </li>
                        )
                      })}
                    </ul>
                  </div>
                )
              }
            </section>

            <!-- Versions -->
            <section class="tabs__panel" id="panel-versions" role="tabpanel" aria-labelledby="tab-versions" tabindex="0">
              <h2 class="tabs__h">Versions</h2>
              {
                versions.length === 0 ? (
                  <p class="mod__empty">
                    {entry.enterprise
                      ? 'Versions are not compared for commercial packages: the anatomy is not published.'
                      : 'No published version read yet.'}
                  </p>
                ) : (
                  <ol class="vers" role="list">
                    {versions.map((v, i) => (
                      <li class="vers__item">
                        <code class="vers__v">{v}</code>
                        <span class="vers__tags">
                          {v === entry.version.latest && <span class="chip chip--line">latest</span>}
                          {Object.entries(entry.version.recommended)
                            .filter(([, r]) => r === v)
                            .map(([k]) => (
                              <span class="chip chip--official">recommended · {k}</span>
                            ))}
                          {v === entry.version.latest && entry.version.publishedAt && <span class="vers__date">{dayYear(entry.version.publishedAt)}</span>}
                        </span>
                        <span class="vers__diff">
                          {i === 0 && diff && v === entry.anatomy?.version ? (
                            <>
                              <span class="vers__from">Since {diff.from}:</span> {diffLabel()}
                            </>
                          ) : i === 0 && !diff ? (
                            'First version read by the catalog.'
                          ) : (
                            ''
                          )}
                        </span>
                        <a class="vers__facts" href={href(`/m/${entry.path}/v/${v}/facts.json`)}>
                          facts.json
                        </a>
                      </li>
                    ))}
                  </ol>
                )
              }
              {entry.version.preview && <p class="vers__preview">Preview on npm: <code>{entry.version.preview}</code></p>}
              <p class="mod__fine">The catalog reads the latest and the previous stable release. Older versions stay on npm.</p>
            </section>

            <!-- Receipts -->
            <section class="tabs__panel" id="panel-receipts" role="tabpanel" aria-labelledby="tab-receipts" tabindex="0">
              <h2 class="tabs__h">Receipts</h2>
              {
                lines.some((l) => lastByLine[l.key]) && (
                  <ul class="rcards" role="list">
                    {lines
                      .filter((l) => lastByLine[l.key])
                      .map((l) => {
                        const r = lastByLine[l.key]!
                        return (
                          <li class="rcards__item">
                            <p class="rcards__line">
                              <span>{lineLabel(l)}</span>
                              {isPreview(r) && <span class="chip chip--preview" title={PREVIEW_SENTENCE}>{PREVIEW_CHIP}</span>}
                            </p>
                            {otherText(l.key) && <p class="rcards__other">{otherText(l.key)}</p>}
                            {preset.has(l.key) && <p class="rcards__other">{presetText(l.key)}</p>}
                            {isoSentence(l.key) && (
                              <p class="rcards__other">
                                {nbspDates(isoSentence(l.key)!)}{' '}
                                {isoOf(l.key)?.receipt && <a href={href(receiptPage(isoOf(l.key)!.receipt!))}>Open the receipt</a>}
                              </p>
                            )}
                            {pinned[l.key] && (
                              <p class="rcards__other">
                                {pinned[l.key]!.text}{' '}
                                <a href={href(receiptPage(pinned[l.key]!.receipt.id))}>
                                  {`Open the ${pinned[l.key]!.receipt.module?.version ?? ''} receipt`}
                                </a>
                              </p>
                            )}
                            <Receipt receipt={r} jsonHref={href(`/r/${r.id}.json`)} compact />
                            <a class="rcards__open" href={href(receiptPage(r.id))}>
                              Open receipt
                            </a>
                          </li>
                        )
                      })}
                  </ul>
                )
              }
              {
                /* lines without a receipt: one list, one row per line (no empty paper per line) */
                drawerLines.some((d) => !d.receipt) && (
                  <ul class="rwait" role="list">
                    {drawerLines
                      .filter((d) => !d.receipt)
                      .map((d) => (
                        <li class="rwait__item">
                          <span class="rwait__k">{d.label}</span>
                          <span class="rwait__t">{d.sentence}</span>
                        </li>
                      ))}
                  </ul>
                )
              }
              {
                transitions.length > 0 && (
                  <div class="trans">
                    <h3 class="t-tagline">Transitions</h3>
                    <ol class="trans__list" role="list">
                      {transitions.map(({ r, from, to }) => (
                        <li class="trans__item">
                          <span class="trans__at">{dayYear(r.run.at)}</span>
                          {/* both versions named (review r11: `0.8 · 0.8.0 ... 0.8.0` read as a repeat) */}
                          <span class="trans__line">{r.om.line} · OM {shortVersion(r.om.version)}</span>
                          <span class="trans__ft">
                            {from} → <strong>{to}</strong>
                            {r.transition.confirmed && <span class="trans__conf"> · confirmed</span>}
                          </span>
                          <span class="trans__v">{r.module ? `module ${shortVersion(r.module.version)}` : ''}</span>
                          <a href={href(receiptPage(r.id))}>receipt</a>
                        </li>
                      ))}
                    </ol>
                  </div>
                )
              }
            </section>

            <!-- Readme -->
            <section class="tabs__panel" id="panel-readme" role="tabpanel" aria-labelledby="tab-readme" tabindex="0">
              <h2 class="tabs__h">Readme</h2>
              {
                readme ? (
                  <figure class="readme">
                    <figcaption class="readme__cap">
                      <Icon name="warning" size={14} /> Author's README. Not verified by the catalog.
                    </figcaption>
                    {/* a scrolling region a keyboard can reach (axe scrollable-region-focusable, review r4) */}
                    <div class="readme__text" tabindex="0" role="region" aria-label="Author's README">{readme}</div>
                  </figure>
                ) : (
                  <p class="mod__empty">
                    {/* nothing was read from a repository without a tag (finding of 25 Oct: treg has a README) */}
                    {!facts && github && !entry.version.gitRef
                      ? 'Not read yet: the repository has no tag to read the README from.'
                      : !facts
                        ? 'Not read yet. The catalog reads the published package within minutes of a release.'
                        : 'No README text in the published package.'}
                  </p>
                )
              }
              <p class="readme__links">
                {entry.links.npm && <a href={entry.links.npm} rel="noopener noreferrer">npm <Icon name="external" size={14} /></a>}
                {entry.links.repo && <a href={entry.links.repo} rel="noopener noreferrer">Repository <Icon name="external" size={14} /></a>}
              </p>
            </section>

            <!-- Quality -->
            <section class="tabs__panel" id="panel-quality" role="tabpanel" aria-labelledby="tab-quality" tabindex="0">
              <h2 class="tabs__h">Quality</h2>
              <h3 class="t-tagline qual__h">{qualHead}</h3>
              <ul class="qual" role="list">
                {
                  ver.map((v) => (
                    <li class:list={['qual__item', v.pass ? 'is-pass' : 'pending' in v && v.pending ? 'is-pending' : 'is-fail']}>
                      <span class="qual__mark" aria-label={v.pass ? 'pass' : 'pending' in v && v.pending ? 'pending' : 'fail'}>
                        {v.pass ? '✓' : 'pending' in v && v.pending ? '○' : '✗'}
                      </span>
                      <code class="qual__id">{v.id}</code>
                      <span class="qual__text">{v.text}</span>
                      {!v.pass && !('pending' in v && v.pending) && <span class="qual__fix"><span class="t-label">What to fix</span> {v.fix}</span>}
                    </li>
                  ))
                }
              </ul>
              <p class="mod__fine">
                {qualTest && `${qualTest} `}
                <a href={href('/quality')}>How levels work</a>
              </p>
              <div class="omq">
                <div>
                  <h3 class="t-tagline">OM Quality</h3>
                  <p class="omq__state">{entry.quality ? `Reviewed on ${entry.quality.version}, valid until ${entry.quality.until}.` : 'Not reviewed.'}</p>
                  <p class="mod__fine">Review time can be paid for. The result cannot.</p>
                </div>
                <div class="omq__acts">
                  <a class="btn btn--secondary btn--sm" href={issueUrl('om-quality-request.yml')} rel="noopener noreferrer">Request review</a>
                  <a class="btn btn--ghost btn--sm" href={issueUrl('report-module.yml')} rel="noopener noreferrer">Report this module</a>
                </div>
              </div>
              <div class="maint">
                <h3 class="t-tagline">For maintainers</h3>
                <p class="mod__fine">Add the badge to your README. It follows the module's level and receipts.</p>
                <img class="maint__badge" src={href(`/badge/${entry.path}.svg`)} alt={`Open Mercato Modules badge for ${name}`} height="20" loading="lazy" />
                <CommandChip command={badge} prompt="" label="Copy badge markdown" />
              </div>
            </section>
          </div>
          <div class="mod__plate">
            <Nameplate rows={rows} more={moreRows} title="Nameplate" />
          </div>
        </div>

        <aside class="mod__side" aria-label="Install and links">
          <div class="mod__sticky">
            <InstallBox
              client:painted="visible"
              lines={installLines}
              initial={latest.key}
              warning={warning}
              cloudUrl="https://app.openmercatocloud.com/dashboard?create=1"
              blocked={blocked}
              hideLines={allSkipped}
              reasonLabels={REASON_LABELS}
            >
              {
                lines.map((l) =>
                  plans[l.key] ? (
                    <div data-plan-line={l.key} hidden={l.key !== latest.key}>
                      <InstallPlan
                        plan={plans[l.key]!}
                        omVersion={l.version}
                        preset={preset.has(l.key)}
                        title={(() => {
                          // the module of the page, not the first item of the order (round 14: `events@0.9.0`
                          // headed the plan of shipment-tracking, whose requires come first)
                          // a plan with nothing of this module to install (a GitHub repository with no tag) is still
                          // its plan: its name, never the `empty` that read like the empty preset (finding of 25 Oct)
                          const own = plans[l.key]!.order.find((o) => o.locator === entry.locator)
                          return own ? `${name}@${own.version}` : name
                        })()}
                      />
                    </div>
                  ) : null,
                )
              }
            </InstallBox>
          </div>

        </aside>
      </div>

      {/* links, stats and related run under both columns (review r1): the right column holds only the install box,
          so it never leaves a column of white beside a short page */}
      <div class="mod__foot" data-human>
          <section class="side__sec" aria-labelledby="links-h">
            <h2 class="side__h" id="links-h">Links</h2>
            <ul class="side__links" role="list">
              {entry.links.npm && <li><a href={entry.links.npm} rel="noopener noreferrer">npm <Icon name="external" size={14} /></a></li>}
              {entry.links.repo && <li><a href={entry.links.repo} rel="noopener noreferrer">Repository <Icon name="external" size={14} /></a></li>}
              {entry.links.docs && <li><a href={entry.links.docs} rel="noopener noreferrer">Docs <Icon name="external" size={14} /></a></li>}
              <li><a href={href(moduleMd(entry.path))}><span>Agent card <code>.md</code></span></a></li>
              <li><a href={href(`/m/${entry.path}.json`)}>JSON</a></li>
              {/* a site path like the two above (finding of 25 Oct: the absolute link left a preview for a host that 404s) */}
              {entry.links.facts && <li><a href={sitePath(entry.links.facts)}><span>Anatomy facts <code>facts.json</code></span></a></li>}
            </ul>
          </section>

          {
            // SPEC 7.x item 5 (finding of 25 Oct): who can publish the package, from the npm sync
            (detail?.maintainers?.length ?? 0) > 0 && (
              <section class="side__sec" aria-labelledby="maint-h">
                <h2 class="side__h" id="maint-h">Maintainers <span class="side__sub">npm, can publish.</span></h2>
                <ul class="side__links" role="list">
                  {detail!.maintainers!.map((m) => (
                    <li><a href={`https://www.npmjs.com/~${encodeURIComponent(m)}`} rel="noopener noreferrer">{m} <Icon name="external" size={14} /></a></li>
                  ))}
                </ul>
              </section>
            )
          }

          {
            entry.stats && entry.type !== 'official' && (
              <section class="side__sec" aria-labelledby="stats-h">
                <h2 class="side__h" id="stats-h">Stats <span class="side__sub">Shown, not scored.</span></h2>
                <dl class="side__stats">
                  <div>
                    <dt>npm downloads, 30 days</dt>
                    {entry.stats.downloads30d === null ? <dd class="side__na">Not available</dd> : <dd>{entry.stats.downloads30d.toLocaleString('en-US')}</dd>}
                  </div>
                  <div>
                    <dt>GitHub stars</dt>
                    {entry.stats.stars === null ? <dd class="side__na">Not available</dd> : <dd>{entry.stats.stars.toLocaleString('en-US')}</dd>}
                  </div>
                </dl>
              </section>
            )
          }

          {
            (entry.requires.length > 0 || requiredBy.length > 0 || related.length > 0) && (
              <section class="side__sec" aria-labelledby="rel-h">
                <h2 class="side__h" id="rel-h">Related</h2>
                {entry.requires.length > 0 && (
                  <>
                    <p class="side__k">Requires</p>
                    <ul class="side__rel" role="list">
                      {entry.requires.map((r) => {
                        const l = linkFor(r)
                        return (
                          <li>
                            <a href={l.href}>{l.label}</a> <span>{l.note}</span>
                          </li>
                        )
                      })}
                    </ul>
                  </>
                )}
                {requiredBy.length > 0 && (
                  <>
                    <p class="side__k">Required by</p>
                    <ul class="side__rel" role="list">
                      {requiredBy.map((e) => (
                        <li>
                          <a href={href(modulePage(e.path))}>{e.title}</a>
                        </li>
                      ))}
                    </ul>
                  </>
                )}
                {related.length > 0 && (
                  <>
                    <p class="side__k">Same category</p>
                    <ul class="side__rel" role="list">
                      {related.map((e) => (
                        <li class="side__relrow">
                          <Sigil entry={e} size={16} />
                          <a href={href(modulePage(e.path))}>{e.title}</a>
                        </li>
                      ))}
                    </ul>
                  </>
                )}
              </section>
            )
          }
      </div>
    </div>
  </div>
</Base>

<script>
  // ARIA tabs (spec 7.9): without JavaScript every panel stays visible, one under another.
  for (const root of Array.from(document.querySelectorAll<HTMLElement>('[data-tabs]'))) {
    const list = root.querySelector<HTMLElement>('[role="tablist"]')
    const tabs = Array.from(root.querySelectorAll<HTMLButtonElement>('[role="tab"]'))
    const panels = tabs.map((t) => document.getElementById(t.getAttribute('aria-controls') ?? ''))
    if (!list || tabs.length === 0) continue
    root.classList.add('is-tabs')
    list.hidden = false
    // the hash changes only when someone picks a tab, never on load
    const select = (i: number, focus: boolean, writeHash = true): void => {
      tabs.forEach((t, j) => {
        const on = i === j
        t.setAttribute('aria-selected', String(on))
        t.tabIndex = on ? 0 : -1
        if (panels[j]) panels[j]!.hidden = !on
      })
      if (focus) tabs[i]?.focus()
      if (!writeHash) return
      try {
        history.replaceState(history.state, '', `#${tabs[i]?.id.replace(/^tab-/, '') ?? ''}`)
      } catch {
        // ignore
      }
    }
    const fromHash = tabs.findIndex((t) => `#${t.id.replace(/^tab-/, '')}` === location.hash)
    select(fromHash >= 0 ? fromHash : 0, false, false)
    tabs.forEach((t, i) => {
      t.addEventListener('click', () => select(i, false))
      t.addEventListener('keydown', (ev) => {
        const k = ev.key
        const n = tabs.length
        const next = k === 'ArrowRight' ? (i + 1) % n : k === 'ArrowLeft' ? (i - 1 + n) % n : k === 'Home' ? 0 : k === 'End' ? n - 1 : -1
        if (next >= 0) {
          ev.preventDefault()
          select(next, true)
        }
      })
    })
    // links into a panel (#hygiene) switch to its tab
    document.addEventListener('click', (ev) => {
      const a = (ev.target as Element | null)?.closest<HTMLAnchorElement>('a[href^="#"]')
      const id = a?.getAttribute('href')?.slice(1)
      const panel = id ? document.getElementById(id)?.closest('[role="tabpanel"]') : null
      const i = panel ? panels.indexOf(panel as HTMLElement) : -1
      if (i >= 0) select(i, false)
    })
  }
</script>

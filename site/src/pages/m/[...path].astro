const README_TAG =
  /<\/?(?:p|h[1-6]|img|a|br|strong|em|b|i|div|span|picture|source|sub|sup|details|summary|table|thead|tbody|tr|td|th|ul|ol|li|hr|center)\b[^>]*>/gi

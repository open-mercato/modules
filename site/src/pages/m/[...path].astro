  const out: string[] = []
  const firstPage = a.lists.backendPages?.[0]
  if (c.backendPages) out.push(`${plural(c.backendPages, 'admin page')}${firstPage ? `, starting at ${firstPage}` : ''}.`)
  if (c.frontendPages) out.push(`${plural(c.frontendPages, 'storefront page')}.`)
  if (c.tables) out.push(`${plural(c.tables, 'database table')}.`)
  if (c.routes) out.push(`${plural(c.routes, 'API route')}${c.publicRoutes ? `, ${c.publicRoutes} open to the public` : ''}.`)
  if (c.widgets) out.push(`${plural(c.widgets, 'widget')} on other admin pages.`)
  if (c.aiTools || c.aiAgents)
    out.push(`${listAnd([c.aiTools ? plural(c.aiTools, 'AI tool') : '', c.aiAgents ? plural(c.aiAgents, 'AI agent') : ''].filter(Boolean))}.`)
  if (c.workers) out.push(`${plural(c.workers, 'background worker')}.`)
  if (c.eventsEmitted) out.push(`${plural(c.eventsEmitted, 'event')} other modules can react to.`)
  if (c.aclFeatures) out.push(`${plural(c.aclFeatures, 'permission')} to give to roles.`)
  const hosts = a.lists.hosts ?? []
  if (hosts.length) out.push(`Connects to ${listAnd(hosts.length > 2 ? [...hosts.slice(0, 2), plural(hosts.length - 2, 'more host')] : hosts)}.`)

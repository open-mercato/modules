    text-transform: uppercase;
    color: var(--ink-2);
  }
  .cm__grpt {
    position: sticky;
    left: 16px;
  }
  .cm__grpn {
    margin-left: 6px;
    color: var(--ink-3);
  }
  .cm__base .cm__loc {
    padding-left: 0;
  }
  /* day 0: one sentence in the pinned row, set as text (beats `.cm__table td` and `.cm__td`) */
  .cm__table td.cm__queued {
    padding: 12px 16px;
    font-family: var(--font-sans);
    font-size: 13px;
    line-height: 20px;
    color: var(--ink-2);
    text-align: left !important;
  }
  .cm__td {
    text-align: center !important;
    vertical-align: middle;
  }
  /* the cell: a 28 px box (spec 6.7). Receipt layer in the middle, the fit layer as the box outline + corner glyph */
  .cm__cell {
    position: relative;
    display: inline-grid;
    place-items: center;
    width: 28px;
    height: 28px;
    margin: 6px 0;
    padding: 0;
    border: 0;
    border-radius: var(--radius-s);
    background: transparent;
    outline-offset: 2px;
  }
  .cm__cell:hover {
    box-shadow: 0 0 0 2px var(--bg), 0 0 0 3px var(--ink-3);
  }
  .cm__st {
    display: grid;
    place-items: center;
    width: 28px;
    height: 28px;
  }
  /* a real result fills the 28 px cell; with the fit layer on it steps back to 14 px inside the fit outline */
  .cm__st :global(.strip__cell),
  .cm__st :global(.strip__cell svg) {
    width: 28px;
    height: 28px;
  }
  .cm__st :global(.strip__cell rect),
  .cm__st :global(.strip__cell path),
  .cm__st :global(.strip__cell circle) {
    vector-effect: non-scaling-stroke;
  }
  .cm__dot {
    display: block;
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: var(--ink-3);
  }
  .cm__dash {
    display: block;
    width: 10px;
    height: 1.5px;
    background: var(--ink-3);
  }
  .cm__f {
    display: none;
    font-family: var(--font-mono);
    font-size: 9px;
    line-height: 1;
    letter-spacing: 0;
    color: var(--ink-2);
  }
  /* fit layer on */
  .cm:has(input[id$='-fit']:checked) .cm__td[data-fit] .cm__cell::before {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: var(--radius-s);
    pointer-events: none;
  }
  .cm:has(input[id$='-fit']:checked) .cm__td[data-fit='fit'] .cm__cell::before {
    border: 1px solid var(--ink-2);
  }
  .cm:has(input[id$='-fit']:checked) .cm__td[data-fit='no-fit'] .cm__cell::before {
    border: 1px dashed var(--bad-ink);
  }
  .cm:has(input[id$='-fit']:checked) .cm__td[data-fit='unknown'] .cm__cell::before {
    border: 1px dotted var(--ink-3);
  }
  .cm:has(input[id$='-fit']:checked) .cm__td[data-fit] .cm__f {
    display: block;
    position: absolute;
    top: 2px;
    right: 2px;
  }
  .cm:has(input[id$='-fit']:checked) .cm__td[data-fit='no-fit'] .cm__f {
    color: var(--bad-ink);
  }
  .cm:has(input[id$='-fit']:checked) .cm__td[data-fit] .cm__st :global(.strip__cell),
  .cm:has(input[id$='-fit']:checked) .cm__td[data-fit] .cm__st :global(.strip__cell svg) {
    width: 14px;
    height: 14px;
  }
  /* legend of the fit layer: the same outline and glyph at 14 px */
  .cm__lfit {
    position: relative;
    border-radius: var(--radius-s);
  }
  .cm__legend-fit[data-fit='fit'] .cm__lfit {
    border: 1px solid var(--ink-2);
  }
  .cm__legend-fit[data-fit='no-fit'] .cm__lfit {
    border: 1px dashed var(--bad-ink);
    color: var(--bad-ink);
  }
  .cm__legend-fit[data-fit='unknown'] .cm__lfit {
    border: 1px dotted var(--ink-3);
  }
  .cm__lfit .cm__f {
    display: block;
    color: inherit;
  }
  .cm__legend-fit[data-fit='fit'] .cm__lfit .cm__f {
    color: var(--ink-2);
  }
  .cm:has(input[id$='-declared']:checked) .cm__td[data-declared='yes'] .cm__cell {
    outline: 1.5px solid var(--ok-text);
  }
  .cm:has(input[id$='-declared']:checked) .cm__td[data-declared='no'] .cm__cell {
    outline: 1.5px dashed var(--bad-ink);
  }
  .cm:has(input[id$='-reg']:checked) tbody tr[data-regression='no']:not(.cm__base) {
    display: none;
  }
  .cm__pop {
    width: min(320px, calc(100vw - 32px));
    margin: 0;
    padding: 12px 14px;
    border: 1px solid var(--line);
    border-radius: var(--radius-m);
    background: var(--bg);
    color: var(--ink);
    box-shadow: var(--shadow-float);
    font-size: 13px;
    line-height: 1.45;
    text-align: left;
    inset: auto;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
  }
  @supports (position-area: bottom) {
    .cm__pop {
      position-area: bottom;
      position-try-fallbacks: flip-block;
      transform: none;
      top: auto;
      left: auto;
      margin: 8px;
    }
  }
  .cm__pop p + p,
  .cm__pop p + a {
    margin-top: 6px;
  }
  .cm__pop a {
    display: inline-block;
    margin-top: 8px;
    font-weight: 500;
  }
  .cm__pophead {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--ink-2);
  }
  .cm__popmeta {
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--ink-2);
  }
  .cm__poperr {
    padding-left: 8px;
    border-left: 2px solid #f32828;
    font-family: var(--font-mono);
    font-size: 11px;
  }
  /* the signal `in isolation` in a popover (24 Oct): an ink-3 edge, the quiet ink of a second signal */
  .cm__popiso {
    padding-left: 8px;
    border-left: 2px solid var(--ink-3);
    color: var(--ink-2);
    overflow-wrap: anywhere;
  }
  .cm__popiso :global(code) {
    font-family: var(--font-mono);
    font-size: 11px;
  }
  .cm__pop a + a {
    margin-left: 12px;
  }
  @media (max-width: 767px) {
    .cm__mod {
      min-width: 180px;
    }
    .cm__loc {
      max-width: 200px;
    }
    .cm__col {
      width: 144px;
      min-width: 144px;
    }
    .cm__sw,
    .cm__how > summary {
      min-height: 44px;
    }
    .cm__modlink {
      min-height: 44px;
    }
    /* phones (spec 6.7, 7.10, review r10): the squares are read, not tapped; the row's one target is its module link,
       44 px tall and as wide as the column, and the script below takes the cells out of the tab order */
    .cm__cell {
      margin: 8px;
      pointer-events: none;
    }
    .cm__cell:hover {
      box-shadow: none;
    }
    .cm__modlink {
      width: 100%;
    }
  }
  /* phones: 150 px module column (title only) + three 64 px line columns, every line visible; 12 px of air on the
     right of the scroll area so the next column never touches the frame */
  @media (max-width: 479px) {
    .cm__scroll {
      padding-right: 12px;
    }
    .cm__mod {
      min-width: 0;
      width: 140px;
      max-width: 140px;
      overflow: hidden;
      padding: 8px 10px !important;
    }
    /* the sigil at 16 px (spec 7.7 D) and the name at 13 px, so the longest word of a name (`Communication`) fits the
       140 px column instead of touching its edge (review r4) */
    .cm__mod .cm__modlink {
      gap: 6px;
      font-size: 13px;
    }
    .cm__mod .cm__sig :global(svg) {
      width: 16px;
      height: 16px;
    }
    .cm__loc {
      display: none;
    }
    .cm__col {
      width: 64px;
      min-width: 64px;
      padding: 10px 4px !important;
    }
    .cm__col .cm__colsub {
      display: none;
    }
    .cm__sentence {
      font-size: 18px;
    }
  }
</style>

<script>
  // phones (spec 6.7: single squares are clickable on the desktop /compat only, review r10): out of the tab order there
  const phone = window.matchMedia('(max-width: 767px)')
  const apply = (): void => {
    for (const b of document.querySelectorAll<HTMLButtonElement>('.cm__cell')) {
      if (phone.matches) b.setAttribute('tabindex', '-1')
      else b.removeAttribute('tabindex')
    }
  }
  apply()
  phone.addEventListener('change', apply)
</script>

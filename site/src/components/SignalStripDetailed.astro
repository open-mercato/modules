---
// Detailed signal strip (spec 6.7, 7.6, 7.7 B.4): per line the state square, a micro ladder of the 9 steps of the
// last receipt and 30 nights of history, plus the state sentence. The whole strip is one `Receipts` button
// (>= 44 px) that the page wires to the receipt drawer (data-receipts-open). With `href` it is a link to the
// Receipts panel that the drawer takes over once scripts run (review r4: without JavaScript a button did nothing).
import type { IndexEntry, Line, Receipt } from '../../../lib/schema/index.ts'
import { ISO_DIFFERS, isoMark, orderLines, stateSentence, stripCells } from '../lib/status.ts'
import type { SentenceOptions } from '../lib/status.ts'
import { lastReceipt, nightMarks, stepMarks, STEPS, whyHtml } from '../lib/receipts.ts'
import { day, nbspDates, shortVersion } from '../lib/format.ts'
import { Square } from '../lib/ui.tsx'
import Icon from './icons/Icon.astro'

interface Props {
  entry: Pick<IndexEntry, 'compat' | 'title'>
  lines: Line[]
  receipts: Receipt[]
  /** IsoDate of the last night shown. */
  end: string
  as?: 'button' | 'div'
  /** Render as a link to this target (progressive: the drawer intercepts the click when scripts run). */
  href?: string
  /** Queue sentence, age gate and quarantine date for the state sentence (from the page's schedule). */
  sentence?: SentenceOptions
  /** A chip after the sentence: `Preview, not CI` when the receipts come from the local preview runner (round 5). */
  note?: string | null
  /** Title of the chip: the one preview sentence (review r6). */
  noteTitle?: string | null
  /** Why a line broke, when its receipt says it plainly (`0.9 and next: GET /api/events needs feature ...`), one each. */
  why?: string[]
  /** The signal `in isolation` next to a verdict, one sentence each (`0.9: In isolation (empty preset): ...`). */
  isolation?: string[]
  /** Static warnings of lines without a verdict (round 14, `0.9: Static check: the module adds the backend route ...`). */
  warn?: string[]
  /** Facts of the receipts the sentence leaves out (a replacement installed in place of core), one sentence each. */
  versions?: string[]
}
const {
  entry,
  lines,
  receipts,
  end,
  as = 'button',
  href,
  sentence: opts = {},
  note = null,
  noteTitle = null,
  why = [],
  isolation = [],
  warn = [],
  versions = [],
} = Astro.props
const NIGHTS = 30
const ordered = orderLines(lines)
const cells = stripCells(entry, ordered, opts.others)
const sentence = stateSentence(entry, ordered, opts)
const rows = ordered.map((l, i) => {
  const r = lastReceipt(receipts, l.key)
  return {
    line: l,
    cell: cells[i]!,
    // a run that judged nothing (test app, our run, Yarn's age gate on a dependency) stopped at a step that is not the
    // module's error: a quiet mark, never the red of a break (round 13, as the paper receipt does since round 5)
    steps: stepMarks(r).map((m) => (m === 'fail' && r?.result.status !== 'broken' ? 'stopped' : m)),
    history: nightMarks(receipts, l.key, end, NIGHTS),
    tag: l.source === 'latest' ? 'latest' : l.source === 'previous' ? 'previous' : 'next',
  }
})
const nightClass = (st: string | null): string => (!st ? 'ssd__night--none' : `ssd__night--${st}`)
const first = new Date(Date.parse(`${end}T00:00:00Z`) - (NIGHTS - 1) * 86_400_000)
const ticks = { from: day(first), to: day(`${end}T00:00:00Z`) }
const Tag = href ? 'a' : as
const aria = [`Receipts. ${cells.map((c) => c.label).join('. ')}.`, sentence, ...why, ...warn, ...isolation, ...versions, ...(note ? [`${note}.`] : [])].join(' ')
const anyIso = cells.some((c) => c.isolation)
// the legend keys the dots the strip draws, grey first, then the ones that differ (as the legends of / and /compat)
const isoMarks = new Set(cells.map((c) => isoMark(c.status, c.isolation?.dot ?? null, !!c.other)))
const isoKeys = (['agree', ...ISO_DIFFERS] as const).filter((m) => isoMarks.has(m))
---

<Tag class="ssd" href={href} type={!href && as === 'button' ? 'button' : undefined} data-receipts-open aria-label={aria}>
  <span class="ssd__rows" aria-hidden="true">
    <span class="ssd__row ssd__row--head">
      <span class="ssd__h">Line</span>
      <span></span>
      <span class="ssd__h">Steps</span>
      <span class="ssd__ticks"><span>{ticks.from}</span><span>30 nights</span><span>{ticks.to}</span></span>
    </span>
    {
      rows.map((row) => (
        <span class="ssd__row">
          <span class="ssd__line">
            <span class="ssd__key">{row.line.key === 'next' ? 'next' : row.line.version}</span>
            <span class="ssd__tag">{row.line.key === 'next' ? <code>{shortVersion(row.line.version)}</code> : row.tag}</span>
          </span>
          <Square status={row.cell.status} step={row.cell.step} other={!!row.cell.other} iso={row.cell.isolation?.dot ?? null} />
          <span class="ssd__ladder" title={STEPS.join(' · ')}>
            {row.steps.map((m, i) => (
              <i class:list={['ssd__tick', `ssd__tick--${m}`]} title={STEPS[i]} />
            ))}
          </span>
          <span class="ssd__hist" title="Last 30 nights in a new app">
            {row.history.map((s) => (
              <i class:list={['ssd__night', nightClass(s)]} />
            ))}
          </span>
        </span>
      ))
    }
  </span>
  <span class="ssd__foot">
    <span class="ssd__sentence">
      {nbspDates(sentence)}
      {why.map((w) => <span class="ssd__why" set:html={nbspDates(whyHtml(w))} />)}
      {warn.map((w) => <span class="ssd__why ssd__why--warn" set:html={nbspDates(whyHtml(w))} />)}
      {isolation.map((w) => <span class="ssd__why ssd__why--iso" set:html={nbspDates(whyHtml(w))} />)}
      {anyIso && <span class="ssd__legend">{isoKeys.map((m) => <span class={`sq-iso-key sq-iso-key--${m}`} aria-hidden="true" />)}Dot: in isolation, an app from the empty preset; grey when it agrees with the square, in color when it differs. The square is a new app.</span>}
      {versions.map((v) => <span class="ssd__why ssd__why--version">{nbspDates(v)}</span>)}
    </span>
    {note && <span class="chip chip--preview ssd__note" title={noteTitle ?? undefined}>{note}</span>}
    <span class="ssd__open">Receipts <Icon name="chevron-down" size={14} /></span>
  </span>
</Tag>

<style>
  .ssd {
    display: grid;
    gap: 0;
    width: 100%;
    min-height: 44px;
    padding: 0;
    border: 1px solid var(--line);
    border-radius: var(--radius-m);
    background: var(--bg);
    color: var(--ink);
    text-align: left;
    font: inherit;
    transition: border-color var(--dur-1) var(--ease);
  }
  a.ssd {
    text-decoration: none;
  }
  button.ssd:hover,
  a.ssd:hover {
    border-color: var(--ink-3);
  }
  .ssd__rows {
    display: grid;
    padding: 6px 0;
  }
  .ssd__row {
    display: grid;
    grid-template-columns: 220px 20px 72px minmax(0, 1fr);
    align-items: center;
    column-gap: 16px;
    padding: 6px 16px;
  }
  .ssd__row--head {
    padding-block: 2px 4px;
  }
  .ssd__h,
  .ssd__ticks {
    font-family: var(--font-mono);
    font-size: 10px;
    line-height: 12px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--ink-2);
    font-variant-numeric: tabular-nums;
  }
  .ssd__ticks {
    display: flex;
    justify-content: space-between;
    padding-left: 13px;
  }
  .ssd__line {
    display: flex;
    align-items: baseline;
    gap: 8px;
    font-family: var(--font-mono);
    font-variant-numeric: tabular-nums;
  }
  .ssd__key {
    font-size: 13px;
  }
  .ssd__tag code {
    font: inherit;
    letter-spacing: 0.02em;
  }
  .ssd__tag {
    font-size: 10px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--ink-2);
    white-space: nowrap;
  }
  .ssd__ladder,
  .ssd__hist {
    display: flex;
    gap: 2px;
    align-items: center;
  }
  .ssd__tick {
    width: 4px;
    height: 12px;
    border-radius: 1px;
    background: var(--ink);
  }
  .ssd__tick--fail {
    background: #f32828;
  }
  .ssd__tick--skipped {
    background: var(--line-strong);
  }
  .ssd__tick--stopped {
    background: var(--ink-3);
  }
  .ssd__tick--none {
    background: transparent;
    box-shadow: inset 0 0 0 1px var(--line-strong);
  }
  /* 30 discrete nights filling the remaining width, oldest first */
  .ssd__hist {
    justify-content: space-between;
    padding-left: 12px;
    border-left: 1px solid var(--line);
    min-height: 16px;
  }
  .ssd__night {
    flex: 1;
    max-width: 14px;
    height: 14px;
    border-radius: 1px;
  }
  /* a night without a result is a quiet 4 px tick in its slot; only nights with a verdict get a square */
  .ssd__night--none {
    background: linear-gradient(var(--line), var(--line)) center / 4px 14px no-repeat;
  }
  .ssd__night--untested,
  .ssd__night--skipped {
    outline: 1px dashed var(--ink-3);
    outline-offset: -1px;
  }
  .ssd__night--verified {
    background: #b4f372;
  }
  .ssd__night--broken {
    background: #f32828;
  }
  /* Open Mercato itself passed that night, on a line that ships the package: the core plate of the Hive (review r9) */
  .ssd__night--quarantine {
    background: #eefb63;
  }
  /* a dependency the age gate held back (round 14): the neutral plate of a night that judged nothing */
  .ssd__night--held {
    background: var(--bg-3);
    box-shadow: inset 0 0 0 1px var(--ink-3);
  }
  .ssd__night--harness-red {
    background: repeating-linear-gradient(135deg, var(--ink-3) 0 1px, transparent 1px 4px);
    box-shadow: inset 0 0 0 1px var(--ink-3);
  }
  .ssd__night--infra-error {
    background: #e7e7e7;
    box-shadow: inset 0 0 0 1px var(--ink-3);
  }
  :global(:root[data-theme='dark']) .ssd__night--infra-error {
    background: #1b1b1b;
  }
  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme='light'])) .ssd__night--infra-error {
      background: #1b1b1b;
    }
  }
  .ssd__foot {
    display: flex;
    align-items: center;
    gap: 16px;
    padding: 10px 16px;
    border-top: 1px solid var(--line);
    background: var(--bg-2);
    border-radius: 0 0 var(--radius-m) var(--radius-m);
  }
  .ssd__sentence {
    flex: 1;
    font-size: 14px;
    color: var(--ink-2);
  }
  /* the one sentence that says why, under the state: the answer before anyone opens a receipt */
  .ssd__why {
    display: block;
    margin-top: 4px;
    color: var(--ink);
  }
  .ssd__why :global(code) {
    font-size: 0.9em;
  }
  .ssd__why--version {
    color: var(--ink-2);
  }
  /* the signal `in isolation` (24 Oct): a second signal, in the quieter ink of the facts, never a verdict */
  .ssd__why--iso {
    color: var(--ink-2);
  }
  .ssd__legend {
    display: block;
    margin-top: 6px;
    font-size: 12px;
    color: var(--ink-2);
  }
  .ssd__open {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 14px;
    font-weight: 500;
    white-space: nowrap;
  }
  .ssd__open :global(svg) {
    transform: rotate(-90deg);
  }
  @media (max-width: 767px) {
    .ssd__row {
      grid-template-columns: minmax(0, 1fr) 14px 52px;
      column-gap: 12px;
    }
    .ssd__hist,
    .ssd__ticks,
    .ssd__row--head {
      display: none;
    }
    .ssd__foot {
      flex-direction: column;
      align-items: flex-start;
      gap: 6px;
    }
  }
</style>

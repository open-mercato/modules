---
// The big search field of the module browser. It filters the cards on this page in the browser (ModuleBrowser's
// script reads #mods-q); without JavaScript the form reloads the page with ?q= and every card is still there.
import Icon from '../icons/Icon.astro'

interface Props {
  placeholder: string
}
const { placeholder } = Astro.props
---

<div class="msearch">
  <form role="search" aria-label="Search modules" method="get" data-mods-form>
    <label class="sr-only" for="mods-q">Search modules</label>
    <span class="msearch__icon"><Icon name="search" size={20} /></span>
    <input
      id="mods-q"
      class="msearch__input"
      type="search"
      name="q"
      placeholder={placeholder}
      autocomplete="off"
      spellcheck={false}
      enterkeyhint="search"
      aria-controls="mods-grid"
    />
  </form>
</div>

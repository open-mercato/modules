---
// One quiet line at the top of every catalog page (navbar of 14 Nov): where you are in the Run menu on the left, in
// the breadcrumbs of the main site's pages ("Home / Product", 12 px Medium, the trail grey, the page black); the data
// stamp and Submit a module on the right. It took over what the old catalog bar held besides its links. No links to
// pages of the menu and not sticky, so it never reads as a second navbar.
import DataStamp from './DataStamp.astro'
import { href } from '../lib/url.ts'
import { sectionName } from '../lib/run-section.ts'
import type { DataAsOf } from '../lib/freshness.ts'

export interface TrailStep {
  label: string
  href: string
}
interface Props {
  /** Site path of the page, or null for the 404 page. */
  path: string | null
  dataAsOf: DataAsOf
  /**
   * The parents of a page deeper in a section (a module page: Modules, then its category), shown after "Run /" as
   * links; false leaves the left side empty for a page that draws its own breadcrumbs (receipts).
   */
  trail?: TrailStep[] | false
}
const { path, dataAsOf, trail } = Astro.props
const name = sectionName(path)
---

<div class="sheet ctx">
  {
    trail === false ? (
      <span />
    ) : trail ? (
      <nav class="ctx__where" aria-label="Breadcrumb">
        Run
        {trail.map((t) => (
          <>
            {' / '}
            <a href={t.href}>{t.label}</a>
          </>
        ))}
      </nav>
    ) : (
      <p class="ctx__where">
        {name ? (
          <>
            Run / <span class="ctx__here">{name}</span>
          </>
        ) : (
          <span class="ctx__here">Run</span>
        )}
      </p>
    )
  }
  <div class="ctx__end">
    <DataStamp dataAsOf={dataAsOf} />
    {path !== '/submit' && <a class="ctx__submit" href={href('/submit')}>Submit a module</a>}
  </div>
</div>

<style>
  .ctx {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: 8px 24px;
    padding: 3rem var(--pad) 0;
  }
  .ctx__where {
    font-size: 0.75rem;
    font-weight: 500;
    line-height: 1.5;
    /* the main site's trail is #9e9e9e (2.7:1); --ink-3 keeps its look at 4.6:1 */
    color: var(--ink-3);
  }
  .ctx__here,
  .ctx__where a:last-child {
    color: var(--ink);
  }
  .ctx__where a {
    color: inherit;
    text-decoration: none;
  }
  .ctx__where a:hover {
    text-decoration: underline;
  }
  .ctx__end {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px 24px;
  }
  /* touch targets of at least 44 px on phones (spec 7.10) */
  @media (max-width: 767px) {
    .ctx__where a,
    .ctx__submit {
      display: inline-flex;
      align-items: center;
      min-height: 44px;
    }
  }
  .ctx__submit {
    font-size: 0.75rem;
    font-weight: 500;
    line-height: 1.5;
  }
</style>

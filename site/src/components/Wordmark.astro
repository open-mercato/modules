---
// Open Mercato wordmark (141x36, from the brand assets) + the MODULES sub-brand chip (spec 1, i3 6).
import svg from './assets/open-mercato-wordmark.svg?raw'
import { href } from '../lib/url.ts'

interface Props {
  /** Height of the wordmark in px. */
  height?: number
  link?: boolean
  chip?: boolean
}
const { height = 28, link = true, chip = true } = Astro.props
const width = Math.round((height * 141) / 36)
const Tag = link ? 'a' : 'span'
---

<Tag class="wm" href={link ? href('/') : undefined} aria-label={link ? 'Open Mercato Modules, home' : undefined}>
  <span class="wm__logo" style={`width:${width}px;height:${height}px`} set:html={svg} />
  {chip && <span class="wm__chip">Modules</span>}
</Tag>

<style>
  .wm {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    color: var(--ink);
    text-decoration: none;
  }
  .wm__logo {
    display: block;
  }
  @media (max-width: 767px) {
    .wm {
      min-height: 44px;
    }
  }
  .wm__logo :global(svg) {
    width: 100%;
    height: 100%;
  }
  /* the sub-brand chip of spec 1: Geist Mono 11 px uppercase, #B4F372, a 7 px chamfer (HELP sub-brand pattern) */
  .wm__chip {
    padding: 2px 8px 2px 9px;
    background: #b4f372;
    color: #0c0c0c;
    font-family: var(--font-mono);
    font-size: 11px;
    line-height: 16px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    clip-path: polygon(0 0, calc(100% - 7px) 0, 100% 7px, 100% 100%, 7px 100%, 0 calc(100% - 7px));
  }
</style>

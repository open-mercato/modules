---
// Open Mercato logo (141x36, from the brand assets), as on openmercato.com. It links the main site by default: the
// catalog is a section of it (look of 13 Nov), and the MODULES chip of the header links the catalog's own home.
import svg from './assets/open-mercato-wordmark.svg?raw'
import { MAIN_SITE_HOME } from '../../../lib/core/main-site.ts'

interface Props {
  /** Height of the logo in px. */
  height?: number
  /** Where the logo leads. */
  to?: string
  label?: string
}
const { height = 36, to = MAIN_SITE_HOME, label = 'Open Mercato home' } = Astro.props
const width = Math.round((height * 141) / 36)
---

<a class="wm" href={to} aria-label={label}>
  <span class="wm__logo" style={`width:${width}px;height:${height}px`} set:html={svg} />
</a>

<style>
  .wm {
    display: inline-flex;
    align-items: center;
    color: var(--ink);
    text-decoration: none;
  }
  .wm__logo {
    display: block;
  }
  @media (max-width: 767px) {
    .wm {
      min-height: 44px;
    }
  }
  .wm__logo :global(svg) {
    width: 100%;
    height: 100%;
  }
</style>

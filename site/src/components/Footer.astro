---
// Footer (spec 7.6, 7.7 A.7), dark like the openmercato.com footer (look of 13 Nov): the catalog's links, the data
// freshness and its provenance on top, the huge outline "Open Mercato" (the letters of the logo, 1 px non-scaling
// stroke), then the line of the main site: the year, its links and the licence. No comparison list and no CTA band.
import outline from './assets/open-mercato-outline.svg?raw'
import github from './assets/github-mark.svg?raw'
import discord from './assets/discord-mark.svg?raw'
import { day, dayTime } from '../lib/format.ts'
import { dataHref, href } from '../lib/url.ts'
import { isPreviewData, type DataAsOf } from '../lib/freshness.ts'
import { PREVIEW_CHIP, PREVIEW_SENTENCE } from '../../../lib/core/source.ts'
import { CATALOG_REPO_URL } from '../../../lib/core/home.ts'
import { MAIN_SITE_FOOTER } from '../../../lib/core/main-site.ts'
import { loadSiteData } from '../../../lib/emit/site-data.ts'

interface Props {
  dataAsOf: DataAsOf
  repoUrl?: string
}
const { dataAsOf, repoUrl = CATALOG_REPO_URL } = Astro.props
// people's links in the row; the data files for agents sit under About this data (review of 26 Oct)
const links = [
  { label: 'Compatibility', url: href('/compat') },
  { label: 'Quality', url: href('/quality') },
  { label: 'For agents', url: href('/for-agents') },
  { label: 'Templates', url: href('/templates') },
  { label: 'GitHub', url: repoUrl },
  { label: 'Submit', url: href('/submit') },
]
const dataLinks = [
  { label: 'modules.json', url: href('/modules.json') },
  { label: 'llms.txt', url: href('/llms.txt') },
  { label: 'MCP', url: href('/for-agents#connect') },
  { label: 'Schema', url: dataHref('/schema/modules-1.json') },
]
// the main site's footer links; GitHub and Discord carry their marks, as there
const marks: Record<string, string> = { GitHub: github, Discord: discord }
const refreshed = dataAsOf.nightly ?? dataAsOf.npm
// the receipts name their runner here too (round 5): a preview run is not nightly CI. The chip carries the one
// preview sentence as its title (review r6); the day without the hour, as in the header stamp
const preview = !!dataAsOf.nightly && isPreviewData(dataAsOf)
// which catalog commit this build shows (finding of 25 Oct: a preview link served a build 40 commits behind main and
// nothing said so); data emitted before the stamp existed has none, and the line is left out
const { meta } = loadSiteData()
const build = meta.build?.commit ? meta.build : null
const year = new Date().getUTCFullYear()
---

<footer class="site-footer">
  <div class="sheet ft">
    <div class="ft__top">
      <div class="ft__cat">
        <a class="ft__name" href={href('/')}>Modules</a>
        <nav class="ft__links" aria-label="Modules, data and project">
          {links.map((l) => <a href={l.url}>{l.label}</a>)}
        </nav>
      </div>
      <div class="ft__data">
        <p>{refreshed ? <>Data refreshed {preview ? day(refreshed) : dayTime(refreshed)}.</> : <>No data yet.</>}</p>
        {/* the provenance for developers, folded (review of 26 Oct: PREVIEW, NOT CI and a commit on every page) */}
        <details class="ft__about">
          <summary>About this data</summary>
          <p>
            Descriptions come from authors. Everything else is measured.{' '}
            {
              preview ? (
                <>
                  Sources: npm, GitHub and a preview run.{' '}
                  <span class="chip chip--preview ft__chip" title={PREVIEW_SENTENCE}>
                    {PREVIEW_CHIP}
                  </span>
                </>
              ) : (
                'Sources: npm, GitHub, nightly CI.'
              )
            }
            {
              build && (
                <span class="ft__build" data-build={build.commit}>
                  {' '}Built from <code>{build.commit}</code>
                  {build.dirty ? ' with local changes' : ''} on {dayTime(meta.generatedAt)}.
                </span>
              )
            }
          </p>
          <p class="ft__alinks">
            {dataLinks.map((l, i) => (
              <>
                {i > 0 && ' · '}
                <a href={l.url}>{l.label}</a>
              </>
            ))}
          </p>
        </details>
      </div>
    </div>
    <div class="ft__giant" set:html={outline} />
    <div class="ft__bottom">
      <p class="ft__small">© {year}</p>
      <nav class="ft__site" aria-label="Open Mercato">
        {
          MAIN_SITE_FOOTER.map((l) => (
            <a href={l.url}>
              {marks[l.label] && <span class="ft__mark" set:html={marks[l.label]} />}
              {l.label}
            </a>
          ))
        }
      </nav>
      <p class="ft__small ft__licence">MIT License</p>
    </div>
  </div>
</footer>

<style>
  /* the dark band runs the width of the window, the rails and the content stay in the sheet, as on openmercato.com */
  .site-footer {
    background: var(--foot);
    color: var(--foot-ink);
    color-scheme: dark;
    --ink: var(--foot-ink);
    --ink-2: var(--foot-ink-2);
    --ink-3: var(--foot-ink-2);
    --rail: var(--foot-line);
    --line: var(--foot-line);
    --line-strong: var(--foot-line);
    --focus: var(--lime);
  }
  .ft {
    padding: 48px 24px 24px;
    overflow: hidden;
    display: grid;
    gap: 40px;
  }
  .ft__top {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 32px;
    align-items: start;
  }
  .ft__cat {
    display: grid;
    gap: 16px;
  }
  .ft__name {
    justify-self: start;
    font-size: 20px;
    line-height: 1.2;
    font-weight: 500;
    letter-spacing: -0.02em;
    text-decoration: none;
  }
  .ft__links {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 24px;
    font-size: 14px;
    font-weight: 500;
  }
  .ft__links a,
  .ft__site a,
  .ft__alinks a {
    color: var(--foot-ink-2);
    text-decoration: none;
    transition: color var(--dur-1) var(--ease);
  }
  .ft__links a:hover,
  .ft__site a:hover,
  .ft__alinks a:hover,
  .ft__name:hover {
    color: var(--foot-ink);
    text-decoration: underline;
    text-underline-offset: 4px;
  }
  /* prose, not a label: sentence case with periods (the DataStamp is the mono label) */
  .ft__data {
    justify-self: end;
    text-align: right;
    font-size: 13px;
    line-height: 1.6;
    color: var(--foot-ink-2);
  }
  .ft__build code {
    font-family: var(--font-mono);
    font-size: 12px;
  }
  .ft__chip {
    margin-left: 6px;
    vertical-align: 1px;
  }
  .ft__about {
    margin-top: 6px;
  }
  .ft__about > summary {
    cursor: pointer;
    color: var(--foot-ink-2);
  }
  .ft__about > summary:hover {
    color: var(--foot-ink);
  }
  .ft__about p {
    max-width: 44ch;
    margin: 6px 0 0 auto;
  }
  /* the signature of openmercato.com: the letters of the logo across the sheet, a hairline on the dark */
  .ft__giant {
    color: var(--foot-giant);
  }
  .ft__giant :global(svg) {
    width: 100%;
    height: auto;
    overflow: visible;
  }
  /* the line of openmercato.com: the year on the left, the links in the middle, the licence on the right */
  .ft__bottom {
    display: grid;
    grid-template-columns: minmax(0, 0.5fr) auto minmax(0, 0.5fr);
    gap: 32px;
    align-items: center;
    padding-top: 16px;
    border-top: 1px solid var(--foot-line);
  }
  .ft__small {
    font-size: 12px;
    color: var(--foot-ink-2);
  }
  .ft__licence {
    text-align: right;
  }
  .ft__site {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 8px 32px;
    font-size: 14px;
    font-weight: 500;
  }
  .ft__site a {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    color: var(--foot-ink);
  }
  .ft__mark {
    display: flex;
  }
  .ft__mark :global(svg) {
    width: 16px;
    height: auto;
  }
  @media (max-width: 991px) {
    .ft__bottom {
      grid-template-columns: 1fr auto;
      gap: 24px;
    }
    .ft__site {
      grid-column: 1 / -1;
      order: -1;
      justify-content: flex-start;
      gap: 8px 24px;
    }
  }
  @media (max-width: 767px) {
    .ft {
      padding: 40px var(--gutter) 16px;
      gap: 32px;
    }
    .ft__top {
      grid-template-columns: 1fr;
      gap: 24px;
    }
    /* phones: a 3-column grid of links, even gaps, each a 44 px target (spec 7.10) */
    .ft__links,
    .ft__site {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 0 16px;
    }
    .ft__links a,
    .ft__site a {
      display: flex;
      align-items: center;
      min-height: 44px;
      border-bottom: 1px solid var(--foot-line);
    }
    .ft__name {
      display: flex;
      align-items: center;
      min-height: 44px;
    }
    .ft__data {
      justify-self: start;
      text-align: left;
    }
    .ft__about p {
      margin-left: 0;
    }
    .ft__about > summary {
      display: flex;
      align-items: center;
      min-height: 44px;
    }
  }
</style>

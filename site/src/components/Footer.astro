---
// The footer of www.openmercato.com, copied (navbar of 14 Nov): the dark band, the huge "Open Mercato" (the letters
// of the logo, a 1 px non-scaling stroke, as faint as there), the folded "Other" list of the main site's pages, then
// its line: the year, its links and the licence. The catalog's own links live in the Run menu of the navbar, and the
// data freshness and its provenance on the About page (DataProvenance), so nothing here is the catalog's own.
import outline from './assets/open-mercato-outline.svg?raw'
import github from './assets/github-mark.svg?raw'
import discord from './assets/discord-mark.svg?raw'
import { MAIN_SITE_FOOTER, MAIN_SITE_FOOTER_NOTE, MAIN_SITE_FOOTER_OTHER } from '../../../lib/core/main-site.ts'

// the main site's footer links; GitHub and Discord carry their marks, as there
const marks: Record<string, string> = { GitHub: github, Discord: discord }
const external = (url: string): boolean => !url.startsWith('https://www.openmercato.com/')
const year = new Date().getUTCFullYear()
---

<footer class="site-footer">
  <div class="sheet ft">
    <div class="ft__giant" set:html={outline} />
    <details class="ft__other">
      <summary>Other<span class="ft__plus" aria-hidden="true">+</span></summary>
      <nav class="ft__groups" aria-label="More Open Mercato solutions">
        {
          MAIN_SITE_FOOTER_OTHER.map((g) => (
            <div class="ft__group">
              <p class="ft__label">{g.label}</p>
              {g.links.map((l) => (
                <a href={l.url}>{l.label}</a>
              ))}
            </div>
          ))
        }
      </nav>
    </details>
    <div class="ft__bottom">
      <p class="ft__small">© {year}</p>
      <nav class="ft__site" aria-label="Footer">
        {
          MAIN_SITE_FOOTER.map((l) => (
            <a href={l.url} target={external(l.url) ? '_blank' : undefined} rel={external(l.url) ? 'noopener' : undefined}>
              {marks[l.label] && <span class="ft__mark" set:html={marks[l.label]} />}
              {l.label}
            </a>
          ))
        }
      </nav>
      <p class="ft__small ft__licence">{MAIN_SITE_FOOTER_NOTE}</p>
    </div>
  </div>
</footer>

<style>
  /* the dark band runs the width of the window, the rails and the content stay in the sheet, as on openmercato.com */
  .site-footer {
    background: var(--foot);
    color: var(--foot-ink);
    color-scheme: dark;
    --ink: var(--foot-ink);
    --ink-2: var(--foot-ink-2);
    --ink-3: var(--foot-ink-2);
    --rail: var(--foot-line);
    --line: var(--foot-line);
    --line-strong: var(--foot-line);
    --focus: #e7ee8c;
  }
  /* .footer_component > .section-padding: a hairline on top, then a column 32 px apart */
  .ft {
    display: flex;
    flex-direction: column;
    gap: 32px;
    padding: 1rem var(--pad) 32px;
    border-top: 1px solid var(--foot-line);
    overflow: hidden;
  }
  /* the signature of openmercato.com: the letters of the logo across the sheet, a hairline on the dark */
  .ft__giant {
    margin-top: 4rem;
    padding-bottom: 1.5rem;
    color: var(--foot-giant);
  }
  .ft__giant :global(svg) {
    width: 100%;
    height: auto;
    overflow: visible;
  }
  /* "Other +": hairlines above and below, a plus that turns 45 degrees when open */
  .ft__other {
    margin: -4px 0;
    border-block: 1px solid #ffffff35;
  }
  .ft__other > summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    padding: 19px 0;
    font-size: 16px;
    font-weight: 500;
    cursor: pointer;
    list-style: none;
  }
  .ft__other > summary::-webkit-details-marker {
    display: none;
  }
  .ft__plus {
    font-size: 23px;
    line-height: 1;
    font-weight: 400;
    transition: transform 0.2s;
  }
  .ft__other[open] .ft__plus {
    transform: rotate(45deg);
  }
  .ft__groups {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 32px;
    padding: 12px 0 32px;
  }
  .ft__group {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 10px;
    min-width: 0;
  }
  .ft__label {
    margin: 0 0 9px;
    font-size: 14px;
    line-height: 1.4;
    font-weight: 500;
    letter-spacing: 0;
  }
  .ft__group a {
    font-size: 13px;
    line-height: 1.55;
    color: #cdd2c7;
    text-decoration: none;
    overflow-wrap: anywhere;
  }
  .ft__group a:hover {
    color: #e7ee8c;
    text-decoration: underline;
    text-underline-offset: 4px;
  }
  /* the line of openmercato.com: the year on the left, the links in the middle, the licence on the right */
  .ft__bottom {
    display: grid;
    grid-template-columns: 0.5fr 1fr 0.5fr;
    gap: 2rem;
    align-items: center;
  }
  .ft__small {
    font-size: 12px;
    line-height: 1.5;
  }
  .ft__licence {
    text-align: right;
  }
  /* one line on a wide screen: the row sets the width of its column and the side texts wrap instead, as there */
  .ft__site {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 2rem;
  }
  .ft__site a {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--foot-ink);
    text-decoration: none;
  }
  .ft__mark {
    display: flex;
  }
  .ft__mark :global(svg) {
    width: 16px;
    height: auto;
  }
  @media (max-width: 991px) {
    .ft__groups {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 30px;
    }
    .ft__bottom {
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      align-items: center;
    }
    .ft__site {
      order: -1;
    }
    .ft__licence {
      text-align: center;
    }
  }
  @media (max-width: 767px) {
    .ft__site {
      order: 3;
      flex-wrap: wrap;
      gap: 1.5rem;
    }
  }
  @media (max-width: 479px) {
    .ft__groups {
      grid-template-columns: 1fr;
      gap: 28px;
    }
    .ft__group a {
      font-size: 14px;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .ft__plus {
      transition: none;
    }
  }
</style>

{
  "kind": "collectionType",
  "collectionName": "landings",
  "info": {
    "singularName": "landing",
    "pluralName": "landings",
    "displayName": "Landing",
    "description": "Published changes are on the site when the next site build ends, a minute after the last publish at the earliest. Until the www switch the site is modules.openmercato.com; www.openmercato.com still shows the frozen Webflow pages."
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "slug": {
      "type": "uid",
      "required": true,
      "regex": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "webflowId": {
      "type": "string",
      "regex": "^[0-9a-f]{24}$"
    },
    "language": {
      "type": "enumeration",
      "enum": ["en", "pl"],
      "required": true
    },
    "kind": {
      "type": "enumeration",
      "enum": ["alternative", "industry"],
      "required": true
    },
    "competitor": {
      "type": "string"
    },
    "alternateOf": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::landing.landing"
    },
    "seo": {
      "type": "component",
      "component": "shared.seo",
      "repeatable": false,
      "required": true
    },
    "hero": {
      "type": "component",
      "component": "landing.hero",
      "repeatable": false,
      "required": true
    },
    "sectionNav": {
      "type": "component",
      "component": "landing.nav-item",
      "repeatable": true
    },
    "pains": {
      "type": "component",
      "component": "landing.pains",
      "repeatable": false
    },
    "features": {
      "type": "component",
      "component": "landing.features",
      "repeatable": false
    },
    "capabilities": {
      "type": "component",
      "component": "landing.capabilities",
      "repeatable": false
    },
    "comparison": {
      "type": "component",
      "component": "landing.comparison",
      "repeatable": false
    },
    "demo": {
      "type": "component",
      "component": "landing.demo",
      "repeatable": false
    },
    "steps": {
      "type": "component",
      "component": "landing.steps",
      "repeatable": false
    },
    "faq": {
      "type": "component",
      "component": "landing.faq",
      "repeatable": false,
      "required": true
    },
    "cta": {
      "type": "component",
      "component": "landing.cta",
      "repeatable": false,
      "required": true
    },
    "sources": {
      "type": "component",
      "component": "landing.sources",
      "repeatable": false
    },
    "related": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::landing.landing"
    }
  }
}

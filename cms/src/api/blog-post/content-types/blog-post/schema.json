{
  "kind": "collectionType",
  "collectionName": "blog_posts",
  "info": {
    "singularName": "blog-post",
    "pluralName": "blog-posts",
    "displayName": "Blog post",
    "description": "Published changes are on the site when the next site build ends, a minute after the last publish at the earliest. Until the www switch the site is modules.openmercato.com; www.openmercato.com still shows the frozen Webflow pages."
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "slug": {
      "type": "uid",
      "required": true,
      "regex": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "webflowId": {
      "type": "string",
      "regex": "^[0-9a-f]{24}$"
    },
    "title": {
      "type": "string",
      "required": true
    },
    "description": {
      "type": "text",
      "required": true
    },
    "date": {
      "type": "datetime",
      "required": true
    },
    "updated": {
      "type": "datetime"
    },
    "author": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::author.author"
    },
    "category": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::blog-category.blog-category"
    },
    "featured": {
      "type": "boolean",
      "default": false
    },
    "thumbnail": {
      "type": "component",
      "component": "shared.image",
      "repeatable": false
    },
    "seo": {
      "type": "component",
      "component": "shared.seo-override",
      "repeatable": false
    },
    "body": {
      "type": "richtext",
      "required": true
    }
  }
}

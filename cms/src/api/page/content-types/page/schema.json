{
  "kind": "collectionType",
  "collectionName": "pages",
  "info": {
    "singularName": "page",
    "pluralName": "pages",
    "displayName": "Page",
    "description": "Published changes are on the site when the next site build ends, a minute after the last publish at the earliest. Until the www switch the site is modules.openmercato.com; www.openmercato.com still shows the frozen Webflow pages."
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "slug": {
      "type": "uid",
      "required": true,
      "regex": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "webflowId": {
      "type": "string",
      "regex": "^[0-9a-f]{24}$"
    },
    "seo": {
      "type": "component",
      "component": "shared.seo",
      "repeatable": false,
      "required": true
    },
    "jsonLd": {
      "type": "component",
      "component": "page.json-ld",
      "repeatable": false
    },
    "siteCta": {
      "type": "boolean",
      "default": true
    },
    "blocks": {
      "type": "dynamiczone",
      "components": [
        "block.copy",
        "block.hero",
        "block.logos",
        "block.features",
        "block.carousel",
        "block.video",
        "block.stats",
        "block.team",
        "block.quote",
        "block.steps",
        "block.faq",
        "block.cta",
        "block.prose",
        "block.list",
        "block.legacy"
      ]
    }
  }
}

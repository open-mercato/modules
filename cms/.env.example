# The keys of cms/.env on the Strapi host (spec, No Cezar path in the site build). Copy to cms/.env (mode 600) and fill
# every value; cms/.env is never committed. There is no API token encryption key: a token is shown once at creation.

# public address of the admin and the API (Q1)
PUBLIC_URL=https://cms.openmercato.com

# Strapi secrets: four random values for APP_KEYS (comma separated), one each for the rest
APP_KEYS=
API_TOKEN_SALT=
ADMIN_JWT_SECRET=
TRANSFER_TOKEN_SALT=
JWT_SECRET=

# PostgreSQL 17 of compose.yaml (A6)
DATABASE_NAME=strapi
DATABASE_USERNAME=strapi
DATABASE_PASSWORD=

# The four personal Super Admin accounts of Q9 (the owner, the infrastructure owner, the two editors), as
# `First Last <address>` separated by commas. No role address (admin@, marketing@) and no address twice; no password
# here: the start logs an invitation link per new account, and each person sets the first password through it.
CMS_ADMIN_ACCOUNTS=Owner Name <owner@example.com>, Infra Name <infra@example.com>, Editor One <editor-one@example.com>, Editor Two <editor-two@example.com>

# The publish hook (Q4): a fine-grained token of the machine account, this repository only, Actions read and write
GITHUB_DISPATCH_TOKEN=

# Cloudflare Tunnel (Q2), the token of the tunnel the infrastructure owner creates
TUNNEL_TOKEN=

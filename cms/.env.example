# The keys of cms/.env on the Strapi host (spec, No Cezar path in the site build). Copy to cms/.env (mode 600) and fill
# every value; cms/.env is never committed. There is no API token encryption key: a token is shown once at creation.

# public address of the admin and the API (Q1)
PUBLIC_URL=https://cms.openmercato.com

# Strapi secrets: four random values for APP_KEYS (comma separated), one each for the rest
APP_KEYS=
API_TOKEN_SALT=
ADMIN_JWT_SECRET=
TRANSFER_TOKEN_SALT=
JWT_SECRET=

# PostgreSQL 17 of compose.yaml (A6)
DATABASE_NAME=strapi
DATABASE_USERNAME=strapi
DATABASE_PASSWORD=

# Cloudflare Tunnel (Q2), the token of the tunnel the infrastructure owner creates
TUNNEL_TOKEN=

        {
          "id": 2,
          "anchor": null,
          "layout": "pricing-qa",
          "label": null,
          "eyebrow": null,
          "title": "Licensing questions",
          "lead": null,
          "note": null,
          "primary": null,
          "secondary": null,
          "items": [
            {
              "id": 396,
              "question": "Can I use Free in production?",
              "answer": "Yes. The MIT license lets you build, modify and run commercial applications on the open-source core. You choose the infrastructure and cover its running costs. [Read the MIT license.](https://github.com/open-mercato/open-mercato/blob/main/LICENSE)"
            },
            {
              "id": 397,
              "question": "How does Enterprise pricing work?",
              "answer": "Basic starts at €3,000 net per month for companies below €25M in annual revenue. Medium is €10,000 net per month for companies from €25M to €250M. Above €250M, we quote the license individually. Basic and Medium each cover one project with unlimited users and servers. You can buy the license on its own."
            },
            {
              "id": 398,
              "question": "What happens if we don’t renew?",
              "answer": "If you’ve paid in full and continue usage reporting, you can keep running the retained version in the same project. Your own application code stays in your repository. New enterprise releases, security patches and support end with the subscription. [Read the enterprise terms.](https://github.com/open-mercato/open-mercato/blob/main/packages/enterprise/TERMS.md)"
            }
          ],
          "__component": "block.faq"

{
  "schema": 1,
  "name": "b2b-portal",
  "description": "B2B self-service portal with quotes and customer accounts.",
  "openMercato": "0.9.x",
  "env": [
    {
      "name": "OPENAI_API_KEY",
      "description": "Used by the AI assistant.",
      "link": "https://platform.openai.com/api-keys"
    }
  ],
  "modules": [
    { "id": "customers", "from": "@open-mercato/core" },
    { "id": "ai_assistant", "from": "@open-mercato/ai-assistant", "package": "@open-mercato/ai-assistant@0.9.0" },
    { "id": "quotes_portal", "from": "@app" },
    {
      "id": "storage_s3",
      "from": "@open-mercato/storage-s3",
      "package": "@open-mercato/storage-s3@0.9.0",
      "when": "OM_ENABLE_STORAGE_S3"
    }
  ],
  "createdWith": { "tool": "create-mercato-template", "version": "0.1.0" }
}

---
// The implementation steps of a landing (`#migration`, `omlp-steps`): a heading and a numbered list.
import type { CountValues } from '../../../../lib/core/www-tokens.ts'
import type { LandingData } from '../../lib/landings.ts'
import Heading from './Heading.astro'
import Rich from './Rich.astro'

interface Props {
  steps: NonNullable<LandingData['steps']>
  counts: CountValues
}
const { steps, counts } = Astro.props
---

<section id="migration" class="omlp-section">
  <div class="omlp-wrap">
    <Heading eyebrow={steps.eyebrow} title={steps.title} counts={counts} />
    <ol role="list" class="omlp-steps">
      {
        steps.items.map((i) => (
          <li class="omlp-step">
            <h3>{i.title}</h3>
            <p>
              <Rich md={i.body} counts={counts} />
            </p>
          </li>
        ))
      }
    </ol>
  </div>
</section>

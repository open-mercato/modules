---
// The pains of a landing (`#needs`, `omlp-pains`): a heading and cards of a title, a body and the card's illustration.
import type { CountValues } from '../../../../lib/core/www-tokens.ts'
import type { LandingData } from '../../lib/landings.ts'
import CardArt from './CardArt.astro'
import Heading from './Heading.astro'
import Rich from './Rich.astro'

interface Props {
  pains: NonNullable<LandingData['pains']>
  counts: CountValues
}
const { pains, counts } = Astro.props
---

<section id="needs" class="omlp-section">
  <div class="omlp-wrap">
    <Heading eyebrow={pains.eyebrow} title={pains.title} counts={counts} />
    <div class="omlp-pains">
      {
        pains.items.map((i) => (
          <article class="omlp-pain">
            <h3>{i.title}</h3>
            <p>
              <Rich md={i.body} counts={counts} />
            </p>
            {i.art && <CardArt art={i.art} />}
          </article>
        ))
      }
    </div>
  </div>
</section>

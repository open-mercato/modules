---
// Who wrote a post and when: the author (a post may have none), the publication date and the last update.
import { dayYear } from '../../../../site/src/lib/format.ts'

interface Props {
  author?: string
  date: Date
  updated?: Date
}
const { author, date, updated } = Astro.props
---

<p class="byline t-small t-muted">
  {author && <span class="byline__author">By {author}</span>}
  <time datetime={date.toISOString()}>{dayYear(date)}</time>
  {
    updated && (
      <span>
        Updated <time datetime={updated.toISOString()}>{dayYear(updated)}</time>
      </span>
    )
  }
</p>

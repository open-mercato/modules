---
// A case study in a list (/case-studies and the related case studies): thumbnail, categories, title with the link and
// description. Its link sends the live CTA event cta_cases_open_story (lib/core/cta.ts), as the Webflow card did.
import type { CaseStudyCardData } from '../../lib/case-studies.ts'

interface Props {
  cs: CaseStudyCardData
}
const { cs } = Astro.props
---

<article class="post-card">
  {cs.thumbnail && <img class="post-card__img" src={cs.thumbnail.src} alt={cs.thumbnail.alt} loading="lazy" decoding="async" />}
  <div class="post-card__body">
    {
      cs.categories.length > 0 && (
        <ul class="chips">
          {cs.categories.map((c) => (
            <li class="chip chip--line">{c}</li>
          ))}
        </ul>
      )
    }
    <h3 class="post-card__title"><a href={cs.href} data-cta-placement="cases" data-cta-action="open_story">{cs.title}</a></h3>
    <p class="post-card__desc">{cs.description}</p>
  </div>
</article>

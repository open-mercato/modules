---
// The /architecture "building blocks" section as the live one is: the colour divider with the block's `label`, the
// sticky tagline and heading, and one card per item: its title, its text (`body`, paragraphs and a list), its tags
// (`points`) and a quote (`note`) whose *italic* end is the source, set on a line of its own in the tagline style.
// The lists have no role="list", which the live ones carry: the catalog's base.css drops the bullets of such a list.
import { fillCounts } from '../../../../lib/core/www-tokens.ts'
import Wrap from './Wrap.astro'
import { headingHtml, inline, markdownHtml } from '../../lib/inline-markdown.ts'
import type { BlockProps } from '../../lib/pages.ts'

type Props = BlockProps<'features'>
const { block, counts } = Astro.props
const t = (s: string): string => fillCounts(s, counts)
/** A quote with its source: the trailing `<em>` becomes the live `<br>` and tagline `<span>`. */
const quote = (s: string): string =>
  inline(t(s)).replace(/\s*<em>(.*)<\/em>$/, '<br/><span class="text-style-tagline">$1</span>')
---

<Wrap>
  <section class="section" id={block.id}>
    <div class="section-padding">
      {
        block.label && (
          <div class="color-divider_component">
            <div class="color-divider_gradient-line" />
            <div class="color-divider_line" />
            <div class="color-divider_content">
              <div class="text-style-tagline text-color-secondary">{t(block.label)}</div>
            </div>
          </div>
        )
      }
      <div class="header_component is-grid">
        <div class="header_content-wrapper">
          <div class="header_content is-sticky">
            {
              block.eyebrow && (
                <div class="label_component">
                  <div class="text-style-tagline text-color-secondary">{t(block.eyebrow)}</div>
                </div>
              )
            }
            {block.title && <h2 class="heading-style-h3" set:html={headingHtml(t(block.title))} />}
          </div>
        </div>
        <div class="bg-grid_component">
          {
            block.items.map((i) => (
              <div class="bg-grid_card">
                <div class="bg-grid_card-content">
                  {i.title && (
                    <div class="bg-grid_heading-wrapper">
                      <h3 class="text-size-medium text-weight-medium">{t(i.title)}</h3>
                    </div>
                  )}
                  {i.body && (
                    <>
                      <div class="spacer-1rem" />
                      <div
                        class="text-rich-text text-color-secondary w-richtext"
                        set:html={markdownHtml(t(i.body))}
                      />
                    </>
                  )}
                  {i.points && (
                    <>
                      <div class="spacer-small" />
                      <div class="label-list_list">
                        {i.points.map((p) => (
                          <div class="label-list_item" set:html={inline(t(p))} />
                        ))}
                      </div>
                    </>
                  )}
                  {i.note && (
                    <>
                      <div class="spacer-small" />
                      <p class="text-color-secondary" set:html={quote(i.note)} />
                    </>
                  )}
                </div>
              </div>
            ))
          }
        </div>
      </div>
    </div>
  </section>
</Wrap>

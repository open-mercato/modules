---
// The case studies of the home page as live has them (`case-slider_component`, styled by site.css and
// www/src/styles/webflow/pages/home.css): the heading, the link to all of them (`primary`), the two buttons that move
// the row one card (www/src/scripts/case-slider.ts, as on a case study page) and one card per item: image, title, body
// and its cta, a link to a published case study (a build stops on any other). CTA events as the live map names them:
// cases/open_story on a card, cases/view_all on the link to /case-studies.
import { getCollection } from 'astro:content'
import { ctaAttrs } from '../../../../lib/core/cta.ts'
import { fillCounts } from '../../../../lib/core/www-tokens.ts'
import {
  CASE_STUDIES_PATH,
  CASE_STUDY_PREFIX,
  publishedCaseStudies,
  type CaseStudyEntry,
} from '../../lib/case-studies.ts'
import { inline } from '../../lib/inline-markdown.ts'
import type { BlockProps } from '../../lib/pages.ts'
import { ARROW_ICON, NEXT_ICON, PREV_ICON } from '../../lib/webflow-icons.ts'

type Props = BlockProps<'carousel'>
const { block, counts, page } = Astro.props
const t = (s: string): string => fillCounts(s, counts)

const all = (await getCollection('caseStudies')) as unknown as CaseStudyEntry[]
const published = new Set(publishedCaseStudies(all).map((c) => c.id))
for (const [i, item] of block.items.entries()) {
  const href = item.cta?.href ?? ''
  if (!href.startsWith(CASE_STUDY_PREFIX) || !published.has(href.slice(CASE_STUDY_PREFIX.length)))
    throw new Error(`www/content/pages/${page}.yaml ${block.layout} items.${i}: ${href} is not a published case study`)
}
const viewAll = block.primary
---

<div class="main-wrapper padding-global">
  <div class="container-main">
    <section class="section overflow-hidden" id={block.id}>
      <div class="case-slider_component" data-case-slider>
        <div class="case-slider_navigation">
          <div class="case-slider_header">
            {block.title && <h2 class="heading-style-h4">{t(block.title)}</h2>}
          </div>
          <div class="case-slider_buttons">
            {
              viewAll && (
                <div class="button-group">
                  <a
                    href={viewAll.href}
                    class="button is-arrow is-blog w-inline-block"
                    {...(viewAll.href === CASE_STUDIES_PATH ? ctaAttrs('view_all', 'cases') : {})}
                  >
                    <div>{t(viewAll.label)}</div>
                    <div class="button_icon is-arrow w-embed" set:html={ARROW_ICON} />
                  </a>
                </div>
              )
            }
            <button type="button" class="case-slider_button is-prev" aria-label="Previous case study" data-step="-1">
              <span class="case-slider_button-icon" aria-hidden="true" set:html={PREV_ICON} />
            </button>
            <button type="button" class="case-slider_button is-next" aria-label="Next case study" data-step="1">
              <span class="case-slider_button-icon" aria-hidden="true" set:html={NEXT_ICON} />
            </button>
          </div>
        </div>
        <div class="spacer-medium"></div>
        <div class="case_slider">
          <div class="swiper is-case">
            <div role="list" class="swiper-wrapper is-case">
              {
                block.items.map((item) => (
                  <div role="listitem" class="swiper-slide is-case">
                    <div class="case-list_card">
                      <a
                        href={item.cta!.href}
                        class="case-list_card-link"
                        aria-label={item.title && t(item.title)}
                        {...ctaAttrs('open_story', 'cases')}
                      />
                      <div class="case-list_thumbnail-wrapper">
                        {item.image && (
                          <img src={item.image.src} loading="lazy" alt={item.image.alt} class="case-list_thumbnail" />
                        )}
                      </div>
                      <div class="case-list_card-content-wrapper">
                        <div class="case_card-content">
                          {item.title && <h3 class="heading-style-h5">{t(item.title)}</h3>}
                          <div class="spacer-1rem" />
                          {item.body && <p class="text-color-secondary" set:html={inline(t(item.body))} />}
                          <div class="spacer-medium" />
                          <div class="button-group">
                            <div class="button is-arrow is-blog">
                              <div>{t(item.cta!.label)}</div>
                              <div class="button_icon is-arrow w-embed" set:html={ARROW_ICON} />
                            </div>
                          </div>
                        </div>
                      </div>
                    </div>
                  </div>
                ))
              }
            </div>
          </div>
        </div>
      </div>
    </section>
  </div>
</div>

<script>
  import '../../scripts/case-slider.ts'
</script>

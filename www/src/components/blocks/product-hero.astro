---
// The header of /product as live has it: the breadcrumb (Home / the block's `eyebrow`), the heading, the lead and two
// buttons, the first with the GitHub mark when it links the repository.
import { MAIN_SITE_GITHUB } from '../../../../lib/core/main-site.ts'
import { fillCounts } from '../../../../lib/core/www-tokens.ts'
import Crumbs from '../Crumbs.astro'
import Wrap from './Wrap.astro'
import { headingHtml, inline } from '../../lib/inline-markdown.ts'
import { pagePath, type BlockProps } from '../../lib/pages.ts'
import github from './product-github.svg?raw'

type Props = BlockProps<'hero'>
const { block, counts, page } = Astro.props
const t = (s: string): string => fillCounts(s, counts)
const buttons = [block.primary, block.secondary]
---

<Wrap>
  <section class="section" id={block.id}>
    <div class="section-padding">
      <div class="header_component">
        <div class="header_content">
          {block.eyebrow && <Crumbs current={{ name: t(block.eyebrow), href: pagePath(page) }} />}
          <h1 set:html={headingHtml(t(block.title))} />
          {
            block.lead && (
              <>
                <div class="spacer-small" />
                <div class="max-width-47rem">
                  <p class="text-color-secondary" set:html={inline(t(block.lead))} />
                </div>
              </>
            )
          }
          {
            (block.primary || block.secondary) && (
              <>
                <div class="spacer-medium" />
                <div class="button-group">
                  {buttons.map(
                    (b, i) =>
                      b &&
                      (b.href.startsWith(MAIN_SITE_GITHUB) ? (
                        <a href={b.href} target="_blank" class="button is-icon w-inline-block">
                          <div class="button_icon w-embed" set:html={github} />
                          <div>{t(b.label)}</div>
                        </a>
                      ) : (
                        <a
                          href={b.href}
                          target={b.href.startsWith('https:') ? '_blank' : undefined}
                          class:list={['button', i > 0 && 'is-secondary', 'w-inline-block']}
                        >
                          <div>{t(b.label)}</div>
                        </a>
                      )),
                  )}
                </div>
              </>
            )
          }
        </div>
      </div>
    </div>
  </section>
</Wrap>

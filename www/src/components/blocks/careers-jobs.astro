---
// "Open positions" of /careers as live: the heading, then one link per open job of the `jobs` collection (drafts left
// out, in list order) to /careers-jobs/<slug>: its title, location and kind of employment.
import { fillCounts } from '../../../../lib/core/www-tokens.ts'
import { EMPLOYMENT_TYPE_LABELS } from '../../../../lib/schema/www-content.ts'
import Wrap from './Wrap.astro'
import { headingHtml } from '../../lib/inline-markdown.ts'
import { jobData } from '../../lib/collections-data.ts'
import { jobPath } from '../../lib/jobs.ts'
import type { BlockProps } from '../../lib/pages.ts'

type Props = BlockProps<'list'>
const { block, counts } = Astro.props
const t = (s: string): string => fillCounts(s, counts)
const jobs = (await jobData()).filter((j) => j.data.open).slice(0, block.limit)
---

<Wrap>
  <section class="section no-bottom-border" id={block.id}>
    <div class="section-padding">
      <div class="header_component">
        <div class="header_content max-width-36rem">
          <div class="max-width-33rem">
            {block.title && <h2 class="heading-style-h3" set:html={headingHtml(t(block.title))} />}
          </div>
        </div>
      </div>
      <div class="spacer-large" />
      <div class="w-dyn-list">
        <div role="list" class="w-dyn-items">
          {
            jobs.map((j) => (
              <div role="listitem" class="w-dyn-item">
                <a href={jobPath(j.id)} class="border-grid_card-content w-inline-block">
                  <h3 class="text-size-large">{j.data.title}</h3>
                  <div class="spacer-1rem" />
                  <div class="button-group">
                    <p class="text-style-tagline text-color-secondary">{j.data.location}</p>
                    <p class="text-style-tagline text-color-secondary">{EMPLOYMENT_TYPE_LABELS[j.data.employmentType]}</p>
                  </div>
                </a>
              </div>
            ))
          }
        </div>
      </div>
    </div>
  </section>
</Wrap>

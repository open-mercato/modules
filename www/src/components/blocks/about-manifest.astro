---
// The manifesto of /about as live: a dark band with the colour divider (the block's `label`), the eyebrow, the heading
// and the paragraphs of `markdown` in large type, an empty line between two paragraphs as the live text has.
import { fillCounts } from '../../../../lib/core/www-tokens.ts'
import Wrap from './Wrap.astro'
import { headingHtml } from '../../lib/inline-markdown.ts'
import type { BlockProps } from '../../lib/pages.ts'
import { richParts } from './about-rich.ts'

type Props = BlockProps<'prose'>
const { block, counts } = Astro.props
const t = (s: string): string => fillCounts(s, counts)
const html = richParts(t(block.markdown), false)
  .flatMap((p) => (p.kind === 'p' ? [`<p>${p.html}</p>`] : []))
  .join('<p>‍</p>')
---

<Wrap tone="dark">
  <div class="section is-manifesto" id={block.id}>
    <div class="section-padding">
      {
        block.label && (
          <div class="color-divider_component">
            <div class="color-divider_gradient-line" />
            <div class="color-divider_line is-dark" />
            <div class="color-divider_content">
              <div class="text-style-tagline text-color-additional">{t(block.label)}</div>
            </div>
          </div>
        )
      }
      <div class="header_component max-width-50rem">
        <div class="header_content max-width-45rem">
          {
            block.eyebrow && (
              <div class="label_component">
                <div class="text-style-tagline text-color-additional">{t(block.eyebrow)}</div>
              </div>
            )
          }
          {block.title && <h2 set:html={headingHtml(t(block.title))} />}
          <div class="max-width-33rem" />
          <div class="spacer-small" />
          <div class="max-width-42rem">
            <div class="text-size-large text-color-additional w-richtext" set:html={html} />
          </div>
        </div>
      </div>
    </div>
  </div>
</Wrap>

---
// "Building for scalable delivery" of /about as live: the eyebrow and heading with the body beside them, then one
// card per item in a grid of two (its icon above the title, then the body).
import { fillCounts } from '../../../../lib/core/www-tokens.ts'
import Wrap from './Wrap.astro'
import { headingHtml } from '../../lib/inline-markdown.ts'
import type { BlockProps } from '../../lib/pages.ts'
import { richInline } from './about-rich.ts'

type Props = BlockProps<'features'>
const { block, counts } = Astro.props
const t = (s: string): string => fillCounts(s, counts)
---

<Wrap tone="white">
  <section class="section no-bottom-border" id={block.id}>
    <div class="section-padding">
      <div class="header_component is-flex">
        <div class="header_content max-width-26rem">
          {
            block.eyebrow && (
              <div class="label_component">
                <div class="text-style-tagline text-color-secondary">{t(block.eyebrow)}</div>
              </div>
            )
          }
          <div class="max-width-22rem">
            {block.title && <h2 class="heading-style-h3" set:html={headingHtml(t(block.title))} />}
          </div>
        </div>
        {
          block.body && (
            <div class="max-width-33rem">
              <p class="text-color-secondary" set:html={richInline(t(block.body), false)} />
            </div>
          )
        }
      </div>
      <div class="spacer-large" />
      <div class="bg-grid_component is-2-col">
        {
          block.items.map((item) => (
            <div class="bg-grid_card">
              <div class="bg-grid_card-content">
                <div class="bg-grid_heading-wrapper is-vertical">
                  {item.icon && (
                    <div class="icon-embed-small w-embed">
                      <img src={item.icon.src} alt={item.icon.alt} width="32" height="32" />
                    </div>
                  )}
                  {item.title && <h3 class="text-size-medium text-weight-medium">{t(item.title)}</h3>}
                </div>
                <div class="spacer-1rem" />
                {item.body && <p class="text-color-secondary" set:html={richInline(t(item.body), false)} />}
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </section>
</Wrap>

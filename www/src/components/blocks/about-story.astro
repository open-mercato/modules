---
// The two-column story section of /about ("The story") and /partners ("Partner tiers") as live: on the left the
// sticky eyebrow, heading and lead; on the right one card per item with an `eyebrow` (its colour label, then the
// title, the body's paragraphs and lists, and the item's `image` as the badge of a partner tier), and at the end the
// green box: the item without an eyebrow (its title and body) with the block's `primary` and `secondary` as its links.
import { fillCounts } from '../../../../lib/core/www-tokens.ts'
import Wrap from './Wrap.astro'
import { headingHtml } from '../../lib/inline-markdown.ts'
import { ARROW_ICON } from '../../lib/webflow-icons.ts'
import type { BlockProps } from '../../lib/pages.ts'
import { richInline, richParts } from './about-rich.ts'

type Props = BlockProps<'features'>
const { block, counts } = Astro.props
const t = (s: string): string => fillCounts(s, counts)
const COLOURS = ['is-violet', 'is-yellow', 'is-green', 'is-dark-green']
const cards = block.items.filter((i) => i.eyebrow !== undefined)
const box = block.items.find((i) => i.eyebrow === undefined)
const links = [block.primary, block.secondary].filter((c) => c !== undefined)
const target = (href: string) => (href.startsWith('https:') || href.startsWith('/') ? '_blank' : undefined)
// a card's body: paragraphs, and a list with the paragraph before it in the live rich-text box
const body = (md: string) => {
  const parts = richParts(t(md))
  const out: string[] = []
  parts.forEach((p, i) => {
    if (p.kind === 'ul') return
    const next = parts[i + 1]
    if (next?.kind === 'ul')
      out.push(
        `<div class="text-rich-text text-color-secondary w-richtext"><p>${p.html}</p><ul>${next.items.map((li) => `<li>${li}</li>`).join('')}</ul></div>`,
      )
    else out.push(`<p class="text-color-secondary">${p.html}</p>`)
  })
  return out.join('')
}
const boxBody = (md: string) => {
  const parts = richParts(t(md), false).flatMap((p) => (p.kind === 'p' ? [p.html] : []))
  if (parts.length === 1) return { rich: false, html: parts[0]! }
  return { rich: true, html: parts.map((p) => `<p>${p}</p>`).join('<p>‍</p>') }
}
const boxText = box?.body ? boxBody(box.body) : undefined
---

<Wrap>
  <section class="section no-bottom-border" id={block.id}>
    <div class="border-grid_component is-2-col is-unequal">
      <div class="border-grid_card is-right-padding-3rem">
        <div class="border-grid_card-content is-sticky">
          <div class="header_content">
            {
              block.eyebrow && (
                <div class="label_component">
                  <div class="text-style-tagline text-color-secondary">{t(block.eyebrow)}</div>
                </div>
              )
            }
            {block.title && <h2 class="heading-style-h3" set:html={headingHtml(t(block.title))} />}
            {block.lead && <div class="spacer-small" />}
            {block.lead && <p class="text-color-secondary" set:html={richInline(t(block.lead), false)} />}
          </div>
        </div>
        <div class="border-grid_line" />
      </div>
      <div class="border-grid_card is-unequal-content">
        {
          cards.map((item, i) => {
            const label = (
              <div class="label-list_list">
                <div class={`label-list_item ${COLOURS[i % COLOURS.length]} is-auto-width`}>{t(item.eyebrow!)}</div>
              </div>
            )
            const title = item.title && <h3 class="text-size-large">{t(item.title)}</h3>
            const text = item.body && <Fragment set:html={body(item.body)} />
            return item.image ? (
              <div class="border-grid_card-content is-unequal is-with-badge">
                <div class="partner_tier-wrapper">
                  {label}
                  {title}
                  {text}
                </div>
                <img
                  src={item.image.src}
                  loading="lazy"
                  alt={item.image.alt}
                  width={item.image.width}
                  height={item.image.height}
                  class="partner-tier-badge is-small"
                />
              </div>
            ) : (
              <div class="border-grid_card-content is-unequal">
                {label}
                {title}
                {text}
              </div>
            )
          })
        }
        {
          box && (
            <div class="border-grid_card-content">
              <div class="green-box_component is-no-radius">
                <div class="green-box_content is-display-block">
                  <div class="green-box_content-left is-horizontal">
                    <div class="max-width-15rem">
                      {box.title && <h3 class="heading-style-h4 text-color-dark-green">{t(box.title)}</h3>}
                    </div>
                    <div class="button-group">
                      {links.map((c) =>
                        links.length === 1 ? (
                          <a href={c.href} target={target(c.href)} class="button is-tertiary is-green w-inline-block">
                            <div>{t(c.label)}</div>
                          </a>
                        ) : (
                          <a href={c.href} target={target(c.href)} class="button is-arrow no-padding w-inline-block">
                            <div>{t(c.label)}</div>
                            <div class="button_icon is-arrow w-embed" set:html={ARROW_ICON} />
                          </a>
                        ),
                      )}
                    </div>
                  </div>
                  {
                    boxText && (
                      <div class="green-box_content-right is-full-width">
                        {boxText.rich ? (
                          <div class="text-color-dark-green w-richtext" set:html={boxText.html} />
                        ) : (
                          <div class="text-color-dark-green" set:html={boxText.html} />
                        )}
                      </div>
                    )
                  }
                </div>
              </div>
            </div>
          )
        }
      </div>
    </div>
  </section>
</Wrap>

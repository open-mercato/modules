---
// "Direct CTO Assurance" of /partners as live: the colour divider (the block's `label`), the eyebrow and heading with
// the lead beside them, then one card per item (icon beside the title, the body, and the item's `note` under it) in
// the right column.
import { fillCounts } from '../../../../lib/core/www-tokens.ts'
import Wrap from './Wrap.astro'
import { headingHtml } from '../../lib/inline-markdown.ts'
import type { BlockProps } from '../../lib/pages.ts'
import { richInline } from './about-rich.ts'

type Props = BlockProps<'features'>
const { block, counts } = Astro.props
const t = (s: string): string => fillCounts(s, counts)
---

<Wrap>
  <section class="section no-bottom-border" id={block.id}>
    <div class="section-padding">
      {
        block.label && (
          <div class="color-divider_component">
            <div class="color-divider_gradient-line" />
            <div class="color-divider_line" />
            <div class="color-divider_content">
              <div class="text-style-tagline text-color-secondary">{t(block.label)}</div>
            </div>
          </div>
        )
      }
      <div class="header_component is-grid is-aligned-bottom">
        <div class="header_content max-width-22rem">
          {
            block.eyebrow && (
              <div class="label_component">
                <div class="text-style-tagline text-color-secondary">{t(block.eyebrow)}</div>
              </div>
            )
          }
          {block.title && <h2 class="heading-style-h3" set:html={headingHtml(t(block.title))} />}
        </div>
        {block.lead && <p class="text-color-secondary" set:html={richInline(t(block.lead), false)} />}
      </div>
      <div class="spacer-large" />
      <div class="header_component is-grid">
        <div class="header_content hide-tablet" />
        <div class="bg-grid_component">
          {
            block.items.map((item) => (
              <div class="bg-grid_card">
                <div class="bg-grid_card-content">
                  <div class="bg-grid_heading-wrapper">
                    {item.icon && (
                      <div class="icon-embed-small w-embed">
                        <img src={item.icon.src} alt={item.icon.alt} width="32" height="32" />
                      </div>
                    )}
                    {item.title && <h3 class="text-size-medium text-weight-medium">{t(item.title)}</h3>}
                  </div>
                  <div class="spacer-1rem" />
                  {item.body && <p class="text-color-secondary" set:html={richInline(t(item.body), false)} />}
                  {item.note && <div class="spacer-1rem" />}
                  {item.note && <p class="text-color-secondary" set:html={richInline(t(item.note), false)} />}
                </div>
              </div>
            ))
          }
        </div>
      </div>
    </div>
  </section>
</Wrap>

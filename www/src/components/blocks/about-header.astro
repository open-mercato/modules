---
// The header section of /about, /careers, /partners and /agencies as live: the breadcrumb (Home / the block's
// `eyebrow`), the heading (a line break where the title has one), the lead and the buttons: `primary` the dark one
// (with the GitHub mark when it links GitHub), `secondary` the outlined one. /about and /careers keep the heading in a
// narrow column with no rule under the section; /agencies has a narrower lead.
import { fillCounts } from '../../../../lib/core/www-tokens.ts'
import Crumbs from '../Crumbs.astro'
import Wrap from './Wrap.astro'
import { headingHtml } from '../../lib/inline-markdown.ts'
import { GITHUB_ICON } from '../../lib/webflow-icons.ts'
import { pagePath, type BlockProps } from '../../lib/pages.ts'
import { headingLines, richInline } from './about-rich.ts'

type Props = BlockProps<'hero'>
const { block, counts, page } = Astro.props
const t = (s: string): string => fillCounts(s, counts)
const narrow = page === 'about' || page === 'careers'
const heading = headingLines(headingHtml(t(block.title)))
const target = (href: string) => (href.startsWith('https:') ? '_blank' : undefined)
const github = (href: string) => href.startsWith('https://github.com/')
---

<Wrap>
  <section class:list={['section', narrow && 'no-bottom-border']} id={block.id}>
    <div class="section-padding">
      <div class="header_component max-width-50rem">
        <div class="header_content">
          {block.eyebrow && <Crumbs current={{ name: t(block.eyebrow), href: pagePath(page) }} />}
          {narrow ? <div class="max-width-33rem"><h1 set:html={heading} /></div> : <h1 set:html={heading} />}
          {block.lead && <div class="spacer-small" />}
          {
            block.lead && (
              <div class={page === 'agencies' ? 'max-width-35rem' : 'max-width-42rem'}>
                <p class="text-color-secondary" set:html={richInline(t(block.lead), false)} />
              </div>
            )
          }
          {(block.primary || block.secondary) && <div class="spacer-medium" />}
          {
            (block.primary || block.secondary) && (
              <div class="button-group">
                {block.primary && (
                  <a href={block.primary.href} target={target(block.primary.href)} class="button is-icon w-inline-block">
                    {github(block.primary.href) && <div class="button_icon w-embed" set:html={GITHUB_ICON} />}
                    <div>{t(block.primary.label)}</div>
                  </a>
                )}
                {block.secondary && (
                  <a
                    href={block.secondary.href}
                    target={target(block.secondary.href)}
                    class="button is-secondary w-inline-block"
                  >
                    <div>{t(block.secondary.label)}</div>
                  </a>
                )}
              </div>
            )
          }
        </div>
      </div>
    </div>
  </section>
</Wrap>

---
// "Before vs. After" of /agencies as live: the eyebrow and heading, then the table of what changes. Each item is a
// column: the first holds the caption (`body`) and the row names (`points`), the others their name (`title`) and
// cells (`points`). In the middle column a cell that starts with `✓ ` shows the grey check, one that starts with `✗ `
// the red cross and reads red; the last column reads green, a `✓ ` cell with the green check.
import { fillCounts } from '../../../../lib/core/www-tokens.ts'
import Wrap from './Wrap.astro'
import { headingHtml } from '../../lib/inline-markdown.ts'
import type { BlockProps } from '../../lib/pages.ts'
import { richInline } from './about-rich.ts'
import without from './agencies-head-without.svg?raw'
import withIcon from './agencies-head-with.svg?raw'
import checkGreen from './agencies-check-green.svg?raw'
import check from './agencies-check.svg?raw'
import cross from './agencies-cross.svg?raw'

type Props = BlockProps<'features'>
const { block, counts } = Astro.props
const t = (s: string): string => fillCounts(s, counts)
const [names, ...columns] = block.items
const mark = (s: string) => (s.startsWith('✓ ') ? 'yes' : s.startsWith('✗ ') ? 'no' : undefined)
const text = (s: string) => richInline(t(s.replace(/^[✓✗] /, '')), false)
---

<Wrap>
  <section class="section no-bottom-border" id={block.id}>
    <div class="section-padding">
      <div class="header_component">
        <div class="header_content max-width-26rem">
          {
            block.eyebrow && (
              <div class="label_component">
                <div class="text-style-tagline text-color-secondary">{t(block.eyebrow)}</div>
              </div>
            )
          }
          {block.title && <h2 class="heading-style-h3" set:html={headingHtml(t(block.title))} />}
        </div>
      </div>
    </div>
    <div class="spacer-large" />
    <div class="table_component no-scrollbar">
      {
        names && (
          <div class="table_column">
            <div class="table_header is-align-bottom">
              {names.body && <p class="text-color-secondary" set:html={richInline(t(names.body), false)} />}
            </div>
            <div class="table_content is-min-height-27rem">
              {names.points?.map((p) => (
                <div class="table_row">
                  <div class="text-color-secondary" set:html={text(p)} />
                </div>
              ))}
            </div>
          </div>
        )
      }
      {
        columns.map((col, i) => {
          const last = i === columns.length - 1
          return (
            <div class:list={['table_column', !last && 'is-middle']}>
              <div class="table_header">
                <div class="table_header-icon w-embed" set:html={last ? withIcon : without} />
                {col.title && <h3 class="text-size-large text-weight-normal">{t(col.title)}</h3>}
              </div>
              <div class="table_content is-min-height-27rem">
                {col.points?.map((p) => {
                  const m = mark(p)
                  const icon = m === 'yes' ? (last ? checkGreen : check) : m === 'no' ? cross : undefined
                  const cls = last
                    ? 'text-color-dark-green text-weight-medium'
                    : m === 'no'
                      ? 'text-weight-medium text-color-error'
                      : 'text-weight-medium'
                  return (
                    <div class="table_row">
                      {icon && <div class="table_row-icon w-embed" set:html={icon} />}
                      <div class={cls} set:html={text(p)} />
                    </div>
                  )
                })}
              </div>
            </div>
          )
        })
      }
    </div>
  </section>
</Wrap>

---
// The header of /how-to-contribute as live has it: the breadcrumb, the heading and lead (47rem), the GitHub and demo
// buttons and, from the block's items, the arrow links after them (Documentation).
import { fillCounts } from '../../../../lib/core/www-tokens.ts'
import Crumbs from '../Crumbs.astro'
import Wrap from './Wrap.astro'
import { headingHtml, inline } from '../../lib/inline-markdown.ts'
import { pagePath, type BlockProps } from '../../lib/pages.ts'
import github from '../site/github-mark.svg?raw'
import arrow from './how-to-contribute-arrow.svg?raw'

type Props = BlockProps<'hero'>
const { block, counts, page } = Astro.props
const t = (s: string): string => fillCounts(s, counts)
---

<Wrap>
  <section class="section" id={block.id}>
    <div class="section-padding">
      <div class="header_component">
        <div class="header_content max-width-47rem">
          {block.eyebrow && <Crumbs current={{ name: t(block.eyebrow), href: pagePath(page) }} />}
          <h1 set:html={headingHtml(t(block.title))} />
          <div class="spacer-small"></div>
          {
            block.lead && (
              <div class="max-width-47rem">
                <p class="text-color-secondary" set:html={inline(t(block.lead))} />
              </div>
            )
          }
          <div class="spacer-medium"></div>
          <div class="button-group">
            {
              block.primary && (
                <a href={block.primary.href} target="_blank" class="button is-icon w-inline-block">
                  <div class="button_icon w-embed" set:html={github} />
                  <div>{t(block.primary.label)}</div>
                </a>
              )
            }
            {
              block.secondary && (
                <a href={block.secondary.href} target="_blank" class="button is-secondary w-inline-block">
                  <div>{t(block.secondary.label)}</div>
                </a>
              )
            }
            {
              (block.items ?? []).map(
                (item) =>
                  item.cta && (
                    <a href={item.cta.href} target="_blank" class="button is-arrow w-inline-block">
                      <div>{t(item.cta.label)}</div>
                      <div class="button_icon is-arrow w-embed" set:html={arrow} />
                    </a>
                  ),
              )
            }
          </div>
        </div>
      </div>
    </div>
  </section>
</Wrap>

---
// "How is this different from n8n?" of /agent-orchestrator: the heading, lead and the `body` beside them, then the
// comparison table, one item per column as live has it: the row labels, n8n's column, then Open Mercato's with a
// check before each cell.
import { fillCounts } from '../../../../lib/core/www-tokens.ts'
import Wrap from './Wrap.astro'
import { headingHtml, inline } from '../../lib/inline-markdown.ts'
import type { BlockProps } from '../../lib/pages.ts'
import check from './agent-orchestrator-check.svg?raw'

type Props = BlockProps<'features'>
const { block, counts } = Astro.props
const t = (s: string): string => fillCounts(s, counts)
const last = block.items.length - 1
---

<Wrap>
  <section class="section no-bottom-border no-bottom-padding" id={block.id}>
    <div class="section-padding">
      <div class="header_component is-flex">
        <div class="header_content max-width-26rem">
          {
            block.eyebrow && (
              <div class="label_component">
                <div class="text-style-tagline text-color-secondary">{t(block.eyebrow)}</div>
              </div>
            )
          }
          {block.title && <h2 class="heading-style-h3" set:html={headingHtml(t(block.title))} />}
          <div class="spacer-small"></div>
          {block.lead && <p class="text-color-secondary" set:html={inline(t(block.lead))} />}
        </div>
        <div>{block.body && <p class="text-color-secondary" set:html={inline(t(block.body))} />}</div>
      </div>
    </div>
    <div class="spacer-large"></div>
    <div class="table_component no-scrollbar">
      {
        block.items.map((col, i) => (
          <div class:list={['table_column', { 'is-agents-1-col': i === 0, 'is-middle': i > 0 && i < last }]}>
            <div class="table_header">
              {col.title && <h3 class="text-size-large text-weight-normal">{t(col.title)}</h3>}
            </div>
            <div class="table_content is-agent-orch">
              {(col.points ?? []).map((p) => (
                <div class="table_row">
                  {i === 0 ? (
                    <div class="text-color-secondary" set:html={inline(t(p))} />
                  ) : i < last ? (
                    <div class="text-weight-medium" set:html={inline(t(p))} />
                  ) : (
                    <>
                      <div class="table_row-icon w-embed" set:html={check} />
                      <div class="text-color-dark-green text-weight-medium" set:html={inline(t(p))} />
                    </>
                  )}
                </div>
              ))}
            </div>
          </div>
        ))
      }
    </div>
  </section>
</Wrap>

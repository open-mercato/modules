---
// "How to Master AI-Assisted Coding" of /learn-ai-engineering: the heading, then the video in the live full-width
// frame (`video_component is-full`, www/src/styles/webflow/pages/learn-ai-engineering.css), loaded on a click
// (VideoEmbed) over its poster instead of the live iframe.
import { fillCounts } from '../../../../lib/core/www-tokens.ts'
import VideoEmbed from '../blog/VideoEmbed.astro'
import Wrap from './Wrap.astro'
import { headingHtml } from '../../lib/inline-markdown.ts'
import type { BlockProps } from '../../lib/pages.ts'

type Props = BlockProps<'video'>
const { block, counts } = Astro.props
const t = (s: string): string => fillCounts(s, counts)
---

<Wrap>
  <section class="section no-bottom-border" id={block.id}>
    <div class="section-padding">
      <div class="header_component is-flex">
        <div class="header_content max-width-36rem">
          {
            block.eyebrow && (
              <div class="label_component">
                <div class="text-style-tagline text-color-secondary">{t(block.eyebrow)}</div>
              </div>
            )
          }
          {block.title && <h2 class="heading-style-h3" set:html={headingHtml(t(block.title))} />}
        </div>
      </div>
      <div class="spacer-large"></div>
      <div class="video_component-embed w-embed w-iframe">
        <div class="video_component is-full">
          <VideoEmbed id={block.youtube} title={block.poster?.alt || block.caption} poster={block.poster?.src} />
        </div>
      </div>
    </div>
  </section>
</Wrap>

---
// The numbered cards of /partners ("Why work with an implementation partner?") and /agencies ("Your workflow") as
// live: the sticky eyebrow and heading on the left (a line break where the title has one), on the right one card per
// item under its number (`eyebrow`, in the colour of its place): icon, title, body and the item's `note` as a tag.
import { fillCounts } from '../../../../lib/core/www-tokens.ts'
import Wrap from './Wrap.astro'
import { headingHtml } from '../../lib/inline-markdown.ts'
import type { BlockProps } from '../../lib/pages.ts'
import { headingLines, richInline } from './about-rich.ts'

type Props = BlockProps<'features'>
const { block, counts, page } = Astro.props
const t = (s: string): string => fillCounts(s, counts)
const COLOURS = ['is-violet', 'is-yellow', 'is-green', 'is-dark-green']
---

<Wrap>
  <section class:list={['section', page === 'agencies' && 'no-bottom-border']} id={block.id}>
    <div class="section-padding">
      <div class="header_component is-grid is-fast-track">
        <div class="header_content-wrapper">
          <div class="header_content is-sticky">
            {
              block.eyebrow && (
                <div class="label_component">
                  <div class="text-style-tagline text-color-secondary">{t(block.eyebrow)}</div>
                </div>
              )
            }
            {block.title && <h2 class="heading-style-h3" set:html={headingLines(headingHtml(t(block.title)))} />}
          </div>
        </div>
        <div class="bg-grid_component is-gap-3rem">
          {
            block.items.map((item, i) => (
              <div class="bg-grid_card-wrapper">
                {item.eyebrow && <div class={`label-list_item ${COLOURS[i % COLOURS.length]}`}>{t(item.eyebrow)}</div>}
                <div class="bg-grid_card">
                  <div class="bg-grid_card-content">
                    <div class="bg-grid_heading-wrapper">
                      {item.icon && (
                        <div class="icon-embed-small w-embed">
                          <img src={item.icon.src} alt={item.icon.alt} width="32" height="32" />
                        </div>
                      )}
                      {item.title && <h3 class="text-size-medium text-weight-medium">{t(item.title)}</h3>}
                    </div>
                    <div class="spacer-1rem" />
                    {item.body && <p class="text-color-secondary" set:html={richInline(t(item.body), false)} />}
                    {item.note && <div class="spacer-small" />}
                    {item.note && (
                      <div class="label-list_list">
                        <div class="label-list_item" set:html={richInline(t(item.note), false)} />
                      </div>
                    )}
                  </div>
                </div>
              </div>
            ))
          }
        </div>
      </div>
    </div>
  </section>
</Wrap>

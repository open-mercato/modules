---
// "Where to Connect" of /how-to-contribute: the heading on the left, one row per channel on the right, its text and
// an arrow link (the live grid cells #w-node-..., site.css, push the link to the row's end).
import { fillCounts } from '../../../../lib/core/www-tokens.ts'
import Wrap from './Wrap.astro'
import { headingHtml, inline } from '../../lib/inline-markdown.ts'
import type { BlockProps } from '../../lib/pages.ts'
import arrow from './how-to-contribute-arrow.svg?raw'

type Props = BlockProps<'features'>
const { block, counts } = Astro.props
const t = (s: string): string => fillCounts(s, counts)
const cells = [
  'w-node-_216537a8-dc85-c09f-7c4e-7062ac903eb7-67023bfd',
  'w-node-_08033ba3-5180-eacb-2a1c-342a41b327a0-67023bfd',
  'w-node-f4c6e10a-46dc-1687-051e-0f7aabe406c7-67023bfd',
]
---

<Wrap>
  <section class="section" id={block.id}>
    <div class="section-padding">
      <div class="header_component is-grid">
        <div class="header_content">
          {
            block.eyebrow && (
              <div class="label_component">
                <div class="text-style-tagline text-color-secondary">{t(block.eyebrow)}</div>
              </div>
            )
          }
          {block.title && <h2 class="heading-style-h3" set:html={headingHtml(t(block.title))} />}
        </div>
        <div class="bg-grid_component">
          {
            block.items.map((item, i) => (
              <div class="bg-grid_card is-how-it-works">
                <div class="bg-grid_card-content is-grid is-unequal">
                  <div class="bg-grid_heading-wrapper">
                    {item.title && <h3 class="text-size-regular" set:html={inline(t(item.title))} />}
                  </div>
                  {item.cta && (
                    <div id={cells[i]} class="bg-grid_link-wrapper">
                      <a
                        href={item.cta.href}
                        target={item.cta.href.startsWith('https://') ? '_blank' : undefined}
                        class="button is-arrow no-padding w-inline-block"
                      >
                        <div>{t(item.cta.label)}</div>
                        <div class="button_icon is-arrow w-embed" set:html={arrow} />
                      </a>
                    </div>
                  )}
                </div>
              </div>
            ))
          }
        </div>
      </div>
    </div>
  </section>
</Wrap>

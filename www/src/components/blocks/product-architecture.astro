---
// "The Architecture" of /product as live has it: the heading beside the lead, then three numbered cards (an item's
// eyebrow is its number, coloured in turn violet, yellow, green and dark green), the section open at the bottom.
import { fillCounts } from '../../../../lib/core/www-tokens.ts'
import Wrap from './Wrap.astro'
import { headingHtml, inline } from '../../lib/inline-markdown.ts'
import type { BlockProps } from '../../lib/pages.ts'

type Props = BlockProps<'features'>
const { block, counts } = Astro.props
const t = (s: string): string => fillCounts(s, counts)
const COLORS = ['is-violet', 'is-yellow', 'is-green', 'is-dark-green']
/** A body's paragraphs in one <p>, a blank line between them, as live. */
const body = (s: string): string =>
  t(s)
    .split(/\n\s*\n/)
    .map((p) => inline(p.trim()))
    .join('<br/><br/>')
---

<Wrap>
  <section class="section no-bottom-border no-bottom-padding" id={block.id}>
    <div class="section-padding">
      <div class="header_component is-flex">
        <div class="header_content max-width-36rem">
          {
            block.eyebrow && (
              <div class="label_component">
                <div class="text-style-tagline text-color-secondary">{t(block.eyebrow)}</div>
              </div>
            )
          }
          {block.title && <h2 class="heading-style-h3" set:html={headingHtml(t(block.title))} />}
        </div>
        {
          block.lead && (
            <div class="max-width-33rem">
              <p class="text-color-secondary" set:html={inline(t(block.lead))} />
            </div>
          )
        }
      </div>
      <div class="spacer-large"></div>
      <div class="bg-grid_component is-3-col">
        {
          block.items.map((item, i) => (
            <div class="bg-grid_card-wrapper">
              {item.eyebrow && <div class:list={['label-list_item', COLORS[i % COLORS.length]]}>{t(item.eyebrow)}</div>}
              <div class="bg-grid_card">
                <div class="bg-grid_card-content">
                  <div class="bg-grid_heading-wrapper">
                    {item.title && <h3 class="text-size-medium text-weight-medium">{t(item.title)}</h3>}
                  </div>
                  <div class="spacer-1rem" />
                  {item.body && <p class="text-color-secondary" set:html={body(item.body)} />}
                </div>
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </section>
</Wrap>

---
// The green box under the table of /agencies ("3× the margin.") as live: the title in display type with the `primary`
// button under it, the body beside them. Live it closes the table's section; here it is a block of its own, so
// www/src/styles/webflow/pages/agencies.css moves the bottom padding of that section under it.
import { fillCounts } from '../../../../lib/core/www-tokens.ts'
import Wrap from './Wrap.astro'
import type { BlockProps } from '../../lib/pages.ts'
import { richInline } from './about-rich.ts'

type Props = BlockProps<'cta'>
const { block, counts } = Astro.props
const t = (s: string): string => fillCounts(s, counts)
---

<Wrap>
  <div class="section no-bottom-border om-agencies-margin" id={block.id}>
  <div class="spacer-small" />
  <div class="section-padding">
    <div class="green-box_component">
      <div class="green-box_content">
        <div class="green-box_content-left">
          <h3 class="heading-style-h1 text-color-dark-green">{t(block.title)}</h3>
          <div class="spacer-small" />
          {
            block.primary && (
              <div class="button-group">
                <a
                  href={block.primary.href}
                  target={block.primary.href.startsWith('https:') ? '_blank' : undefined}
                  class="button is-tertiary is-green w-inline-block"
                >
                  <div>{t(block.primary.label)}</div>
                </a>
              </div>
            )
          }
        </div>
        <div class="green-box_content-right">
          {block.body && <div class="text-color-dark-green" set:html={richInline(t(block.body), false)} />}
        </div>
      </div>
    </div>
  </div>
  </div>
</Wrap>

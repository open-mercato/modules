---
// "Framework backing & longevity" of /enterprise-level-support: the tagline and heading beside the lead, then two
// bordered cards, each an icon, a title, the paragraph of its body and the one of its note (a blank line inside a
// paragraph is the live double line break).
import { fillCounts } from '../../../../lib/core/www-tokens.ts'
import Wrap from './Wrap.astro'
import { headingHtml, inline } from '../../lib/inline-markdown.ts'
import type { BlockProps } from '../../lib/pages.ts'
import icon1 from './enterprise-level-support-backing-1.svg?raw'
import icon2 from './enterprise-level-support-backing-2.svg?raw'

type Props = BlockProps<'features'>
const { block, counts } = Astro.props
const t = (s: string): string => fillCounts(s, counts)
const icons = [icon1, icon2]
const para = (s: string): string =>
  t(s)
    .split(/\n\s*\n/)
    .map((p) => inline(p.replace(/\s*\n\s*/g, ' ').trim()))
    .join('<br /><br />')
const last = block.items.length - 1
---

<Wrap>
  <section class="section no-bottom-border" id={block.id}>
    <div class="section-padding">
      <div class="header_component is-flex">
        <div class="header_content max-width-36rem">
          {
            block.eyebrow && (
              <div class="label_component">
                <div class="text-style-tagline text-color-secondary">{t(block.eyebrow)}</div>
              </div>
            )
          }
          {block.title && <h2 class="heading-style-h3" set:html={headingHtml(t(block.title))} />}
        </div>
        {
          block.lead && (
            <div class="max-width-33rem">
              <p class="text-color-secondary" set:html={inline(t(block.lead))} />
            </div>
          )
        }
      </div>
    </div>
    <div class="spacer-large"></div>
    <div class="border-grid_component is-2-col">
      {
        block.items.map((item, i) => (
          <div class="border-grid_card">
            <div class="border-grid_card-content">
              {icons[i] && (
                <div class="border-grid_icon-wrapepr">
                  <div class="border-grid_icon w-embed" set:html={icons[i]} />
                </div>
              )}
              <div class="spacer-1rem" />
              {item.title && <h3 class="text-size-medium text-weight-medium">{t(item.title)}</h3>}
              <div class="spacer-1rem" />
              {item.body && <p class="text-color-secondary" set:html={para(item.body)} />}
              {item.note && (
                <>
                  <div class="spacer-1rem" />
                  <p class="text-color-secondary" set:html={para(item.note)} />
                </>
              )}
            </div>
            <div class:list={['border-grid_line', { 'show-tablet': i === last }]} />
          </div>
        ))
      }
    </div>
  </section>
</Wrap>

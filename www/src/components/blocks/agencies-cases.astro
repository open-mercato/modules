---
// "Case Studies" of /agencies as live: the case study carousel (components/case-studies/CaseSlider.astro, its cards
// sending the live cta_cases_open_story) of the published case studies, `featured` keeping those featured on
// /agencies, in list order; the block's `eyebrow` is the tagline, `title` the heading.
import { fillCounts } from '../../../../lib/core/www-tokens.ts'
import Wrap from './Wrap.astro'
import CaseSlider from '../case-studies/CaseSlider.astro'
import { caseStudyCard } from '../../lib/case-studies.ts'
import { caseStudyData } from '../../lib/collections-data.ts'
import type { BlockProps } from '../../lib/pages.ts'

type Props = BlockProps<'list'>
const { block, counts } = Astro.props
const t = (s: string): string => fillCounts(s, counts)
const data = await caseStudyData()
const items = data.published
  .filter((cs) => !block.featured || cs.data.featuredOnAgencies)
  .slice(0, block.limit)
  .map((cs) => caseStudyCard(cs, data.categories))
---

<Wrap>
  <CaseSlider tagline={t(block.eyebrow ?? '')} heading={t(block.title ?? '')} items={items} />
</Wrap>

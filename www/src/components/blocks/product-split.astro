---
// The sections of /product with the heading beside the lead and cards in the right column (the layouts
// product-agents, product-cards and product-anatomy pass their look): the colour divider when the block has a
// `label`, the eyebrow, the heading and the lead, then one card per item: icon and title, the body (its paragraphs in
// one <p>, as live) and the item's note as the source line. An item with a body only is a quote across the columns
// (the live card's Webflow id places it, site.css).
import { fillCounts } from '../../../../lib/core/www-tokens.ts'
import Icon from './product-icon.astro'
import Wrap from './Wrap.astro'
import { headingHtml, inline } from '../../lib/inline-markdown.ts'
import type { BlockProps } from '../../lib/pages.ts'

type Props = BlockProps<'features'> & {
  /** Extra class of the card grid (`is-2-col`). */
  grid?: string
  /** Icon above the title rather than beside it. */
  vertical?: boolean
  /** The heading's size class. */
  heading?: 'heading-style-h3' | 'heading-style-h4'
  /** No border under the section. */
  open?: boolean
}
const { block, counts, grid, vertical = false, heading = 'heading-style-h3', open = false } = Astro.props
const t = (s: string): string => fillCounts(s, counts)
const body = (s: string): string =>
  t(s)
    .split(/\n\s*\n/)
    .map((p) => inline(p.trim()))
    .join('<br/><br/>')
/** The Webflow id of the live quote card, which the site stylesheet spans across both columns. */
const QUOTE_NODE = 'w-node-_955f710e-50fd-56b0-ae72-d4e804594811-7fd3562e'
---

<Wrap>
  <section class:list={['section', open && 'no-bottom-border']} id={block.id}>
    <div class="section-padding">
      {
        block.label && (
          <div class="color-divider_component">
            <div class="color-divider_gradient-line" />
            <div class="color-divider_line" />
            <div class="color-divider_content">
              <div class="text-style-tagline text-color-secondary">{t(block.label)}</div>
            </div>
          </div>
        )
      }
      <div class="header_component is-grid is-aligned-bottom">
        <div class="header_content max-width-22rem">
          {
            block.eyebrow && (
              <div class="label_component">
                <div class="text-style-tagline text-color-secondary">{t(block.eyebrow)}</div>
              </div>
            )
          }
          {block.title && <h2 class={heading} set:html={headingHtml(t(block.title))} />}
        </div>
        {block.lead && <p class="text-color-secondary" set:html={inline(t(block.lead))} />}
      </div>
      <div class="spacer-large"></div>
      <div class="header_component is-grid">
        <div class="header_content hide-tablet"></div>
        <div class:list={['bg-grid_component', grid]}>
          {
            block.items.map((item) =>
              item.title ? (
                <div class="bg-grid_card">
                  <div class="bg-grid_card-content">
                    <div class:list={['bg-grid_heading-wrapper', vertical && 'is-vertical']}>
                      {item.icon && (
                        <div class="icon-embed-small w-embed">
                          <Icon icon={item.icon} />
                        </div>
                      )}
                      <h3 class="text-size-medium text-weight-medium">{t(item.title)}</h3>
                    </div>
                    <div class="spacer-1rem" />
                    <p class="text-color-secondary">
                      {item.body && <Fragment set:html={body(item.body)} />}
                      {item.note && (
                        <>
                          <br />
                          <span class="text-style-tagline" set:html={inline(t(item.note))} />
                        </>
                      )}
                    </p>
                  </div>
                </div>
              ) : (
                <div id={QUOTE_NODE} class="bg-grid_card">
                  <div class="bg-grid_card-content">
                    {item.body && <p class="text-color-secondary" set:html={body(item.body)} />}
                  </div>
                </div>
              ),
            )
          }
        </div>
      </div>
    </div>
  </section>
</Wrap>

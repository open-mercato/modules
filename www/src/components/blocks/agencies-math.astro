---
// "The math" of /agencies as live: the eyebrow and heading, then the table of a project's parts with and without
// Open Mercato. Each item is a column: the first holds the table's caption (`body`) and the row names (`points`), the
// others their name (`title`) and cells (`points`); `note` is the column's total. A cell that starts with `✓ ` shows
// the green check and reads in green; the totals read red, then green.
import { fillCounts } from '../../../../lib/core/www-tokens.ts'
import Wrap from './Wrap.astro'
import { headingHtml } from '../../lib/inline-markdown.ts'
import type { BlockProps } from '../../lib/pages.ts'
import { richInline } from './about-rich.ts'
import without from './agencies-head-without.svg?raw'
import withIcon from './agencies-head-with.svg?raw'
import check from './agencies-check-green.svg?raw'

type Props = BlockProps<'features'>
const { block, counts } = Astro.props
const t = (s: string): string => fillCounts(s, counts)
const [names, ...columns] = block.items
const cell = (s: string) => ({ checked: s.startsWith('✓ '), html: richInline(t(s.replace(/^✓ /, '')), false) })
---

<Wrap>
  <section class="section no-bottom-border om-agencies-math" id={block.id}>
    <div class="section-padding">
      <div class="header_component">
        <div class="header_content max-width-47rem">
          {
            block.eyebrow && (
              <div class="label_component">
                <div class="text-style-tagline text-color-secondary">{t(block.eyebrow)}</div>
              </div>
            )
          }
          {block.title && <h2 class="heading-style-h3" set:html={headingHtml(t(block.title))} />}
        </div>
      </div>
    </div>
    <div class="spacer-large" />
    <div class="table_component no-scrollbar">
      {
        names && (
          <div class="table_column">
            <div class="table_header">
              {names.body && <p class="text-color-secondary" set:html={richInline(t(names.body), false)} />}
            </div>
            <div class="table_content">
              {names.points?.map((p) => (
                <div class="table_row">
                  <div class="text-color-secondary" set:html={richInline(t(p), false)} />
                </div>
              ))}
            </div>
            {names.note && (
              <div class="table_content">
                <div class="table_row">
                  <div class="text-color-secondary" set:html={richInline(t(names.note), false)} />
                </div>
              </div>
            )}
          </div>
        )
      }
      {
        columns.map((col, i) => {
          const last = i === columns.length - 1
          return (
            <div class:list={['table_column', !last && 'is-middle']}>
              <div class="table_header">
                <div class="table_header-icon w-embed" set:html={last ? withIcon : without} />
                {col.title && <h3 class="text-size-large text-weight-normal">{t(col.title)}</h3>}
              </div>
              <div class="table_content">
                {col.points?.map((p) => {
                  const c = cell(p)
                  return (
                    <div class="table_row">
                      {c.checked && <div class="table_row-icon w-embed" set:html={check} />}
                      <div
                        class={c.checked ? 'text-color-dark-green text-weight-medium' : 'text-weight-medium'}
                        set:html={c.html}
                      />
                    </div>
                  )
                })}
              </div>
              {col.note && (
                <div class="table_content">
                  <div class="table_row">
                    <div
                      class={last ? 'text-color-dark-green' : 'text-color-error'}
                      set:html={richInline(t(col.note), false)}
                    />
                  </div>
                </div>
              )}
            </div>
          )
        })
      }
    </div>
  </section>
</Wrap>

---
// /certified-partners/<slug> (spec, Routing, UI/UX and SEO): one page per published partner, never one for a draft
// (D6), in the live Webflow markup. Title `<name>  | Open Mercato Agency`, canonical, the logo as og:image,
// BreadcrumbList JSON-LD; the bio as Prose beside the summary, and the published case studies the partner delivered in
// the carousel of the live template ("Projects we've shipped").
import { render } from 'astro:content'
import Main from '../../layouts/Main.astro'
import Prose from '../../components/blog/Prose.astro'
import CaseSlider from '../../components/case-studies/CaseSlider.astro'
import PartnerProfile from '../../components/partners/PartnerProfile.astro'
import { refId } from '../../lib/blog.ts'
import { caseStudyCard } from '../../lib/case-studies.ts'
import { caseStudyData, partnerData } from '../../lib/collections-data.ts'
import {
  partnerFacts,
  partnerJsonLd,
  partnerPath,
  partnerSeo,
  partnerValues,
  tierStyle,
  type PartnerEntry,
} from '../../lib/partners.ts'
import pagesCss from '../../styles/webflow/pages.css?url'
import blogCss from '../../styles/blog.css?url'

export async function getStaticPaths() {
  const data = await partnerData()
  return data.published.map((partner) => ({ params: { slug: partner.id }, props: { partner } }))
}

const { partner } = Astro.props as { partner: PartnerEntry }
const data = await partnerData()
const cases = await caseStudyData()
const site = (Astro.site ?? new URL('https://www.openmercato.com')).origin
const seo = partnerSeo(partner, site)
const tierId = partnerValues(partner).tier[0]!
const delivered = cases.published
  .filter((cs) => refId(cs.data.deliveredBy) === partner.id)
  .map((cs) => caseStudyCard(cs, cases.categories))
const { Content } = await render(partner as never)
---

<Main
  path={partnerPath(partner.id)}
  title={seo.title}
  description={seo.description}
  ogImage={seo.ogImage}
  jsonLd={partnerJsonLd(partner, site)}
  bodyClass="wf-partner"
  styles={[pagesCss, blogCss]}
>
  <div class="main-wrapper padding-global">
    <div class="container-main">
      <PartnerProfile
        name={partner.data.name}
        href={partnerPath(partner.id)}
        description={partner.data.description}
        tier={data.dict.tiers.get(tierId)?.name ?? tierId}
        tierStyle={tierStyle(data.dict.tiers, tierId)}
        logo={partner.data.logo}
        website={partner.data.website}
        facts={partnerFacts(partner, data.dict).filter((f) => f.facet !== 'tier')}
      >
        <Prose><Content /></Prose>
      </PartnerProfile>
      <CaseSlider tagline="AGENCY CASE STUDIES" heading="Projects we've shipped" items={delivered} />
    </div>
  </div>
</Main>

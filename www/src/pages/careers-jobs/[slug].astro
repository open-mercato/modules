---
// /careers-jobs/<slug> (spec, Routing and SEO): one page per job that is not a draft (D6), in the live Webflow markup
// (JobDetail.astro). Title `<title> | Careers - Open Mercato`, canonical, JobPosting JSON-LD while the job is open (its
// body as the description) and BreadcrumbList. The list of jobs is /careers, a unique page still on Webflow until
// Phase 6, so "All open roles" points there.
import { render } from 'astro:content'
import Main from '../../layouts/Main.astro'
import { MAIN_SITE_ORIGIN } from '../../../../lib/core/main-site.ts'
import Prose from '../../components/blog/Prose.astro'
import JobDetail from '../../components/jobs/JobDetail.astro'
import { jobData } from '../../lib/collections-data.ts'
import { CAREERS_PATH, jobJsonLd, jobPath, jobSeo, type JobEntry } from '../../lib/jobs.ts'
import pagesCss from '../../styles/webflow/pages.css?url'
import blogCss from '../../styles/blog.css?url'

export async function getStaticPaths() {
  const jobs = await jobData()
  return jobs.map((job) => ({ params: { slug: job.id }, props: { job } }))
}

const { job } = Astro.props as { job: JobEntry }
const site = (Astro.site ?? new URL('https://www.openmercato.com')).origin
const seo = jobSeo(job, site)
const { Content } = await render(job as never)
const html = (job as unknown as { rendered?: { html?: string } }).rendered?.html
---

<Main
  path={jobPath(job.id)}
  title={seo.title}
  description={seo.description}
  jsonLd={jobJsonLd(job, site, html)}
  bodyClass="wf-job"
  styles={[pagesCss, blogCss]}
>
  {/* the live job template wraps its page in `white-section-wrapper`, not `main-wrapper` */}
  <div class="white-section-wrapper padding-global">
    <div class="container-main">
      <JobDetail job={job} careersHref={`${MAIN_SITE_ORIGIN}${CAREERS_PATH}`}>
        <Prose variant="plain"><Content /></Prose>
      </JobDetail>
    </div>
  </div>
</Main>

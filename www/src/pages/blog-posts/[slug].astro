---
// /blog-posts/<slug> (spec, Routing and SEO): one page per published post, never one for a draft (D6), in the live
// Webflow markup (`blog-post_component`). Title `<title> | Open Mercato`, canonical, og:type article with the thumbnail
// as og:image, BlogPosting and BreadcrumbList JSON-LD, all from the entry. The sidebar (the CTA and the table of
// contents, built here from the post's h2 headings) is in the markup as live and hidden by the live reader style
// (www/src/styles/webflow/pages.css).
import { render } from 'astro:content'
import Main from '../../layouts/Main.astro'
import PostHeader from '../../components/blog/PostHeader.astro'
import Prose from '../../components/blog/Prose.astro'
import { MAIN_SITE_GITHUB } from '../../../../lib/core/main-site.ts'
import { postJsonLd, postPath, postSeo, readingMinutes, refId, type PostEntry } from '../../lib/blog.ts'
import { blogData, postNames } from '../../lib/blog-data.ts'
import { GITHUB_ICON } from '../../lib/webflow-icons.ts'
import pagesCss from '../../styles/webflow/pages.css?url'
import blogCss from '../../styles/blog.css?url'

export async function getStaticPaths() {
  const data = await blogData()
  return data.published.map((post) => ({ params: { slug: post.id }, props: { post } }))
}

const { post } = Astro.props as { post: PostEntry }
const data = await blogData()
const site = (Astro.site ?? new URL('https://www.openmercato.com')).origin
const seo = postSeo(post, site)
const names = postNames(post, data)
const { Content, headings } = await render(post as never)
const html = (post as unknown as { rendered?: { html?: string } }).rendered?.html ?? ''
const minutes = readingMinutes(html.replace(/<[^>]+>/g, ' '))
const toc = headings.filter((h) => h.depth === 2)
---

<Main
  path={postPath(post.id)}
  title={seo.title}
  description={seo.description}
  ogType="article"
  ogImage={seo.ogImage}
  noindex={seo.noindex || undefined}
  jsonLd={postJsonLd(post, site, names)}
  bodyClass="wf-blog-post"
  styles={[pagesCss, blogCss]}
>
  <Fragment slot="head">
    <meta property="article:published_time" content={post.data.date.toISOString()} />
    {post.data.updated && <meta property="article:modified_time" content={post.data.updated.toISOString()} />}
  </Fragment>
  <div class="main-wrapper padding-global">
    <div class="container-main">
      <PostHeader
        title={post.data.title}
        description={post.data.description}
        href={postPath(post.id)}
        category={data.categories.get(refId(post.data.category) ?? '')}
        author={names.author}
        date={post.data.date}
        minutes={minutes}
      />
      <section class="section is-no-padding">
        <div class="section-padding">
          <div class="blog-post_component">
            <div class="blog-post_sticky-wrapper">
              <div class="blog-post_cta">
                <div class="blog-post_cta-top">
                  <div class="heading-style-h5">Software is about to be built completely differently</div>
                  <div class="button-group">
                    <a href={MAIN_SITE_GITHUB} class="button is-icon w-inline-block">
                      <div class="button_icon" aria-hidden="true" set:html={GITHUB_ICON} />
                      <div>Clone the Repo</div>
                    </a>
                  </div>
                </div>
                {
                  toc.length > 0 && (
                    <div class="blog-post_cta-bottom">
                      <div class="text-size-small text-color-secondary">Table of contents</div>
                      <nav class="blog-post_toc" aria-label="Table of contents">
                        {toc.map((h) => (
                          <a href={`#${h.slug}`} class="blog-post_toc-link w-inline-block">
                            <div class="blog-post_toc-dot" />
                            <div class="text-size-small">{h.text}</div>
                          </a>
                        ))}
                      </nav>
                    </div>
                  )
                }
              </div>
            </div>
            <div class="blog-post_content">
              <Prose><Content /></Prose>
            </div>
          </div>
        </div>
      </section>
    </div>
  </div>
</Main>

<script>
  import '../../scripts/video-embed.ts'
</script>

---
// /case-studies/<slug> (spec, Routing, UI/UX and SEO): one page per published case study, never one for a draft (D6),
// in the live Webflow markup (`header_component is-case`, `case-post_component`, `case-slider_component`). Title
// `<heading> | Open Mercato Case Study` and h1 `<title>`, as the live pages (Webflow template); canonical, og:type
// article with the thumbnail as og:image, Article and BreadcrumbList JSON-LD, all from the entry. A partner that
// delivered it is linked when published, named without a link when a draft (with a build warning). The carousel shows
// every other case study, as live.
import { render } from 'astro:content'
import Main from '../../layouts/Main.astro'
import Crumbs from '../../components/Crumbs.astro'
import Prose from '../../components/blog/Prose.astro'
import VideoEmbed from '../../components/blog/VideoEmbed.astro'
import CaseOverview from '../../components/case-studies/CaseOverview.astro'
import CaseSlider from '../../components/case-studies/CaseSlider.astro'
import CaseStack from '../../components/case-studies/CaseStack.astro'
import ScreenshotGallery from '../../components/case-studies/ScreenshotGallery.astro'
import StatTriplet from '../../components/case-studies/StatTriplet.astro'
import { refId } from '../../lib/blog.ts'
import {
  CASE_STUDIES_PATH,
  caseStudyCard,
  caseStudyJsonLd,
  caseStudyPath,
  caseStudySeo,
  deliveredBy,
  otherCaseStudies,
  type CaseStudyEntry,
} from '../../lib/case-studies.ts'
import { caseStudyData } from '../../lib/collections-data.ts'
import pagesCss from '../../styles/webflow/pages.css?url'
import blogCss from '../../styles/blog.css?url'

export async function getStaticPaths() {
  const data = await caseStudyData()
  return data.published.map((cs) => ({ params: { slug: cs.id }, props: { cs } }))
}

const { cs } = Astro.props as { cs: CaseStudyEntry }
const data = await caseStudyData()
const site = (Astro.site ?? new URL('https://www.openmercato.com')).origin
const seo = caseStudySeo(cs, site)
const delivered = deliveredBy(cs, data.partners, (m) => console.warn(`[om-www] ${m}`))
const categories = cs.data.categories.flatMap((c) => {
  const name = data.categories.get(refId(c) ?? '')
  return name ? [name] : []
})
const others = otherCaseStudies(cs, data.published).map((r) => caseStudyCard(r, data.categories))
const thumbnail = cs.data.thumbnail
const { Content } = await render(cs as never)
---

<Main
  path={caseStudyPath(cs.id)}
  title={seo.title}
  description={seo.description}
  ogType="article"
  ogImage={seo.ogImage}
  jsonLd={caseStudyJsonLd(cs, site, delivered, categories)}
  bodyClass="wf-case-study"
  styles={[pagesCss, blogCss]}
>
  <div class="main-wrapper padding-global">
    <div class="container-main">
      <section class="section">
        <div class="section-padding">
          <div class="header_component is-case">
            <div class="header_content is-case">
              <Crumbs
                trail={[{ name: 'Case Studies', href: CASE_STUDIES_PATH }]}
                current={{ name: cs.data.title, href: caseStudyPath(cs.id) }}
                limit
              />
              {/* the live page's h1 is the name, its <title> the heading field (Webflow template, decision of 25 Nov 2026) */}
              <h1 class="heading-style-h3">{cs.data.title}</h1>
              <div class="spacer-small"></div>
              <p class="text-color-secondary">{cs.data.description}</p>
              <div class="spacer-small"></div>
              {
                categories.length > 0 && (
                  <div class="case-label_collection-list-wrapper no-margin">
                    <div role="list" class="case-label_collection-list">
                      {categories.map((c) => (
                        <div role="listitem" class="case-label_collection-item">
                          <div class="case_label">
                            <div class="case_label-text">{c}</div>
                          </div>
                        </div>
                      ))}
                    </div>
                  </div>
                )
              }
            </div>
            <div class="header_asset-wrapper is-case-studies">
              {
                cs.data.heroVideo ? (
                  <div class="case-hero_video w-video" style="padding-top:56.25%">
                    <VideoEmbed id={cs.data.heroVideo} title={cs.data.title} poster={thumbnail?.src} />
                  </div>
                ) : (
                  thumbnail && (
                    <img
                      class="case-hero_asset"
                      src={thumbnail.src}
                      alt={cs.data.title}
                      width={thumbnail.width}
                      height={thumbnail.height}
                      decoding="async"
                    />
                  )
                )
              }
            </div>
          </div>
        </div>
      </section>
      <div class="section is-no-padding">
        <div class="case-post_component">
          <div class="case-post_body">
            <StatTriplet stats={cs.data.stats} />
            <div class="case-post_content">
              <Prose><Content /></Prose>
              <CaseStack stack={cs.data.overview.stack} />
            </div>
          </div>
          <CaseOverview overview={cs.data.overview} delivered={delivered} />
        </div>
      </div>
      <ScreenshotGallery images={cs.data.screenshots} />
      <CaseSlider tagline="RELATED CASE STUDIES" heading="Discover more projects" items={others} />
    </div>
  </div>
</Main>

<script>
  import '../../scripts/video-embed.ts'
  import '../../scripts/case-nav.ts'
</script>
